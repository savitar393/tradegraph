ser_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.500Z\",\"user_updated\":null,\"date_updated\":null,\"sub_header\":\"\",\"template_name\":\"Detail.AccordionSubHeader\"}},\"blockId\":\"4299\",\"itemId\":1358,\"pageId\":\"$undefined\",\"detailData\":\"$undefined\",\"lastUpdated\":\"$undefined\",\"pageTitle\":\"$undefined\",\"current_permalink\":\"$undefined\"}],\"$L56\",\"$L57\"]}]\n3a:[\"$\",\"div\",\"747\",{\"className\":\"sf_colsIn row tab-pane\",\"role\":\"tabpanel\",\"data-placeholder-label\":\"Tab Items\",\"children\":[[\"$\",\"h4\",\"4302\",{\"className\":\"tab-section-title\",\"data-text\":\"Fresh Fruits \u0026 Vegetables\",\"children\":\"Fresh Fruits \u0026 Vegetables\"}],[\"$\",\"$L2c\",\"4303\",{\"data\":{\"id\":1244,\"date_created\":\"2026-10-11T18:01:45.550Z\",\"user_updated\":null,\"date_updated\":null,\"title\":\"Content Overview\"},\"blockId\":\"4303\",\"itemId\":1244,\"pageId\":\"$undefined\",\"detailData\":\"$undefined\",\"lastUpdated\":\"$undefined\",\"pageTitle\":\"$undefined\",\"current_permalink\":\"$undefined\"}],[\"$\",\"h4\",\"4304\",{\"id\":\"what-food-or-food-products-must-meet-the-import-requirements-for-fresh-fruits-vegetables\",\"className\":\"anchor-section-title\",\"data-text\":\"What food or food products must meet the import requirements for Fresh Fruits \u0026 Vegetables?\"}],[\"$\",\"div\",\"4305\",{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"sfContentBlock sf-Long-text\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003ch2\u003e\u003c/h2\u003e\u003ch2\u003eWhat food or food products must meet the import requirements for Fresh Fruits \u0026amp; Vegetables?\u003c/h2\u003e\u003cp\u003eFood or food products classified as ‘Fresh Fruits \u0026amp; Vegetables’ include, but are not limited to, fresh apples, fresh durians, fresh potatoes, and raw ginger among others. Each import consignment must meet the requirements imposed on this category of food or food products.\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"},\"data-directus\":\"$undefined\",\"suppressHydrationWarning\":true}]}],[\"$\",\"$L29\",\"4306\",{\"data\":{\"id\":1446,\"status\":\"published\",\"sort\":null,\"user_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.565Z\",\"user_updated\":null,\"date_updated\":null,\"callouts_title\":\"\",\"tooltip_is_enable\":false,\"tooltip_content\":\"\",\"callouts_content\":\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cspan style=\\\"color:#ff6666;\\\"\u003eFruits and vegetables that have undergone processing e.g. cutting, peeling, canning, and freezing, are classified as ‘Processed Food’ and must comply with the \u003c/span\u003e\u003ca target=\\\"_blank\\\" href=\\\"/food-import-export/commercial-imports/import-requirements-for-food-food-products#processed-food--food-appliances-4\\\"\u003eimport requirements for processed food\u003c/a\u003e\u003cspan style=\\\"color:#ff6666;\\\"\u003e instead.\u003c/span\u003e\u003c/body\u003e\u003c/html\u003e\",\"callouts_type\":\"Warning\",\"feedback\":null},\"blockId\":\"4306\",\"itemId\":1446,\"pageId\":\"$undefined\",\"detailData\":\"$undefined\",\"lastUpdated\":\"$undefined\",\"pageTitle\":\"$undefined\",\"current_permalink\":\"$undefined\"}],[\"$\",\"div\",\"4307\",{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"sfContentBlock sf-Long-text\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003ch2\u003e\u003c/h2\u003e\u003cp\u003eTo check if your food or food products fall under ‘Fresh Fruits \u0026amp; Vegetables’, use the  \u003ca target=\\\"_blank\\\" href=\\\"/tools-and-resources/food-and-related-products-classification-tool\\\"\u003eFood and Related Products Classification Tool\u003c/a\u003e. For more information on the different categories of food and food products, see the  \u003ca target=\\\"_blank\\\" href=\\\"/food-import-export/general-classification-of-food-food-products/classification-of-general-food-food-products\\\"\u003eClassification of General Food \u0026amp; Food Products.\u003c/a\u003e\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"},\"data-directus\":\"$undefined\",\"suppressHydrationWarning\":true}]}],[\"$\",\"h4\",\"4308\",{\"id\":\"where-can-i-find-the-import-requirements-for-fresh-fruits-and-vegetables\",\"className\":\"anchor-section-title\",\"data-text\":\"Where can I find the import requirements for Fresh Fruits and Vegetables?\"}],[\"$\",\"div\",\"4309\",{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"sfContentBlock sf-Long-text\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003ch2\u003e\u003c/h2\u003e\u003ch2\u003e\u003c/h2\u003e\u003ch2\u003eWhere can I find the import requirements for Fresh Fruits and Vegetables?\u003c/h2\u003e\u003cp\u003eThe import requirements can be found in the    \u003ca href=\\\"https://cuge.nparks.gov.sg/farm-licence/copa-farm-license/\\\" target=\\\"_blank\\\" data-sf-ec-immutable=\\\"\\\" data-sf-marked=\\\"\\\"\u003eControl of Plants (Import \u0026amp; Transhipment of Fresh Fruits \u0026amp; Vegetables) Rules.\u003c/a\u003e\u003c/p\u003e\u003cp\u003eYou must comply with these requirements before you \u003ca target=\\\"_blank\\\" href=\\\"/food-import-export/commercial-imports/what-you-need-to-know-for-import-of-food#import-permit\\\"\u003eapply for an import permit\u003c/a\u003e to bring Fresh Fruits \u0026amp; Vegetables into Singapore.\u003c/p\u003e\u003cp\u003eNon-compliance can result in penalties under the\u0026nbsp;\u003ca target=\\\"_blank\\\" href=\\\"/legislation\\\"\u003eprevailing food safety laws and regulations\u003c/a\u003e.\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"},\"data-directus\":\"$undefined\",\"suppressHydrationWarning\":true}]}],\"$L58\",\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\"]}]\n5d:T40c,\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003ch2\u003eWhat are Processed Food \u0026amp; Food Contact Articles?\u003c/h2\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eProcessed Food refers to products such as biscuits, cooking oil and mineral water. \u003c/p\u003eA Food Contact Article refers to an item that is designed for use in, or in connection with the handling of food or beverages that comes into contact with food or beverages and does not require electricity to function. Examples include plates, bowls, cups, straws, pots and utensils such as chopsticks and spoons.\u0026nbsp;\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eTo check whether your product falls under this category, please use the \u003ca target=\"_blank\" href=\"/tools-and-resources/food-and-related-products-classification-tool\"\u003eFood and Related Products Classification Tool\u003c/a\u003e. To learn more about the different categories of food and food products, please see the \u003ca target=\"_blank\" href=\"/food-import-export/general-classification-of-food-food-products/classification-of-general-food-food-products\"\u003eClassification of General Food \u0026amp; Food Products.\u003c/a\u003e\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e5e:Ta7f,\u003ch2\u003eWhat is needed to import Processed Food \u0026amp; Food Contact Articles for sale?\u003c/h2\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe sale of Processed Food \u0026amp; Food Contact Articles is governed under the Sale of Food Act 1973 and Food Regulations.\u003c/p\u003e\n\u003cp\u003eAll pre-packed food products for sale in Singapore should meet requirements specified in Part 3 of the Food Regulations. For more information, please see \u003ca href=\"/regulatory-standards-frameworks-guidelines/food-labelling-packaging-guidelines/labelling-requirements-for-food\" target=\"_blank\" rel=\"noopener\"\u003eLabelling Guidelines for Food\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eOnly permitted food additives and ingredients are allowed in food. Please check the relevant requirements here:\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"sfa-text-link\" style=\"color: rgb(220, 68, 5); font-weight: 600;\"\u003e\u003ca href=\"https://www.sfa.gov.sg/regulatory-standards-frameworks-guidelines/food-safety-regulatory-limits/regulatory-limits-for-food-additives\" target=\"_blank\" rel=\"noopener\"\u003eRegulatory Limits for Food Additives\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"sfa-text-link\" style=\"color: rgb(220, 68, 5); font-weight: 600;\"\u003e\u003ca href=\"https://www.sfa.gov.sg/regulatory-standards-frameworks-guidelines/food-safety-regulatory-limits/regulatory-limits-for-contaminants-in-food\" target=\"_blank\" rel=\"noopener\"\u003eRegulatory Limits for Contaminants in Food\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"sfa-text-link\" style=\"color: rgb(220, 68, 5); font-weight: 600;\"\u003e\u003ca href=\"https://www.sfa.gov.sg/regulatory-standards-frameworks-guidelines/ingredients-used-in-food/chinese-medicinal-materials-and-ingredients-used-in-food\" target=\"_blank\" rel=\"noopener\"\u003eChinese Medicinal Materials and Ingredients Used in Food\u003c/a\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003eAll imported Processed Food and Food Contact Articles need to be accompanied by a valid permit under Regulation of Imports and Exports Regulations Section 3.\u003c/p\u003e\n\u003cp\u003eYou should check on the requirements for your food product before you\u0026nbsp;\u003ca href=\"/food-import-export/commercial-imports/what-you-need-to-know-for-import-of-food\"\u003eapply for a permit\u003c/a\u003e\u0026nbsp;to import Processed Food \u0026amp; Food Contact Articles into Singapore.\u003c/p\u003e\n\u003cp\u003eFor processed foods like infant formulas and ready-to-eat food, importers are to provide additional supporting documents. Please refer to the\u0026nbsp;\u003ca style=\"font-family: inherit; font-size: inherit; text-transform: inherit; word-spacing: normal; white-space: inherit;\" title=\"Import Requirements of Specific Food Products\" href=\"/api/assets/fa89c526-e82d-4e62-b5cd-581d1b95d9e5\" target=\"_blank\" rel=\"noopener\" aria-label=\"Requirements of Specific Food Products Imported for Sale\"\u003eDocuments needed for the sale of Specific Food Products\u003c/a\u003e\u0026nbsp;for the details.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e3b:[\"$\",\"div\",\"748\",{\"className\":\"sf_colsIn row tab-pane\",\"role\":\"tabpanel\",\"data-placeholder-label\":\"Tab Items\",\"children\":[[\"$\",\"h4\",\"4315\",{\"className\":\"tab-section-title\",\"data-text\":\"Processed Food \u0026 Food Appliances\",\"children\":\"Processed Food \u0026 Food Appliances\"}],[\"$\",\"$L2c\",\"4316\",{\"data\":{\"id\":1245,\"date_created\":\"2026-10-11T18:01:45.645Z\",\"user_updated\":null,\"date_updated\":null,\"title\":\"Content Overview\"},\"blockId\":\"4316\",\"itemId\":1245,\"pageId\":\"$undefined\",\"detailData\":\"$undefined\",\"lastUpdated\":\"$undefined\",\"pageTitle\":\"$undefined\",\"current_permalink\":\"$undefined\"}],[\"$\",\"h4\",\"4317\",{\"id\":\"what-are-processed-food-food-contact-articles\",\"className\":\"anchor-section-title\",\"data-text\":\"What are Processed Food \u0026 Food Contact Articles?\"}],[\"$\",\"div\",\"4318\",{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"sfContentBlock sf-Long-text\",\"dangerouslySetInnerHTML\":{\"__html\":\"$5d\"},\"data-directus\":\"$undefined\",\"suppressHydrationWarning\":true}]}],[\"$\",\"h4\",\"4319\",{\"id\":\"what-is-needed-to-import-processed-food-food-contact-articles-for-sale\",\"className\":\"anchor-section-title\",\"data-text\":\"What is needed to import Processed Food \u0026 Food Contact Articles for sale?\"}],[\"$\",\"div\",\"4320\",{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"sfContentBlock sf-Long-text\",\"dangerouslySetInnerHTML\":{\"__html\":\"$5e\"},\"data-directus\":\"$undefined\",\"suppressHydrationWarning\":true}]}],\"$L5f\",\"$L60\",\"$L61\",\"$L62\",\"$L63\",\"$L64\",\"$L65\",\"$L66\",\"$L67\",\"$L68\",\"$L69\",\"$L6a\"]}]\n6b:T4da,\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003ch2\u003e\u003c/h2\u003e\u003ch2\u003eGuidelines to Import Insects \u0026amp; Insect Products\u003c/h2\u003e\u003cp\u003eSFA’s priority is to ensure the safety of food consumed in Singapore. As the insect industry is nascent and insects are a new food item here, SFA has developed the\u0026nbsp;\u003ca target=\"_blank\" href=\"/regulatory-standards-frameworks-guidelines/insect-regulatory-framework/insect-regulatory-framework\"\u003einsect regulatory framework\u003c/a\u003e, which puts in place guidelines for insects to be approved as food.\u003c/p\u003e\u003cp\u003eFor imports of insects and insect products for human consumption, importers should register with SFA for the \u003ca href=\"https://www.gobusiness.gov.sg/browse-all-licences/singapore-food-agency-(sfa)/registration-to-import-processed-food-products-and-food-appliances\" target=\"_blank\" data-sf-ec-immutable=\"\"\u003eRegistration to import processed food and food appliances\u003c/a\u003e.\u0026nbsp;Insects and insect products may be imported from any country or region as long as the imported insect and insect products meet SFA’s guidelines.\u003c/p\u003e\u003cp\u003eThe following guidelines will apply to the import of insects and insect products, depending on their intended purpose (i.e. production for human consumption or animal feed for food-producing animals).\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e6c:T10c4,\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cdiv class=\"table-text sf_colsIn\" data-sf-element=\"Text Table - Content Block\" data-placeholder-label=\"Text Table - Content Block\"\u003e\u003cdiv class=\"sfContentBlock sf-Long-text\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003ctable style=\"height:74.5px;width:519.167px;\"\u003e\u003ctbody\u003e\u003ctr style=\"height:30.1887%;\"\u003e\u003cth style=\"width:7.85327%;text-align:left;\" data-role=\"resizable\"\u003eS/N\u003c/th\u003e\u003cth style=\"width:92.1547%;text-align:left;\"\u003eImport Guidelines\u003c/th\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e1\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eSubmission of the following documents (one-time submission) from importer for SFA’s consideration:\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eDocumentary proof that products are manufactured in premises regulated by Competent Authority; and\u003cbr\u003e\u003c/li\u003e\u003cli\u003eHazard Analysis Critical Control Point (HACCP)/ Food Safety Management System (FSMS) plan showing that products are manufactured in establishments which have in place production and post-harvest processes to identify\n                                        the hazard(s) and the control measures.\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e2\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eSubmission of Health certificate for every consignment to certify that:\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eInsects are not harvested from the wild;\u003cbr\u003e\u003c/li\u003e\u003cli\u003eManure, decomposing organic material and materials originating from diseased animals or fish are \u003cspan style=\"text-decoration:underline;\"\u003enot\u003c/span\u003e used as feeding substrates.\u0026nbsp; (Decomposing state is identified\n                                        by putrid odours, mushy/slimy, or with visible moulad or bacteria growth. Substrates which have undergone controlled fermentation are permitted);\u003cbr\u003e\u003c/li\u003e\u003cli\u003eNo materials of ruminant origin are used as feeding substrate, except for deboned meat cuts and dairy (e.g. milk and cheese) products; and\u003cbr\u003e\u003c/li\u003e\u003cli\u003eThe products have been handled and packed in a hygienic manner and are free from contaminants.\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e3\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp style=\"margin-bottom:0px;padding:0px;\"\u003eThe insects imported should only be those listed in the\u0026nbsp;\u003ca aria-label=\"Link Food Safety and Security (Catalogued Insect-like Species) Order 2025\" id=\"menur5us\" href=\"https://sso.agc.gov.sg/SL/FSSA2025-S712-2025?DocDate=20251124\" rel=\"noreferrer noopener\" target=\"_blank\" class=\"fui-Link ___1q1shib f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1s184ao f1mk8lai fnbmjn9 f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" title=\"https://sso.agc.gov.sg/sl/fssa2025-s712-2025?docdate=20251124\"\u003eFood Safety and Security (Catalogued Insect-like Species) Order 2025\u003c/a\u003e.\u003cbr\u003e\u003c/p\u003e\u003cdiv class=\"callout-type\"\u003e\u003cdiv class=\"caution-notification\"\u003e\u003cimg src=\"https://assets.app.optical.gov.sg/sfa/production/published/collections/pages/%252Ffood-import-export%252Fcommercial-imports%252Fimport-requirements-for-food-food-products/e1228839-5177-4982-bb07-22d08852fd62.svg\" alt=\"Icon Caution\" title=\"Icon Info Circle\"\u003e\u003cdiv class=\"notification-content\"\u003e\u003cp\u003eDeclaration of insect species imported is required as part of cargo clearance permit approval. Insects which are not in this list should undergo evaluation to ensure that the insect species are safe to consume.\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eSFA requires the following information for the assessment of new insect species:\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eScientific name of insect and intended life stage of consumption\u003c/li\u003e\u003cli\u003eDetails of the farming and processing method, including the type of substrate (i.e. material used for feeding insects)\u003c/li\u003e\u003cli\u003eEvidence of history of use as a food in a country other than Singapore\u003c/li\u003e\u003cli\u003eInformation relied on to establish that the species and life stage is safe for consumption (e.g. scientific literature, laboratory reports)\u003c/li\u003e\u003cli\u003eSingapore address or entity of applicant\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/body\u003e\u003c/html\u003e6d:T88b,\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cdiv class=\"table-text sf_colsIn\" data-sf-element=\"Text Table - Content Block\" data-placeholder-label=\"Text Table - Content Block\"\u003e\u003cdiv\u003e\u003cdiv class=\"sfContentBlock sf-Long-text\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003ctable style=\"height:74.5px;width:519.167px;\"\u003e\u003ctbody\u003e\u003ctr style=\"height:30.1887%;\"\u003e\u003cth style=\"width:7.85327%;text-align:left;\" data-role=\"resizable\"\u003eS/N\u003c/th\u003e\u003cth style=\"width:92.1547%;text-align:left;\"\u003eImport Guidelines\u003c/th\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e1\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eSubmission of the following documents (one-time submission) from importer for SFA’s consideration:\u003c/p\u003e\u003cbr\u003e\u003cul\u003e\u003cli\u003eDocumentary proof that products are manufactured in premises regulated by Competent Authority; and\u003cbr\u003e\u003c/li\u003e\u003cli\u003eHazard Analysis Critical Control Point (HACCP)/ Food Safety Management System (FSMS) plan showing that products are manufactured in establishments which have in place production and post-harvest processes to identify the hazard(s) and the control measures.\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e2\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eSubmission of Health certificate for every consignment to certify that:\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eInsects are not harvested from the wild;\u003cbr\u003e\u003c/li\u003e\u003cli\u003eManure, decomposing organic material and materials originating from diseased animals or fish are \u003cspan style=\"text-decoration:underline;\"\u003enot\u003c/span\u003e used as feeding substrates.\u0026nbsp; (Decomposing state is identified\n                                            by putrid odours, mushy/slimy, or with visible moulad or bacteria growth. Substrates which have undergone controlled fermentation are permitted);\u003cbr\u003e\u003c/li\u003e\u003cli\u003eNo materials of ruminant origin are used as feeding substrate, except for deboned meat cuts and dairy (e.g. milk and cheese) products; and\u003cbr\u003e\u003c/li\u003e\u003cli\u003eThe products have been handled and packed in a hygienic manner and are free from contaminants.\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/body\u003e\u003c/html\u003e6e:T1077,\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cdiv class=\"table-text sf_colsIn\" data-sf-element=\"Text Table - Content Block\" data-placeholder-label=\"Text Table - Content Block\"\u003e\u003cdiv class=\"sfContentBlock sf-Long-text\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003ctable style=\"height:74.5px;width:519.167px;\"\u003e\u003ctbody\u003e\u003ctr style=\"height:30.1887%;\"\u003e\u003cth style=\"width:7.85327%;text-align:left;\" data-role=\"resizable\"\u003eS/N\u003c/th\u003e\u003cth style=\"width:92.1547%;text-align:left;\"\u003eImport Guidelines\u003c/th\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e1\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eHave fulfilled and obtained approval from the National Parks Board (NParks) on \u003ca target=\"_blank\" href=\"https://www.nparks.gov.sg/services/import-plant-plant-products/check-plant-health-requirements/insects-invertebrates\"\u003erequirements for the import conditions for insects and other invertebrates\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e2\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003eSubmission of the following documents (one-time submission) from importer for SFA’s consideration:\u003cbr\u003e\u003cbr\u003e\u003cul\u003e\u003cli\u003eDocumentary proof that insects are farmed in premises regulated by Competent Authority.\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e3\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eSubmission of Health certificate for every consignment to certify that:\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eInsects are not harvested from the wild;\u003cbr\u003e\u003c/li\u003e\u003cli\u003eManure, decomposing organic material and materials originating from diseased animals or fish are not used as feeding substrates. (Decomposing state is identified by putrid odours, mushy/slimy, or with visible\n                                        mould or bacteria growth. Substrates which have undergone controlled fermentation are permitted);\u003cbr\u003e\u003c/li\u003e\u003cli\u003eNo materials of ruminant origin are used as feeding substrate, except for deboned meat cuts and dairy (e.g. milk and cheese) products.\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e4\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eThe insects imported should only be those listed in the  \u003ca aria-label=\"Link Food Safety and Security (Catalogued Insect-like Species) Order 2025\" id=\"menur5us\" href=\"https://sso.agc.gov.sg/SL/FSSA2025-S712-2025?DocDate=20251124\" rel=\"noreferrer noopener\" target=\"_blank\" class=\"fui-Link ___1q1shib f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1s184ao f1mk8lai fnbmjn9 f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" title=\"https://sso.agc.gov.sg/sl/fssa2025-s712-2025?docdate=20251124\"\u003eFood Safety and Security (Catalogued Insect-like Species) Order 2025\u003c/a\u003e.\u003cbr\u003e\u003c/p\u003e\u003cdiv class=\"callout-type\"\u003e\u003cdiv class=\"caution-notification\"\u003e\u003cimg src=\"https://assets.app.optical.gov.sg/sfa/production/published/collections/pages/%252Ffood-import-export%252Fcommercial-imports%252Fimport-requirements-for-food-food-products/e1228839-5177-4982-bb07-22d08852fd62.svg\" alt=\"Icon Caution\" title=\"Icon Info Circle\"\u003e\u003cdiv class=\"notification-content\"\u003e\u003cp\u003eDeclaration of insect species imported is required as part of cargo clearance permit approval.\n                                    Insects which are not in this list should undergo evaluation to ensure that the insect species are safe to consume.\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003eSFA requires the following information for the assessment of new insect species:\u003cbr\u003e\u003cbr\u003e\u003cul\u003e\u003cli\u003eScientific name of insect and intended life stage of consumption\u003c/li\u003e\u003cli\u003eDetails of the farming and processing method, including the type of substrate (i.e. material used for feeding insects)\u003cbr\u003e\u003c/li\u003e\u003cli\u003eEvidence of history of use as a food in a country other than Singapore\u003cbr\u003e\u003c/li\u003e\u003cli\u003eInformation relied on to establish that the species and life stage is safe for consumption (e.g. scientific literature, laboratory reports)\u003cbr\u003e\u003c/li\u003e\u003cli\u003eSingapore address or entity of applicant\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003cbr\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/body\u003e\u003c/html\u003e6f:T881,\u003chtml\u003e\u003chead\u003e\u003c/head\u003e\u003cbody\u003e\u003cdiv class=\"table-text sf_colsIn\" data-sf-element=\"Text Table - Content Block\" data-placeholder-label=\"Text Table - Content Block\"\u003e\u003cdiv class=\"sfContentBlock sf-Long-text\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003cdiv class=\"table-wrap\"\u003e\u003cdiv class=\"table-wrap-scroll\" tabindex=\"0\"\u003e\u003ctable style=\"height:74.5px;width:519.167px;\"\u003e\u003ctbody\u003e\u003ctr style=\"height:30.1887%;\"\u003e\u003cth style=\"width:7.85327%;text-align:left;\" data-role=\"resizable\"\u003eS/N\u003c/th\u003e\u003cth style=\"width:92.1547%;text-align:left;\"\u003eImport Guidelines\u003c/th\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e1\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eHave fulfilled and obtained approval from the National Parks Board (NParks) on \u003ca target=\"_blank\" href=\"https://www.nparks.gov.sg/services/import-plant-plant-products/check-plant-health-requirements/insects-invertebrates\"\u003erequirements for the import conditions for insects and other invertebrates\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e2\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003eSubmission of the following documents (one-time submission) from importer for SFA’s consideration:\u003cbr\u003e\u003cbr\u003e\u003cul\u003e\u003cli\u003eDocumentary proof that insects are farmed in premises regulated by Competent Authority.\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003ctr style=\"height:35.2201%;\"\u003e\u003ctd style=\"width:7.85327%;text-align:left;\"\u003e3\u003c/td\u003e\u003ctd style=\"width:92.1547%;\"\u003e\u003cp\u003eSubmission of health certificate for every consignment to certify that:\u003c/p\u003e\u003cbr\u003e\u003cul\u003e\u003cli\u003eInsects are not harvested from the wild;\u003cbr\u003e\u003c/li\u003e\u003cli\u003eManure, decomposing organic material and materials originating from diseased animals or fish are \u003cspan style=\"text-decoration:underline;\"\u003enot\u003c/span\u003e used as feeding substrates.\u0026nbsp; (Decomposing state is identified by putrid odours, mushy/slimy, or with visible mould or bacteria growth. Substrates which have undergone controlled fermentation are permitted);\u003cbr\u003e\u003c/li\u003e\u003cli\u003eNo materials of ruminant origin are used as feeding substrate, except for deboned meat cuts and dairy (e.g. milk and cheese) products.\u003c/li\u003e\u003c/ul\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003c/div\u003e\u003cbr\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/body\u003e\u003c/html\u003e3c:[\"$\",\"div\",\"749\",{\"className\":\"sf_colsIn row tab-pane\",\"role\":\"tabpanel\",\"data-placeholder-label\":\"Tab Items\",\"children\":[[\"$\",\"h4\",\"4333\",{\"className\":\"tab-section-title\",\"data-text\":\"Insects \u0026 Insect Products\",\"children\":\"Insects \u0026 Insect Products\"}],[\"$\",\"div\",\"4334\",{\"className\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"sfContentBlock sf-Long-text\",\"dangerouslySetInnerHTML\":{\"__html\":\"$6b\"},\"data-directus\":\"$undefined\",\"suppressHydrationWarning\":true}]}],[\"$\",\"$L49\",\"4335\",{\"data\":{\"id\":1362,\"sort\":null,\"user_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.804Z\",\"user_updated\":null,\"date_updated\":null,\"title\":null,\"accordion_item\":[],\"accordion_items\":[{\"id\":3584,\"Sfacorp_AccordionLayout_id\":1362,\"sort\":1,\"Sfacorp_AccordionItem_id\":{\"id\":3617,\"status\":\"published\",\"sort\":null,\"user_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.805Z\",\"user_updated\":null,\"date_updated\":null,\"title\":\"A. For all import of insects and insect products for human consumption\",\"duration_of_application\":\"\",\"accordion_content\":\"$6c\"}},{\"id\":3585,\"Sfacorp_AccordionLayout_id\":1362,\"sort\":2,\"Sfacorp_AccordionItem_id\":{\"id\":3618,\"status\":\"published\",\"sort\":null,\"user_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.809Z\",\"user_updated\":null,\"date_updated\":null,\"title\":\"B. For all import of insects and insect products as animal feed\",\"duration_of_application\":\"\",\"accordion_content\":\"$6d\"}},{\"id\":3586,\"Sfacorp_AccordionLayout_id\":1362,\"sort\":3,\"Sfacorp_AccordionItem_id\":{\"id\":3619,\"status\":\"published\",\"sort\":null,\"user_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.813Z\",\"user_updated\":null,\"date_updated\":null,\"title\":\"C. For all imports of live insects for local production (for human consumption)\",\"duration_of_application\":\"\",\"accordion_content\":\"$6e\"}},{\"id\":3587,\"Sfacorp_AccordionLayout_id\":1362,\"sort\":4,\"Sfacorp_AccordionItem_id\":{\"id\":3620,\"status\":\"published\",\"sort\":null,\"user_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.817Z\",\"user_updated\":null,\"date_updated\":null,\"title\":\"D. For all imports of live insects for local production as animal feed\",\"duration_of_application\":\"\",\"accordion_content\":\"$6f\"}}],\"accordion_sub_header\":{\"id\":1362,\"sort\":null,\"user_created\":\"211f17e7-d30c-4260-909a-156da2993df4\",\"date_created\":\"2026-10-11T18:01:45.803Z\",\"user_updated\":null,\"date_updated\":null,\"sub_header\":\"\",\"template_name\":\"Detail.AccordionSubHeader\"}},\"blockId\":\"4335\",\"itemId\":1362,\"pageId\":\"$undefined\",\"detailData\":\"$undefined\",\"lastUpdated\":\"$undefined\",\"pageTitle\":\"$undefined\",\"current_permalink\":\"$undefined\"}],\"$L70\",\"$L71\"]}]\n3d:[\"$\",\"div\",\"750\",{\"className\":\"sf_colsIn row tab-pane\",\"role\":\"tabpanel\",\"data-placeholder-label\":\"Tab Items\",\"children\":[[\"$\",\"h4\",\"4338\",{\"className\":\"tab-section-title\",\"data-text\":\"Rice\",\"children\":\"Rice\"}],[\"$\",\"div\",\"4339\",{\"className\":\"$undefined\",\"children\":[\"$\",\"d