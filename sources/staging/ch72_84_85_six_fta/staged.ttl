:staged-psr-atiga-psr22-row-1287 a owl:NamedIndividual,
        :SourceClause ;
    rdfs:comment "ATIGA PSR 5801.36: RVC40 or CC or textile process rule | A regional value content of not less than 40 percent; or A change to subheading 5801.36 from any other chapter; or Process Rules for Textile and Textile Products as set out in Attachment 1" ;
    :clauseInDocument :source-atiga-psr22 ;
    :clauseLocator "Annex 3 HS 2022, baris 1287 (5801.36)" .

:staged-psr-atiga-psr22-row-1383 a owl:NamedIndividual,
        :SourceClause ;
    rdfs:comment "ATIGA PSR 6101.20: RVC40 or CC and cut and sewn in any AMS or textile process rule | A regional value content of not less than 40 percent; or A change to subheading 6101.20 from any other chapter and the good is both cut and sewn in the territory of any Member State; or Process Rules for Textile and Textile Products as set out in Attachment 1" ;
    :clauseInDocument :source-atiga-psr22 ;
    :clauseLocator "Annex 3 HS 2022, baris 1383 (6101.20)" .

