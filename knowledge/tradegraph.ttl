@prefix : <urn:tradegraph:kb#> .
@prefix catalog: <urn:tradegraph:catalog#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:tradegraph:kb> a owl:Ontology ;
    owl:versionIRI <urn:tradegraph:kb:version:0.5.0> ;
    owl:versionInfo "0.5.0" ;
    rdfs:label "TradeGraph" ;
    rdfs:comment "Inti ontologi perdagangan lintas negara dan referensi awal dari register pengetahuan."@id ;
    :compatibleEngineProfile "tradegraph-jdk21-owl2dl-swrl-comparisons-v1" ;
    :currentRevision :revision-0.5.0 .

:compatibleEngineProfile a owl:AnnotationProperty .
:currentRevision a owl:AnnotationProperty .
:axiomId a owl:AnnotationProperty .
:axiomSource a owl:AnnotationProperty .
:axiomReviewStatus a owl:AnnotationProperty .

# Goods and production

:TradeGood a owl:Class .
:Product a owl:Class ; rdfs:subClassOf :TradeGood .
:Material a owl:Class ; rdfs:subClassOf :TradeGood .
:Component a owl:Class ; rdfs:subClassOf :Material .
:CommodityCategory a owl:Class .
:HSCode a owl:Class .
:Unit a owl:Class .
:MeasuredAmount a owl:Class .
:ProductionBatch a owl:Class .
:Process a owl:Class .
:Transformation a owl:Class ; rdfs:subClassOf :Process .
:Facility a owl:Class ; rdfs:subClassOf :Location .

:MultiMaterialBatch a owl:Class ;
    rdfs:comment "Batch dengan sedikitnya dua material yang berbeda pada relasi usesMaterial."@id ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :ProductionBatch
            [ a owl:Restriction ;
              owl:onProperty :usesMaterial ;
              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
              owl:onClass :Material ]
        )
    ] .

:hasCommodityCategory a owl:ObjectProperty ;
    rdfs:domain :TradeGood ; rdfs:range :CommodityCategory .
:hasTariffClassification a owl:ObjectProperty ;
    rdfs:domain :TradeGood ; rdfs:range :HSCode .
:referenceCode a owl:ObjectProperty ;
    rdfs:domain :CommodityCategory ; rdfs:range :HSCode .
:codeValue a owl:DatatypeProperty ;
    rdfs:domain :HSCode ; rdfs:range xsd:string .
:nomenclature a owl:DatatypeProperty ;
    rdfs:domain :HSCode ; rdfs:range xsd:string .
:amountValue a owl:DatatypeProperty ;
    rdfs:domain :MeasuredAmount ; rdfs:range xsd:decimal .
:amountUnit a owl:ObjectProperty ;
    rdfs:domain :MeasuredAmount ; rdfs:range :Unit .
:Currency a owl:Class .
:amountCurrency a owl:ObjectProperty ;
    rdfs:domain :MeasuredAmount ; rdfs:range :Currency .
:ComponentList a owl:Class .
:ComponentEntry a owl:Class .
:componentListForBatch a owl:ObjectProperty ;
    rdfs:domain :ComponentList ; rdfs:range :ProductionBatch .
:componentListClosed a owl:DatatypeProperty ;
    rdfs:domain :ComponentList ; rdfs:range xsd:boolean .
:componentEntry a owl:ObjectProperty ;
    rdfs:domain :ComponentList ; rdfs:range :ComponentEntry .
:componentAmount a owl:ObjectProperty ;
    rdfs:domain :ComponentEntry ; rdfs:range :MeasuredAmount .

:hasBatch a owl:ObjectProperty ;
    rdfs:domain :Product ; rdfs:range :ProductionBatch ;
    owl:inverseOf :batchOf .
:batchOf a owl:ObjectProperty ;
    rdfs:domain :ProductionBatch ; rdfs:range :Product .
:usesMaterial a owl:ObjectProperty ;
    rdfs:domain :ProductionBatch ; rdfs:range :Material .
:suppliedBy a owl:ObjectProperty ;
    rdfs:domain :Material ; rdfs:range :Organization .
:dependsOnMaterial a owl:ObjectProperty ;
    rdfs:domain :Product ; rdfs:range :Material ;
    rdfs:comment "Ketergantungan teknis yang diturunkan dari batch dan input material."@id ;
    owl:propertyChainAxiom ( :hasBatch :usesMaterial ) .
:producedBy a owl:ObjectProperty ;
    rdfs:domain :ProductionBatch ; rdfs:range :Organization ;
    owl:inverseOf :produces .
:produces a owl:ObjectProperty ;
    rdfs:domain :Organization ; rdfs:range :ProductionBatch .
:runsProcess a owl:ObjectProperty ;
    rdfs:domain :ProductionBatch ; rdfs:range :Process .
:producedAt a owl:ObjectProperty ;
    rdfs:domain :ProductionBatch ; rdfs:range :Facility .

# Actors and locations

:Organization a owl:Class ; owl:disjointWith :RoleAssignment .
:Authority a owl:Class ; rdfs:subClassOf :Organization .
:Issuer a owl:Class ; rdfs:subClassOf :Organization .
:ActorRole a owl:Class .
:Authorization a owl:Class .
:RoleAssignment a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :roleActor ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Organization ],
        [ a owl:Restriction ; owl:onProperty :hasActorRole ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :ActorRole ],
        [ a owl:Restriction ; owl:onProperty :assignedInRevision ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :TradeCaseRevision ] .
:ImporterRoleAssignment a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :RoleAssignment
            [ a owl:Restriction ; owl:onProperty :hasActorRole ; owl:hasValue :roleImporter ]
        )
    ] .
:ExporterRoleAssignment a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :RoleAssignment
            [ a owl:Restriction ; owl:onProperty :hasActorRole ; owl:hasValue :roleExporter ]
        )
    ] .

:roleActor a owl:ObjectProperty ;
    rdfs:domain :RoleAssignment ; rdfs:range :Organization ;
    owl:inverseOf :hasRoleAssignment .
:hasRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :Organization ; rdfs:range :RoleAssignment .
:hasActorRole a owl:ObjectProperty ;
    rdfs:domain :RoleAssignment ; rdfs:range :ActorRole .
:assignedInRevision a owl:ObjectProperty ;
    rdfs:domain :RoleAssignment ; rdfs:range :TradeCaseRevision ;
    owl:inverseOf :revisionRoleAssignment .
:revisionRoleAssignment a owl:ObjectProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range :RoleAssignment .
:roleAuthorization a owl:ObjectProperty ;
    rdfs:domain :RoleAssignment ; rdfs:range :Authorization .
:grantedBy a owl:ObjectProperty ;
    rdfs:domain :Authorization ; rdfs:range :Authority .

:Location a owl:Class .
:Country a owl:Class ; rdfs:subClassOf :Location .
:Port a owl:Class ; rdfs:subClassOf :Location .
:Jurisdiction a owl:Class .
:withinLocation a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain :Location ; rdfs:range :Location .
:jurisdictionInCountry a owl:ObjectProperty ;
    rdfs:domain :Jurisdiction ; rdfs:range :Country .
:countryCode a owl:DatatypeProperty ;
    rdfs:domain :Country ; rdfs:range xsd:string .

# Trade, shipments and provisions

:TradeAgreement a owl:Class .
:CustomsProcedure a owl:Class .
:IntendedUse a owl:Class .
:TradeCase a owl:Class ; owl:disjointWith :TradeCaseRevision .
:TradeCaseRevision a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :revisionOf ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :TradeCase
    ] .
:Shipment a owl:Class .
:TransportLeg a owl:Class .
:Provision a owl:Class .
:Requirement a owl:Class .
:Exception a owl:Class .

:revisionOf a owl:ObjectProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range :TradeCase .
:previousCaseRevision a owl:ObjectProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range :TradeCaseRevision .
:caseRevisionNumber a owl:DatatypeProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range xsd:integer .
:revisionShipment a owl:ObjectProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range :Shipment .
:containsGoods a owl:ObjectProperty ;
    rdfs:domain :Shipment ; rdfs:range :TradeGood .
:hasTransportLeg a owl:ObjectProperty ;
    rdfs:domain :Shipment ; rdfs:range :TransportLeg .
:departsFrom a owl:ObjectProperty ;
    rdfs:domain :TransportLeg ; rdfs:range :Location .
:arrivesAt a owl:ObjectProperty ;
    rdfs:domain :TransportLeg ; rdfs:range :Location .
:legNumber a owl:DatatypeProperty ;
    rdfs:domain :TransportLeg ; rdfs:range xsd:integer .
:intendedUse a owl:ObjectProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range :IntendedUse .

:agreementProvision a owl:ObjectProperty ;
    rdfs:domain :TradeAgreement ; rdfs:range :Provision .
:provisionJurisdiction a owl:ObjectProperty ;
    rdfs:domain :Provision ; rdfs:range :Jurisdiction .
:statesRequirement a owl:ObjectProperty ;
    rdfs:domain :Provision ; rdfs:range :Requirement .
:hasException a owl:ObjectProperty ;
    rdfs:domain :Provision ; rdfs:range :Exception .
:supersedesProvision a owl:ObjectProperty ;
    rdfs:domain :Provision ; rdfs:range :Provision .
:effectiveFromLocalDate a owl:DatatypeProperty ;
    rdfs:domain :Provision ; rdfs:range xsd:string ;
    rdfs:comment "Tanggal hukum lokal dalam bentuk YYYY-MM-DD. Interpretasi zona melekat pada sumber dan yurisdiksi."@id .
:effectiveUntilLocalDateExclusive a owl:DatatypeProperty ;
    rdfs:domain :Provision ; rdfs:range xsd:string .

# Evidence and assessments

:Document a owl:Class .
:DocumentType a owl:Class .
:EvidenceClaim a owl:Class .
:EvidenceSet a owl:Class .
:DocumentLinkedClaim a owl:Class ;
    rdfs:comment "Klasifikasi eksistensial. Validasi bukti bernama dan status verifikasi dokumen merupakan pemeriksaan tersendiri."@id ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :EvidenceClaim
            [ a owl:Restriction ; owl:onProperty :claimDocument ; owl:someValuesFrom :Document ]
        )
    ] .
:documentType a owl:ObjectProperty ;
    rdfs:domain :Document ; rdfs:range :DocumentType .
:hasSupportingDocument a owl:ObjectProperty ; rdfs:range :Document .
:documentSubject a owl:ObjectProperty ; rdfs:domain :Document .
:documentJurisdiction a owl:ObjectProperty ;
    rdfs:domain :Document ; rdfs:range :Jurisdiction .
:documentValidFrom a owl:DatatypeProperty ;
    rdfs:domain :Document ; rdfs:range xsd:dateTime .
:documentValidUntil a owl:DatatypeProperty ;
    rdfs:domain :Document ; rdfs:range xsd:dateTime .
:issuedBy a owl:ObjectProperty ;
    rdfs:domain :Document ; rdfs:range :Issuer .
:requiresDocumentType a owl:ObjectProperty ;
    rdfs:domain :Requirement ; rdfs:range :DocumentType .
:containsClaim a owl:ObjectProperty ;
    rdfs:domain :EvidenceSet ; rdfs:range :EvidenceClaim .
:claimSubject a owl:ObjectProperty ;
    rdfs:domain :EvidenceClaim .
:claimDocument a owl:ObjectProperty ;
    rdfs:domain :EvidenceClaim ; rdfs:range :Document .
:evidenceScopeClosed a owl:DatatypeProperty ;
    rdfs:domain :EvidenceSet ; rdfs:range xsd:boolean ;
    rdfs:comment "Pernyataan tentang cakupan evidence set untuk validasi kasus."@id .

:AssessmentContext a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :assessesRevision ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :TradeCaseRevision ],
        [ a owl:Restriction ; owl:onProperty :appliesInJurisdiction ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Jurisdiction ],
        [ a owl:Restriction ; owl:onProperty :usesKnowledgeRevision ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :KnowledgeRevision ] .
:Finding a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :findingInContext ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :AssessmentContext
    ] .
:ApplicabilityAssessment a owl:Class ; rdfs:subClassOf :Finding .
:CriterionAssessment a owl:Class ; rdfs:subClassOf :Finding .
:OriginAssessment a owl:Class ; rdfs:subClassOf :CriterionAssessment .
:Obligation a owl:Class ; rdfs:subClassOf :Finding .

:assessesRevision a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :TradeCaseRevision .
:assessesProduct a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :Product .
:assessesBatch a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :ProductionBatch .
:appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :Jurisdiction .
:selectedAgreement a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :TradeAgreement .
:selectedProcedure a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :CustomsProcedure .
:usesEvidenceSet a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :EvidenceSet .
:usesKnowledgeRevision a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :KnowledgeRevision .
:transactionAt a owl:DatatypeProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range xsd:dateTime .
:evaluationAt a owl:DatatypeProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range xsd:dateTime .
:engineProfileId a owl:DatatypeProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range xsd:string .
:findingInContext a owl:ObjectProperty ;
    rdfs:domain :Finding ; rdfs:range :AssessmentContext ;
    owl:inverseOf :hasFinding .
:hasFinding a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :Finding .
:evaluatesProvision a owl:ObjectProperty ;
    rdfs:domain :ApplicabilityAssessment ; rdfs:range :Provision .
:evaluatesRequirement a owl:ObjectProperty ;
    rdfs:domain :CriterionAssessment ; rdfs:range :Requirement .
:findingEvidence a owl:ObjectProperty ;
    rdfs:domain :Finding ; rdfs:range :EvidenceClaim .
:hasLegalOrigin a owl:ObjectProperty ;
    rdfs:domain :OriginAssessment ; rdfs:range :Country ;
    rdfs:comment "Asal legal pada penilaian asal yang terikat AssessmentContext."@id .

# Action vocabulary

:ActionTemplate a owl:Class .
:Precondition a owl:Class .
:Effect a owl:Class .
:Goal a owl:Class .
:PlanCandidate a owl:Class .
:PreparationArtifact a owl:Class .
:hasDraftDocumentType a owl:ObjectProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range :DocumentType .
:hasPreparationArtifact a owl:ObjectProperty ;
    rdfs:domain :TradeCaseRevision ; rdfs:range :PreparationArtifact .
:reexportChecklist a owl:NamedIndividual, :PreparationArtifact .
:hasPrecondition a owl:ObjectProperty ;
    rdfs:domain :ActionTemplate ; rdfs:range :Precondition .
:hasEffect a owl:ObjectProperty ;
    rdfs:domain :ActionTemplate ; rdfs:range :Effect .
:supportsGoal a owl:ObjectProperty ;
    rdfs:domain :ActionTemplate ; rdfs:range :Goal .
:preconditionRequirement a owl:ObjectProperty ;
    rdfs:domain :Precondition ; rdfs:range :Requirement .
:planGoal a owl:ObjectProperty ;
    rdfs:domain :PlanCandidate ; rdfs:range :Goal .
:planContext a owl:ObjectProperty ;
    rdfs:domain :PlanCandidate ; rdfs:range :AssessmentContext .

# Provenance and coverage

:SourceDocument a owl:Class ; owl:disjointWith :SourceClause .
:SourceClause a owl:Class .
:KnowledgeRevision a owl:Class .
:CoverageDeclaration a owl:Class .
:CoverageStatus a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( :coverageSupported :coveragePartial :coverageOutOfCoverage )
    ] .

:hasSourceClause a owl:ObjectProperty ; rdfs:range :SourceClause .
:clauseInDocument a owl:ObjectProperty ;
    rdfs:domain :SourceClause ; rdfs:range :SourceDocument .
:clauseLocator a owl:DatatypeProperty ;
    rdfs:domain :SourceClause ; rdfs:range xsd:string .
:sourceKey a owl:DatatypeProperty ;
    rdfs:domain :SourceDocument ; rdfs:range xsd:string .
:sourceRecordId a owl:DatatypeProperty ;
    rdfs:domain :SourceDocument ; rdfs:range xsd:string .
:knowledgeVersion a owl:DatatypeProperty ;
    rdfs:domain :KnowledgeRevision ; rdfs:range xsd:string .
:snapshotSha256 a owl:DatatypeProperty ;
    rdfs:domain :KnowledgeRevision ; rdfs:range xsd:string ;
    rdfs:comment "Hash byte snapshot yang dihitung saat artefak dibaca."@id .
:declaresCoverage a owl:ObjectProperty ;
    rdfs:domain :KnowledgeRevision ; rdfs:range :CoverageDeclaration .
:hasCoverageStatus a owl:ObjectProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range :CoverageStatus .
:coverageDispatchCountry a owl:ObjectProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range :Country .
:coverageJurisdiction a owl:ObjectProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range :Jurisdiction .
:coverageAgreement a owl:ObjectProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range :TradeAgreement .
:coverageProcedure a owl:ObjectProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range :CustomsProcedure .
:coverageUse a owl:ObjectProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range :IntendedUse .
:coverageCode a owl:ObjectProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range :HSCode .
:coverageAnchorLocalDate a owl:DatatypeProperty ;
    rdfs:domain :CoverageDeclaration ; rdfs:range xsd:string .

