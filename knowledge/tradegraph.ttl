# Multi-FTA Scheme Comparison Catalog Query (CQ05 / CQ13 / CQ14)

:query-compare-fta-schemes a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "compare-fta-schemes" ;
    rdfs:label "Perbandingan skema FTA yang memenuhi syarat untuk suatu kode HS dan rute negara (CQ05/CQ13/CQ14)"@id ;
    catalog:parameters ( "code" "dispatch" "destination" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?agreement ?agreementLabel ?facilityCode ?backToBackAllowed ?psr ?psrLevel ?conciseRule ?originDocType ?dutyPercent WHERE {
    ?agreement a tg:TradeAgreement ;
        tg:agreementParty ?dispatch ;
        tg:agreementParty ?destination ;
        tg:agreementOriginDocumentType ?originDocType .
    FILTER (?dispatch != ?destination)
    OPTIONAL { ?agreement rdfs:label ?agreementLabel . }
    OPTIONAL { ?agreement tg:pibFacilityCode ?facilityCode . }
    OPTIONAL { ?agreement tg:allowsBackToBackCoo ?backToBackAllowed . }
    ?code tg:tariffSubheading ?targetSub .
    ?targetSub tg:subheadingHeading ?targetHead .
    ?targetHead tg:headingChapter ?targetChap .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . OPTIONAL { ?subPsr tg:conciseRuleText ?subRule . } }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . OPTIONAL { ?headPsr tg:conciseRuleText ?headRule . } }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . OPTIONAL { ?chapPsr tg:conciseRuleText ?chapRule . } }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . OPTIONAL { ?genPsr tg:conciseRuleText ?genRule . } }
    FILTER (BOUND(?subPsr) || BOUND(?headPsr) || BOUND(?chapPsr) || BOUND(?genPsr))
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    BIND(COALESCE(?subRule, ?headRule, ?chapRule, ?genRule) AS ?conciseRule)
    BIND(IF(BOUND(?subPsr), "SUBHEADING", IF(BOUND(?headPsr), "HEADING", IF(BOUND(?chapPsr), "CHAPTER", "GENERAL"))) AS ?psrLevel)
    OPTIONAL {
        ?tariff a tg:TariffRateEntry ; tg:tariffAgreement ?agreement ;
            tg:tariffTargetCode ?code ; tg:preferentialDutyPercent ?dutyPercent .
        FILTER (!EXISTS { ?tariff tg:tariffPartnerCountry ?anyPartner . }
            || EXISTS { ?tariff tg:tariffPartnerCountry ?dispatch . })
    }
}""" .

# Multi-FTA Regional Cumulation, De Minimis (FOB Value & Ch. 50-63 Weight), and Minimal Operations (0.9.0)

:DeMinimisBand a owl:Class .
:DeMinimisBasis a owl:Class .
:OperationCategory a owl:Class .

:basisFobValue a owl:NamedIndividual, :DeMinimisBasis ; rdfs:label "Persentase nilai FOB"@id .
:basisProductWeight a owl:NamedIndividual, :DeMinimisBasis ; rdfs:label "Persentase berat barang jadi (Bab 50-63)"@id .
[] a owl:AllDifferent ; owl:distinctMembers ( :basisFobValue :basisProductWeight ) .

:materialOriginCountry a owl:ObjectProperty ;
    rdfs:domain :ComponentEntry ; rdfs:range :Country .
:materialOriginProofVerified a owl:DatatypeProperty ;
    rdfs:domain :ComponentEntry ; rdfs:range xsd:boolean .
:cumulationCode a owl:DatatypeProperty ;
    rdfs:domain :TradeAgreement ; rdfs:range xsd:string .
:deMinimisCode a owl:DatatypeProperty ;
    rdfs:domain :TradeAgreement ; rdfs:range xsd:string .

:hasDeMinimisBand a owl:ObjectProperty ;
    rdfs:domain :TradeAgreement ; rdfs:range :DeMinimisBand .
:deMinimisBasis a owl:ObjectProperty ;
    rdfs:domain :DeMinimisBand ; rdfs:range :DeMinimisBasis .
:deMinimisChapterMin a owl:DatatypeProperty ;
    rdfs:domain :DeMinimisBand ; rdfs:range xsd:string .
:deMinimisChapterMax a owl:DatatypeProperty ;
    rdfs:domain :DeMinimisBand ; rdfs:range xsd:string .
:deMinimisMaxPercent a owl:DatatypeProperty ;
    rdfs:domain :DeMinimisBand ; rdfs:range xsd:decimal .

:totalProductWeight a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Document ; rdfs:range xsd:decimal .
:failedCtcMaterialWeight a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Document ; rdfs:range xsd:decimal .
:weightScopeClosed a owl:DatatypeProperty ;
    rdfs:domain :Document ; rdfs:range xsd:boolean .

:productionProcessStatement a owl:NamedIndividual, :DocumentType ;
    rdfs:label "Pernyataan Tahapan Proses Produksi"@id .
:performedOperation a owl:ObjectProperty ;
    rdfs:domain :Document ; rdfs:range :OperationCategory .
:processScopeClosed a owl:DatatypeProperty ;
    rdfs:domain :Document ; rdfs:range xsd:boolean .
:disqualifyingOperation a owl:ObjectProperty ;
    rdfs:domain :TradeAgreement ; rdfs:range :OperationCategory .

:minimalPreservation a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pengawetan untuk menjaga kondisi selama penyimpanan/pengangkutan"@id .
:minimalPackaging a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pengemasan atau penyajian sederhana untuk dijual"@id .
:minimalTransportFacilitation a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pengerjaan untuk memfasilitasi pengiriman atau pengangkutan"@id .
:minimalSimpleSortingOrCutting a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pemilahan, penyortiran, pemotongan, atau penggilingan sederhana"@id .
:minimalLabeling a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pembubuhan atau pencetakan tanda, label, atau logo"@id .
:minimalSimpleDilution a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pelarutan sederhana dalam air tanpa mengubah karakter barang"@id .
:minimalDisassembly a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pembongkaran atau penguraian produk menjadi bagian-bagian"@id .
:minimalSlaughter a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Penyembelihan hewan semata"@id .
:minimalSimpleMixing a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Pencampuran produk secara sederhana"@id .
:minimalGri2aAssembly a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Penggabungan komponen belum dirakit sesuai KUMHS 2(a)"@id .
:minimalSimpleSetAssembly a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Semata-mata mengumpulkan barang menjadi satu set"@id .
:substantialManufacturing a owl:NamedIndividual, :OperationCategory ;
    rdfs:label "Proses manufaktur atau transformasi substansial"@id .
[] a owl:AllDifferent ;
    owl:distinctMembers (
        :minimalPreservation :minimalPackaging :minimalTransportFacilitation
        :minimalSimpleSortingOrCutting :minimalLabeling :minimalSimpleDilution
        :minimalDisassembly :minimalSlaughter :minimalSimpleMixing
        :minimalGri2aAssembly :minimalSimpleSetAssembly :substantialManufacturing
    ) .

