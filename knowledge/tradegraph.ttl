:productionInputUse a owl:NamedIndividual, :IntendedUse .

[] a owl:AllDifferent ; owl:distinctMembers ( :productionInputUse :commercialResaleUse ) .

:producerImporterId a owl:NamedIndividual, :DocumentType .

:deMinimisValueStatement a owl:NamedIndividual, :DocumentType .

:exhibitionStorageRecord a owl:NamedIndividual, :DocumentType .

:percentUnit a owl:NamedIndividual, :Unit .

:atiga-article-33 a owl:NamedIndividual, :SourceClause ;

    :clauseInDocument :source-atiga-text ; :clauseLocator "Article 33 (De Minimis)" .

:maximumDeMinimisPercent a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal .

:pumpPsrThreshold :maximumDeMinimisPercent 10.00 .

:fobValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range xsd:decimal .

:nonOriginatingMaterialValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range xsd:decimal .

:failedCtcMaterialValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range xsd:decimal .

:valuationCurrency a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range :Currency .

:valuationScopeClosed a owl:DatatypeProperty ; rdfs:domain :Document ; rdfs:range xsd:boolean .

:temporaryUsePermitStart a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Shipment ; rdfs:range xsd:dateTime .

:permitExtended a owl:DatatypeProperty ; rdfs:domain :Shipment ; rdfs:range xsd:boolean .

:exhibitionCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Shipment ; rdfs:range xsd:integer .

:customsSupervisedStorage a owl:DatatypeProperty ; rdfs:domain :Document ; rdfs:range xsd:boolean .

catalog:requiredUse a owl:AnnotationProperty .

catalog:alternativeUse a owl:AnnotationProperty .



:policy-importer-api-u catalog:requiredUse :commercialResaleUse ; catalog:alternativeUse :productionInputUse ;
    catalog:exceptionQuery :q-alternative-import-use .

:policy-importer-api-p a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "importer-api-p" ; rdfs:label "Identitas API-P untuk penggunaan produksi sendiri"@id ;
    catalog:coverageScope :scope-pump-import ; catalog:policyKind "OBLIGATION" ; :hasSourceClause :permendag16-import ;
    catalog:responsibleRole :roleImporter ; catalog:evidenceType :producerImporterId ; catalog:shipmentBound false ;
    catalog:requiredUse :productionInputUse ; catalog:alternativeUse :commercialResaleUse ;
    catalog:satisfiedQuery :q-issued-document ; catalog:exceptionQuery :q-alternative-import-use .

:q-alternative-import-use a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "alternative-import-use" ; rdfs:label "Penggunaan tercatat untuk jalur API lainnya"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?revision WHERE {
    ?definition cat:alternativeUse ?other ; cat:requiredUse ?required .
    ?context tg:assessesRevision ?revision .
    ?revision tg:intendedUse ?other .
    FILTER NOT EXISTS { ?revision tg:intendedUse ?required . }
}""" .



:policy-atiga-de-minimis-value a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-de-minimis-value" ; rdfs:label "Batas nilai de minimis untuk input yang gagal CTC"@id ;
    catalog:coverageScope :scope-pump-import ; catalog:policyKind "CRITERION" ; :hasSourceClause :atiga-article-33 ;
    catalog:satisfiedQuery :q-de-minimis-met ; catalog:failedQuery :q-de-minimis-exceeded .

:q-de-minimis-met a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "de-minimis-met" ; rdfs:label "Nilai input gagal CTC dalam batas proporsi"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:deMinimisValueStatement ; tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:documentComponentList ?bom ; tg:valuationScopeClosed true ; tg:valuationCurrency ?currency ;
        tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedValue .
    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true .
    tg:pumpPsrThreshold tg:maximumDeMinimisPercent ?maximum .
    FILTER NOT EXISTS { ?evidence tg:valuationScopeClosed false . }
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    FILTER (isIRI(?currency) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedValue) = xsd:decimal
        && ?fob > 0 && ?failedValue >= 0 && ?failedValue <= ?fob)
    FILTER (?failedValue * 100 <= ?fob * ?maximum)
}""" .

:q-de-minimis-exceeded a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "de-minimis-exceeded" ; rdfs:label "Nilai input gagal CTC melebihi batas proporsi"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:deMinimisValueStatement ; tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:documentComponentList ?bom ; tg:valuationScopeClosed true ; tg:valuationCurrency ?currency ;
        tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedValue .
    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true .
    tg:pumpPsrThreshold tg:maximumDeMinimisPercent ?maximum .
    FILTER NOT EXISTS { ?evidence tg:valuationScopeClosed false . }
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    FILTER (isIRI(?currency) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedValue) = xsd:decimal
        && ?fob > 0 && ?failedValue >= 0 && ?failedValue <= ?fob)
    FILTER (?failedValue * 100 > ?fob * ?maximum)
}""" .



:policy-temporary-exhibition-term a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "temporary-exhibition-term" ; rdfs:label "Jangka waktu dan perpanjangan izin pameran pompa"@id ;
    catalog:coverageScope :scope-pump-exhibition ; catalog:policyKind "CRITERION" ; :hasSourceClause :pmk106-exhibition ;
    catalog:maximumDelay "P1Y" ;
    catalog:satisfiedQuery :q-exhibition-term-valid ; catalog:failedQuery :q-exhibition-term-invalid .

:q-exhibition-term-valid a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-term-valid" ; rdfs:label "Jangka izin tidak diperpanjang dan dalam batas"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:temporaryImportPermit ; tg:documentShipment ?shipment .
    ?shipment tg:temporaryUsePermitStart ?start ; tg:temporaryUsePermitEnd ?end ; tg:permitExtended ?extended .
    ?definition cat:maximumDelay ?maximum .
    BIND (?start + STRDT(STR(?maximum), xsd:yearMonthDuration) AS ?deadline)
    FILTER (BOUND(?deadline) && ?end > ?start && (?end <= ?deadline && ?extended = false))
}""" .

:q-exhibition-term-invalid a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-term-invalid" ; rdfs:label "Jangka izin melebihi batas atau ada perpanjangan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:temporaryImportPermit ; tg:documentShipment ?shipment .
    ?shipment tg:temporaryUsePermitStart ?start ; tg:temporaryUsePermitEnd ?end ; tg:permitExtended ?extended .
    ?definition cat:maximumDelay ?maximum .
    BIND (?start + STRDT(STR(?maximum), xsd:yearMonthDuration) AS ?deadline)
    FILTER (BOUND(?deadline) && ?end > ?start && (?end > ?deadline || ?extended = true))
}""" .



:policy-temporary-interval-storage a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "temporary-interval-storage" ; rdfs:label "Tempat khusus dan pengawasan antar pameran"@id ;
    catalog:coverageScope :scope-pump-exhibition ; catalog:policyKind "OBLIGATION" ; :hasSourceClause :pmk106-exhibition ;
    catalog:responsibleRole :roleImporter ;
    catalog:satisfiedQuery :q-exhibition-storage-met ; catalog:failedQuery :q-exhibition-storage-failed ;
    catalog:exceptionQuery :q-one-exhibition .

:q-exhibition-storage-met a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-storage-met" ; rdfs:label "Bukti penyimpanan khusus dengan pengawasan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:exhibitionCount ?count .
    ?evidence tg:documentType tg:exhibitionStorageRecord ; tg:documentShipment ?shipment ;
       tg:customsSupervisedStorage true .
    FILTER (?count > 1)
}""" .

:q-exhibition-storage-failed a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-storage-failed" ; rdfs:label "Bukti penyimpanan yang tidak memenuhi kondisi"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:exhibitionCount ?count .
    ?evidence tg:documentType tg:exhibitionStorageRecord ; tg:documentShipment ?shipment ;
       tg:customsSupervisedStorage false .
    FILTER (?count > 1)
}""" .

:q-one-exhibition a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "one-exhibition" ; rdfs:label "Satu pameran tanpa jeda antar pameran"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?shipment WHERE {
    ?context tg:assessmentShipment ?shipment .
    ?shipment tg:exhibitionCount 1 .
}""" .



:calc-atiga-rvc-indirect a owl:NamedIndividual, catalog:CalculationDefinition ;
    catalog:id "atiga-rvc-indirect" ; rdfs:label "Kandungan nilai regional dengan metode tidak langsung"@id ;
    :hasSourceClause :atiga-article-29 ;
    catalog:typedParameters (
        [ catalog:name "worksheet" ; catalog:valueType catalog:IRI ]
        [ catalog:name "batch" ; catalog:valueType catalog:IRI ; catalog:fromContext "batch" ]
    ) ;
    catalog:scopeParameter "worksheet" ;
    catalog:closureSparql """PREFIX tg: <urn:tradegraph:kb#>
ASK {
    ?worksheet a tg:Document ; tg:documentBatch ?batch ; tg:valuationScopeClosed true .
    FILTER NOT EXISTS { ?worksheet tg:valuationScopeClosed false . }
    FILTER NOT EXISTS { ?worksheet tg:documentBatch ?other . FILTER (?other != ?batch) }
}""" ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (((?fob - ?vnm) * 100 / ?fob) AS ?value) (tg:percentUnit AS ?unit) WHERE {
    ?worksheet tg:fobValue ?fob ; tg:nonOriginatingMaterialValue ?vnm ; tg:valuationCurrency ?inputCurrency .
    FILTER (isIRI(?inputCurrency) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?vnm) = xsd:decimal
        && ?fob > 0 && ?vnm >= 0 && ?vnm <= ?fob)
}""" .


