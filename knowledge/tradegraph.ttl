:requestedSettlement a owl:ObjectProperty ; rdfs:domain :TradeCaseRevision ; rdfs:range :SettlementChoice .
:settlementGround a owl:ObjectProperty ; rdfs:domain :TradeCaseRevision ; rdfs:range :SettlementGround .
:importCategory a owl:ObjectProperty ; rdfs:domain :TradeGood ; rdfs:range :ImportCategory .
