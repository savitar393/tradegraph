:conferenceUse a owl:NamedIndividual, :IntendedUse ; :customsReliefGroup :exhibitionReliefGroup .
:exhibitionUse :customsReliefGroup :exhibitionReliefGroup .
[] a owl:AllDifferent ; owl:distinctMembers ( :exhibitionUse :conferenceUse :commercialResaleUse ) .

