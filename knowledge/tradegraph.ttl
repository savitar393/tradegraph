:pmk131-lampiran-a-cumulation a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-asal-atiga ;
    :clauseLocator "Lampiran Huruf A angka I.d & II.1.a (Akumulasi ASEAN, kode ACL)" .
:pmk131-lampiran-a-minimal-dm a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-asal-atiga ;
    :clauseLocator "Lampiran Huruf A angka IV.1-IV.2 (Proses Minimal & De Minimis 10% FOB, kode DMS)" .
:pmk209-lampiran-a-iv a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-asal-rcep ;
    :clauseLocator "Lampiran Huruf A angka IV.1-IV.3 (Kumulasi ACU, Proses Minimal, De Minimis 10% FOB / 10% Berat Bab 50-63 DMI)" .
:pmk171-lampiran-a-iii a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-asal-acfta ;
    :clauseLocator "Lampiran Huruf A angka III.1-III.3 (Kumulasi, Proses Minimal, De Minimis 10% FOB / 10% Berat Bab 50-63)" .
:pmk73-lampiran-a-iv a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-asal-ijepa ;
    :clauseLocator "Lampiran Huruf A angka IV.1-IV.3 (Akumulasi ACU, Proses Tidak Memenuhi Kualifikasi, De Minimis 10% FOB Bab 28-49 & 64-97 / 7% Berat Bab 50-63 DMI)" .

