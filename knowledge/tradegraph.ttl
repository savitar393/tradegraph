    :thirdPartyInvoiceRequirement "Cantumkan nama perusahaan penerbit Third Party Invoice pada Box 9 dan beri tanda (✓/X) kotak 'THIRD PARTY INVOICING' pada Box 12 Form IA-CEPA (PMK 82/2020 Pasal 11)." .

:query-export-lartas a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "export-lartas" ;
    rdfs:label "Aturan Larangan dan Pembatasan (Lartas) Ekspor Indonesia aktif per kode HS, yurisdiksi, dan tanggal"@id ;
    catalog:parameters ( "code" "jurisdiction" "asOfDate" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?rule ?commodityGroup ?supervisionMode ?supervisionLabel ?prohibited
    ?requiredDocType ?requiredDocLabel ?effectiveFrom ?sourceClause
WHERE {
    ?rule a tg:ExportRestrictionRule ;
        tg:exportLartasTargetCode ?code ;
        tg:exportLartasJurisdiction ?jurisdiction ;
        tg:exportLartasSupervisionMode ?supervisionMode .
    OPTIONAL { ?supervisionMode rdfs:label ?supervisionLabel . }
    OPTIONAL { ?rule tg:exportLartasCommodityGroup ?commodityGroup . }
    OPTIONAL { ?rule tg:exportLartasProhibited ?prohFlag . }
    BIND(COALESCE(?prohFlag, false) AS ?prohibited)
    OPTIONAL { ?rule tg:exportLartasEffectiveFrom ?effectiveFrom . }
    FILTER (!BOUND(?effectiveFrom) || STR(?effectiveFrom) <= STR(?asOfDate))
    OPTIONAL {
        ?rule tg:exportLartasRequiresDocumentType ?requiredDocType .
        OPTIONAL { ?requiredDocType rdfs:label ?requiredDocLabel . }
    }
    OPTIONAL { ?rule tg:hasSourceClause ?sourceClause . }
}""" .

:query-export-fta-options a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "export-fta-options" ;
    rdfs:label "Skema FTA ekspor yang tersedia antara negara asal dan negara tujuan beserta PSR, bukti asal, Back-to-Back, dan Third-Party Invoicing"@id ;
    catalog:parameters ( "code" "origin" "destination" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?agreement ?agreementLabel ?facilityCode ?primaryOriginDoc ?primaryOriginDocLabel
    ?backToBackAllowed ?backToBackClause ?thirdPartyAllowed ?thirdPartyReq ?thirdPartyClause
    ?psr ?psrLevel ?conciseRule
WHERE {
    ?code a tg:HSCode ; tg:tariffSubheading ?sub .
    ?sub tg:subheadingHeading ?head .
    ?head tg:headingChapter ?chap .
    ?agreement a tg:TradeAgreement ;
        tg:agreementParty ?origin ;
        tg:agreementParty ?destination .
    FILTER (?origin != ?destination)
    OPTIONAL { ?agreement rdfs:label ?agreementLabel . }
    OPTIONAL { ?agreement tg:pibFacilityCode ?facilityCode . }
    OPTIONAL {
        ?agreement tg:primaryOriginDocumentType ?primaryOriginDoc .
        OPTIONAL { ?primaryOriginDoc rdfs:label ?primaryOriginDocLabel . }
    }
    OPTIONAL { ?agreement tg:allowsBackToBackCoo ?b2b . }
    BIND(COALESCE(?b2b, false) AS ?backToBackAllowed)
    OPTIONAL { ?agreement tg:backToBackClause ?backToBackClause . }
    OPTIONAL { ?agreement tg:allowsThirdPartyInvoicing ?tpi . }
    BIND(COALESCE(?tpi, false) AS ?thirdPartyAllowed)
    OPTIONAL { ?agreement tg:thirdPartyInvoiceRequirement ?thirdPartyReq . }
    OPTIONAL { ?agreement tg:thirdPartyInvoiceClause ?thirdPartyClause . }
    OPTIONAL {
        ?subPsr tg:psrForSubheading ?sub ; tg:psrAgreement ?agreement .
        OPTIONAL { ?subPsr tg:conciseRuleText ?subRule . }
    }
    OPTIONAL {
        ?headPsr tg:psrForHeading ?head ; tg:psrAgreement ?agreement .
        OPTIONAL { ?headPsr tg:conciseRuleText ?headRule . }
    }
    OPTIONAL {
        ?chapPsr tg:psrForChapter ?chap ; tg:psrAgreement ?agreement .
        OPTIONAL { ?chapPsr tg:conciseRuleText ?chapRule . }
    }
    OPTIONAL {
        ?agreement tg:generalOriginRule ?genPsr .
        OPTIONAL { ?genPsr tg:conciseRuleText ?genRule . }
    }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    BIND(COALESCE(?subRule, ?headRule, ?chapRule, ?genRule) AS ?conciseRule)
    BIND(IF(BOUND(?subPsr), "SUBHEADING", IF(BOUND(?headPsr), "HEADING", IF(BOUND(?chapPsr), "CHAPTER", IF(BOUND(?genPsr), "GENERAL", "NONE")))) AS ?psrLevel)
}""" .

