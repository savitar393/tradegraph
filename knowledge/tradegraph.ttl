# Catalog declarations support editing the canonical document in OWL-aware tools.
# The loader selects definition instances and their nested structures for the catalog graph.

catalog:FieldDefinition a owl:Class .
catalog:QueryDefinition a owl:Class .
catalog:ActionDefinition a owl:Class .
catalog:GoalDefinition a owl:Class .
catalog:ObjectiveDefinition a owl:Class .
catalog:EvidenceDefinition a owl:Class .
catalog:CalculationDefinition a owl:Class .
catalog:id a owl:AnnotationProperty .
catalog:property a owl:AnnotationProperty .
catalog:valueType a owl:AnnotationProperty .
catalog:parameters a owl:AnnotationProperty .
catalog:sparql a owl:AnnotationProperty .
catalog:preconditions a owl:AnnotationProperty .
catalog:effects a owl:AnnotationProperty .
catalog:requiresDocumentType a owl:AnnotationProperty .
catalog:producesDraftOf a owl:AnnotationProperty .
catalog:goals a owl:AnnotationProperty .
catalog:dependencies a owl:AnnotationProperty .
catalog:operation a owl:AnnotationProperty .
catalog:groundingSparql a owl:AnnotationProperty .
catalog:applicabilitySparql a owl:AnnotationProperty .
catalog:metric a owl:AnnotationProperty .
catalog:unit a owl:AnnotationProperty .
catalog:amount a owl:AnnotationProperty .
catalog:cost a owl:AnnotationProperty .
catalog:duration a owl:AnnotationProperty .
catalog:shape a owl:AnnotationProperty .
catalog:typedParameters a owl:AnnotationProperty .
catalog:name a owl:AnnotationProperty .
catalog:fromContext a owl:AnnotationProperty .
catalog:scopeParameter a owl:AnnotationProperty .
catalog:closureSparql a owl:AnnotationProperty .

:field-transaction-at a owl:NamedIndividual, catalog:FieldDefinition ;
    catalog:id "transactionAt" ;
    rdfs:label "Waktu transaksi"@id ;
    catalog:property :transactionAt ;
    catalog:valueType xsd:dateTime .

:field-assessed-product a owl:NamedIndividual, catalog:FieldDefinition ;
    catalog:id "assessedProduct" ;
    rdfs:label "Barang yang dinilai"@id ;
    catalog:property :assessesProduct ;
    catalog:valueType :Product .

:query-cq01 a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "CQ01" ;
    rdfs:label "Material dan pemasok produk"@id ;
    catalog:parameters ( "product" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?material ?supplier WHERE {
    ?product tg:dependsOnMaterial ?material .
    OPTIONAL { ?material tg:suppliedBy ?supplier . }
}""" .

:action-prepare-reexport-notice a owl:NamedIndividual, :ActionTemplate, catalog:ActionDefinition ;
    catalog:id "prepare-reexport-notice" ;
    rdfs:label "Siapkan draf pemberitahuan ekspor kembali"@id ;
    :hasSourceClause :pmk178-article-17 ;
    catalog:goals ( :goal-reexport-draft :goal-reexport-preparation ) ;
    catalog:typedParameters ( [ catalog:name "revision" ; catalog:valueType catalog:IRI ;
        catalog:fromContext "revision" ] ) ;
    catalog:applicabilitySparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?context cd:assessedCoverage tg:scope-pump-exhibition .
    ?revision tg:requestedSettlement tg:reexportSettlement .
}""" ;
    catalog:preconditions ( [
        catalog:requiresDocumentType :temporaryImportPermit ;
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?permit .
    ?permit tg:documentType tg:temporaryImportPermit ; tg:documentShipment ?shipment .
}"""
    ] ) ;
    catalog:effects ( [
        catalog:producesDraftOf :idExportDeclaration ; catalog:operation "ADD" ;
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
CONSTRUCT { ?revision tg:hasDraftDocumentType tg:idExportDeclaration . } WHERE {}"""
    ] ) .

:action-prepare-reexport-checklist a owl:NamedIndividual, :ActionTemplate, catalog:ActionDefinition ;
    catalog:id "prepare-reexport-checklist" ;
    rdfs:label "Siapkan daftar periksa pengiriman dan dokumen ekspor kembali"@id ;
    :hasSourceClause :pmk178-article-17 ;
    catalog:goals ( :goal-reexport-preparation ) ;
    catalog:dependencies ( "prepare-reexport-notice" ) ;
    catalog:typedParameters ( [ catalog:name "revision" ; catalog:valueType catalog:IRI ;
        catalog:fromContext "revision" ] ) ;
    catalog:applicabilitySparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?context cd:assessedCoverage tg:scope-pump-exhibition .
    ?revision tg:requestedSettlement tg:reexportSettlement .
}""" ;
    catalog:preconditions ( [ catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
ASK { ?revision tg:hasDraftDocumentType tg:idExportDeclaration ; tg:revisionShipment ?shipment . }""" ] ) ;
    catalog:effects ( [ catalog:operation "ADD" ; catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
CONSTRUCT { ?revision tg:hasPreparationArtifact tg:reexportChecklist . } WHERE {}""" ] ) .

:goal-reexport-draft a owl:NamedIndividual, catalog:GoalDefinition ;
    catalog:id "reexport-draft" ; rdfs:label "Draf pemberitahuan ekspor kembali disiapkan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
ASK { ?revision tg:hasDraftDocumentType tg:idExportDeclaration . }""" .

:goal-reexport-preparation a owl:NamedIndividual, catalog:GoalDefinition ;
    catalog:id "reexport-preparation" ; rdfs:label "Draf dan daftar periksa ekspor kembali disiapkan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
ASK {
    ?revision tg:hasDraftDocumentType tg:idExportDeclaration ; tg:hasPreparationArtifact tg:reexportChecklist .
}""" .

:objective-fewest-actions a owl:NamedIndividual, catalog:ObjectiveDefinition ;
    catalog:id "fewest-actions" ; rdfs:label "Jumlah langkah paling sedikit"@id ; catalog:metric "STEPS" .

# A structural check of product evidence in the declared case scope.
:evidence-product-document a owl:NamedIndividual, catalog:EvidenceDefinition ;
    catalog:id "product-supporting-document" ;
    rdfs:label "Dokumen pendukung produk"@id ;
    catalog:shape :document-evidence-shape ;
    catalog:admitEvidence true ;
    catalog:parameters ( "scope" "product" "jurisdiction" "transactionAt" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?focus WHERE {
    ?scope tg:containsClaim ?focus .
    ?focus rdf:predicate tg:hasSupportingDocument .
}""" .

:document-evidence-shape a sh:NodeShape ;
    sh:targetClass :EvidenceClaim ;
    sh:property [
        sh:path <urn:tradegraph:case-data#verificationStatus> ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^VERIFIED$"
    ], [
        sh:path rdf:object ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:equals <urn:tradegraph:case-data#sourceReference>
    ], [
        sh:path <urn:tradegraph:case-data#sourceReference> ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:node [
            sh:class :Document ;
            sh:property [
                sh:path :documentType ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI
            ], [
                sh:path :documentSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI
            ], [
                sh:path :documentJurisdiction ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI
            ], [
                sh:path :documentValidFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
                sh:pattern "T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
            ], [
                sh:path :documentValidUntil ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
                sh:pattern "T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Subjek, yurisdiksi, atau periode dokumen tidak sesuai dengan konteks transaksi."@id ;
        sh:select """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT $this WHERE {
    ?context tg:usesEvidenceSet/tg:containsClaim $this ;
        tg:assessesProduct ?product ;
        tg:appliesInJurisdiction ?jurisdiction ;
        tg:transactionAt ?transactionAt .
    $this tg:claimSubject ?subject ; cd:sourceReference ?document .
    ?document tg:documentSubject ?documentSubject ;
        tg:documentJurisdiction ?documentJurisdiction ;
        tg:documentValidFrom ?start ; tg:documentValidUntil ?end .
    FILTER (
        ?subject != ?product || ?documentSubject != ?product ||
        ?documentJurisdiction != ?jurisdiction ||
        ?start >= ?end || ?transactionAt < ?start || ?transactionAt >= ?end
    )
}"""
    ] .

# Sum recorded line values in a complete component list for the assessed batch.
:calc-total-component-value a owl:NamedIndividual, catalog:CalculationDefinition ;
    catalog:id "total-component-value" ;
    rdfs:label "Total nilai komponen per batch"@id ;
    catalog:typedParameters (
        [ catalog:name "componentList" ; catalog:valueType catalog:IRI ]
        [ catalog:name "batch" ; catalog:valueType catalog:IRI ; catalog:fromContext "batch" ]
    ) ;
    catalog:scopeParameter "componentList" ;
    catalog:closureSparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    ?componentList a tg:ComponentList ;
        tg:componentListForBatch ?batch ;
        tg:componentListClosed ?closed .
    FILTER (DATATYPE(?closed) = xsd:boolean && ?closed = true)
    FILTER NOT EXISTS {
        ?componentList tg:componentListClosed ?otherClosure .
        FILTER (!sameTerm(?otherClosure, ?closed))
    }
    FILTER NOT EXISTS {
        ?componentList tg:componentListForBatch ?otherBatch .
        FILTER (!sameTerm(?otherBatch, ?batch))
    }
}""" ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (SUM(?decimal) AS ?value) (SAMPLE(?rowUnit) AS ?unit) (SAMPLE(?rowCurrency) AS ?currency)
WHERE {
    ?componentList tg:componentEntry ?entry .
    OPTIONAL {
        ?entry tg:componentAmount ?measurement .
        OPTIONAL { ?measurement tg:amountValue ?amount . }
        OPTIONAL { ?measurement tg:amountUnit ?rowUnit . }
        OPTIONAL { ?measurement tg:amountCurrency ?rowCurrency . }
    }
    BIND(IF(DATATYPE(?amount) = xsd:decimal && isNumeric(?amount), ?amount, 1/0) AS ?decimal)
}
HAVING (
    COUNT(?entry) > 0 &&
    COUNT(?entry) = COUNT(DISTINCT ?entry) &&
    COUNT(?entry) = COUNT(?decimal) &&
    COUNT(?entry) = COUNT(?rowUnit) && COUNT(DISTINCT ?rowUnit) = 1 &&
    COUNT(?entry) = COUNT(?rowCurrency) && COUNT(DISTINCT ?rowCurrency) = 1
)""" .

