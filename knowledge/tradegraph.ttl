:hs2-23 a owl:NamedIndividual, :HSChapter ; :chapterCode "23" .
:hs4-2309 a owl:NamedIndividual, :HSHeading ; :headingCode "2309" ; :headingChapter :hs2-23 .
:hs6-230910 a owl:NamedIndividual, :HSSubheading ; :subheadingCode "230910" ; :subheadingHeading :hs4-2309 .

:hs2-30 a owl:NamedIndividual, :HSChapter ; :chapterCode "30" .
:hs4-3003 a owl:NamedIndividual, :HSHeading ; :headingCode "3003" ; :headingChapter :hs2-30 .
:hs4-3004 a owl:NamedIndividual, :HSHeading ; :headingCode "3004" ; :headingChapter :hs2-30 .
:hs6-300410 a owl:NamedIndividual, :HSSubheading ; :subheadingCode "300410" ; :subheadingHeading :hs4-3004 .

:hs2-74 a owl:NamedIndividual, :HSChapter ; :chapterCode "74" .
:hs4-7405 a owl:NamedIndividual, :HSHeading ; :headingCode "7405" ; :headingChapter :hs2-74 .
:hs6-740500 a owl:NamedIndividual, :HSSubheading ; :subheadingCode "740500" ; :subheadingHeading :hs4-7405 .

:hs4-9605 a owl:NamedIndividual, :HSHeading ; :headingCode "9605" ; :headingChapter :hs2-96 .
:hs6-960500 a owl:NamedIndividual, :HSSubheading ; :subheadingCode "960500" ; :subheadingHeading :hs4-9605 .

:psr-ijepa-960500 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :ijepa ; :psrForSubheading :hs6-960500 ;
    :conciseRuleText "CC" ;
    :hasPsrAlternative :psr-ijepa-960500-alt-1 ;
    :hasSourceClause :pmk73-lampiran-a .
:psr-ijepa-960500-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionCC .

:psr-ijepa-740500 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :ijepa ; :psrForSubheading :hs6-740500 ;
    :conciseRuleText "CTSH or QVC40" ;
    :hasPsrAlternative :psr-ijepa-740500-alt-1, :psr-ijepa-740500-alt-2 ;
    :hasSourceClause :pmk73-lampiran-a .
:psr-ijepa-740500-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ; :requiresCriterionKind :criterionCTSH .
:psr-ijepa-740500-alt-2 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionRVC ; :alternativeRvcThreshold :ijepa-rvc-40-threshold .

:psr-ijepa-230910 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :ijepa ; :psrForSubheading :hs6-230910 ;
    :conciseRuleText "CC provided there is QVC40" ;
    :hasPsrAlternative :psr-ijepa-230910-alt-1 ;
    :hasSourceClause :pmk73-lampiran-a .
:psr-ijepa-230910-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionCC, :criterionRVC ;
    :alternativeRvcThreshold :ijepa-rvc-40-threshold .

:psr-ijepa-300410 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :ijepa ; :psrForSubheading :hs6-300410 ;
    :conciseRuleText "CTH except from heading 30.03; QVC40; or Chemical Reaction" ;
    :hasPsrAlternative :psr-ijepa-300410-alt-1, :psr-ijepa-300410-alt-2, :psr-ijepa-300410-alt-3 ;
    :hasSourceClause :pmk73-lampiran-a .
:psr-ijepa-300410-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionCTH ; :excludesHeading :hs4-3003 .
:psr-ijepa-300410-alt-2 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionRVC ; :alternativeRvcThreshold :ijepa-rvc-40-threshold .
:psr-ijepa-300410-alt-3 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionChemicalReaction .

