catalog:satisfiedQuery a owl:AnnotationProperty .
catalog:failedQuery a owl:AnnotationProperty .
catalog:exceptionQuery a owl:AnnotationProperty .
catalog:policyJurisdiction a owl:AnnotationProperty .
catalog:responsibleRole a owl:AnnotationProperty .
catalog:evidenceType a owl:AnnotationProperty .
catalog:shipmentBound a owl:AnnotationProperty .
catalog:admitEvidence a owl:AnnotationProperty .
catalog:maximumDelay a owl:AnnotationProperty .
catalog:exactDecimal a owl:AnnotationProperty .

:ruleId a owl:AnnotationProperty .
:ruleSourceClause a owl:AnnotationProperty .
:ruleReviewStatus a owl:AnnotationProperty .
:rvcDocumentVar a swrl:Variable .
:rvcPercentVar a swrl:Variable .
:rvcLimitVar a swrl:Variable .

# Numeric classification of named RVC worksheets. The assessment also requires admitted case evidence.
[] a swrl:Imp ; :ruleId "atiga-pump-rvc-threshold-met" ; rdfs:label "atiga-pump-rvc-threshold-met" ;
    :ruleSourceClause :psr-row-2042, :atiga-article-29 ; :ruleReviewStatus "SOURCE_REVIEWED" ;
    swrl:body [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :documentType ;
            swrl:argument1 :rvcDocumentVar ; swrl:argument2 :rvcWorksheet ] ;
        rdf:rest [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :recordedRvcPercent ;
                swrl:argument1 :rvcDocumentVar ; swrl:argument2 :rvcPercentVar ] ;
            rdf:rest [ a swrl:AtomList ;
                rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :minimumRvcPercent ;
                    swrl:argument1 :pumpPsrThreshold ; swrl:argument2 :rvcLimitVar ] ;
                rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ;
                        swrl:arguments ( :rvcPercentVar :rvcLimitVar ) ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
        rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :PumpRvcThresholdMet ; swrl:argument1 :rvcDocumentVar ] ;
        rdf:rest rdf:nil ] .

[] a swrl:Imp ; :ruleId "atiga-pump-rvc-threshold-not-met" ; rdfs:label "atiga-pump-rvc-threshold-not-met" ;
    :ruleSourceClause :psr-row-2042, :atiga-article-29 ; :ruleReviewStatus "SOURCE_REVIEWED" ;
    swrl:body [ a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :documentType ;
            swrl:argument1 :rvcDocumentVar ; swrl:argument2 :rvcWorksheet ] ;
        rdf:rest [ a swrl:AtomList ;
            rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :recordedRvcPercent ;
                swrl:argument1 :rvcDocumentVar ; swrl:argument2 :rvcPercentVar ] ;
            rdf:rest [ a swrl:AtomList ;
                rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :minimumRvcPercent ;
                    swrl:argument1 :pumpPsrThreshold ; swrl:argument2 :rvcLimitVar ] ;
                rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ;
                        swrl:arguments ( :rvcPercentVar :rvcLimitVar ) ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
        rdf:first [ a swrl:ClassAtom ; swrl:classPredicate :PumpRvcThresholdNotMet ; swrl:argument1 :rvcDocumentVar ] ;
        rdf:rest rdf:nil ] .

:subheadingCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :HSSubheading ; rdfs:range xsd:string .
:hs6-841370 :subheadingCode "841370" .
:hs6-841391 :subheadingCode "841391" .
:hs6-090121 :subheadingCode "090121" .
:documentSettlementGround a owl:ObjectProperty ; rdfs:domain :Document ; rdfs:range :SettlementGround .
:settlementGroundsClosed a owl:DatatypeProperty ; rdfs:domain :TradeCaseRevision ; rdfs:range xsd:boolean .

# Match only the reviewed route, tariff line, procedure, local-day window and context.
:reviewed-scope-selector a owl:NamedIndividual, catalog:CoverageQuery ;
    catalog:id "reviewed-case-scope" ; rdfs:label "Cakupan kasus yang telah dikurasi"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?scope WHERE {
    ?context tg:appliesInJurisdiction ?jurisdiction ; tg:selectedProcedure ?procedure ;
        tg:assessesProduct ?product ; tg:assessesRevision ?revision ;
        tg:assessmentShipment ?shipment ; tg:transactionAt ?at .
    ?shipment tg:containsGoods ?product ; tg:shipmentDispatchCountry ?dispatch ;
        tg:shipmentDestinationCountry ?destination ; tg:cargoCategory tg:regularCargo .
    ?product tg:hasTariffClassification ?code .
    ?scope a tg:CoverageDeclaration ; tg:coverageJurisdiction ?jurisdiction ;
        tg:coverageProcedure ?procedure ; tg:coverageCode ?code ;
        tg:coverageDispatchCountry ?dispatch ; tg:coverageDestinationCountry ?destination ;
        tg:coverageWindow ?window .
    ?window tg:windowJurisdiction ?jurisdiction ; tg:windowFrom ?from ; tg:windowUntil ?until .
    FILTER (?at >= ?from && ?at < ?until)
    FILTER NOT EXISTS {
        ?scope tg:coverageAgreement ?agreement .
        FILTER NOT EXISTS { ?context tg:selectedAgreement ?agreement . }
    }
    FILTER NOT EXISTS {
        ?scope tg:coverageUse ?intendedUse .
        FILTER NOT EXISTS { ?revision tg:intendedUse ?intendedUse . }
    }
    FILTER NOT EXISTS {
        ?context tg:assessmentShipment ?otherShipment . FILTER (?otherShipment != ?shipment)
    }
}""" .

:q-issued-document a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "issued-document" ; rdfs:label "Bukti dokumen pihak yang bertanggung jawab"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?definition cat:responsibleRole ?role .
    ?context tg:assessesRevision ?revision .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole ?role ; tg:roleActor ?actor .
    OPTIONAL { ?definition cat:requiredUse ?requiredUse . }
    FILTER (!BOUND(?requiredUse) || EXISTS { ?revision tg:intendedUse ?requiredUse . })
    ?definition cat:evidenceType ?type ; cat:shipmentBound ?shipmentBound .
    ?context cd:admittedDocument ?evidence .
    ?evidence tg:documentType ?type ; tg:documentHolder ?actor .
    FILTER (!?shipmentBound || EXISTS {
        ?context tg:assessmentShipment ?shipment .
        ?evidence tg:documentShipment ?shipment .
    })
}""" .

:q-rvc-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "rvc-pass" ; rdfs:label "RVC memenuhi ambang PSR"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence (?evidence AS ?supportSubject)
    (<http://www.w3.org/1999/02/22-rdf-syntax-ns#type> AS ?supportPredicate)
    (tg:PumpRvcThresholdMet AS ?supportObject) WHERE {
    ?definition cat:evidenceType ?type .
    ?context tg:assessesProduct ?product ; tg:assessesBatch ?batch ;
        tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    ?evidence tg:documentType ?type ; tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:recordedRvcPercent ?percent ; cd:ruleDerivedType tg:PumpRvcThresholdMet .
    FILTER (DATATYPE(?percent) = xsd:decimal && ?percent >= 0 && ?percent <= 100)
}""" .

:q-rvc-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "rvc-fail" ; rdfs:label "RVC di bawah ambang PSR"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence (?evidence AS ?supportSubject)
    (<http://www.w3.org/1999/02/22-rdf-syntax-ns#type> AS ?supportPredicate)
    (tg:PumpRvcThresholdNotMet AS ?supportObject) WHERE {
    ?definition cat:evidenceType ?type .
    ?context tg:assessesProduct ?product ; tg:assessesBatch ?batch ;
        tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    ?evidence tg:documentType ?type ; tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:recordedRvcPercent ?percent ; cd:ruleDerivedType tg:PumpRvcThresholdNotMet .
    FILTER (DATATYPE(?percent) = xsd:decimal && ?percent >= 0 && ?percent <= 100)
}""" .

:q-ctsh-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "ctsh-pass" ; rdfs:label "Semua input non-originating pada daftar lengkap berganti subpos"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesProduct ?product ; tg:assessesBatch ?batch ;
        tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading/tg:subheadingCode ?targetCode .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    ?evidence tg:documentType tg:atigaBomStatement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:documentComponentList ?bom .
    ?bom tg:componentListForBatch ?batch .
    ?bom tg:componentListClosed true ; tg:componentEntry ?knownEntry .
    ?knownEntry tg:nonOriginatingInput true .
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    FILTER NOT EXISTS {
        ?bom tg:componentEntry ?entry .
        FILTER NOT EXISTS {
            ?entry tg:nonOriginatingInput ?originFlag .
            FILTER (DATATYPE(?originFlag) = xsd:boolean)
            FILTER NOT EXISTS {
                ?entry tg:nonOriginatingInput ?otherFlag . FILTER (?originFlag != ?otherFlag)
            }
            FILTER (?originFlag = false || EXISTS {
                ?entry tg:entryMaterial/tg:classifiedSubheading/tg:subheadingCode ?inputCode .
                FILTER (?inputCode != ?targetCode)
            })
        }
    }
    FILTER NOT EXISTS {
        ?bom tg:componentEntry ?sameEntry .
        ?sameEntry tg:nonOriginatingInput true ; tg:entryMaterial/tg:classifiedSubheading/tg:subheadingCode ?targetCode .
    }
}""" .

:q-ctsh-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "ctsh-fail" ; rdfs:label "Input non-originating tercatat pada subpos produk"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesProduct ?product ; tg:assessesBatch ?batch ;
        tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading/tg:subheadingCode ?targetCode .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    ?evidence tg:documentType tg:atigaBomStatement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:documentComponentList ?bom .
    ?bom tg:componentListForBatch ?batch .
    ?bom tg:componentEntry ?entry .
    ?entry tg:nonOriginatingInput true ; tg:entryMaterial/tg:classifiedSubheading/tg:subheadingCode ?targetCode .
    FILTER NOT EXISTS { ?entry tg:nonOriginatingInput false . }
}""" .

:q-consignment-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "consignment-pass" ; rdfs:label "Jalur langsung atau transit terverifikasi"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:transportRecord ; tg:documentShipment ?shipment .
    ?shipment tg:shipmentRouteClosed true .
    FILTER NOT EXISTS { ?shipment tg:shipmentRouteClosed false . }
    {
        ?shipment a tg:DirectRouteShipment .
        FILTER NOT EXISTS { ?shipment tg:hasTransitStop ?unexpected . }
    } UNION {
        ?shipment a tg:TransitRouteShipment ; tg:hasTransitStop ?knownStop .
        FILTER NOT EXISTS {
            ?shipment tg:hasTransitStop ?stop .
            FILTER NOT EXISTS {
                ?stop tg:transitCountry tg:singapore ; tg:transitJustification ?reason ;
                    tg:enteredTransitCommerce false ; tg:transitPreservationOnly true .
                VALUES ?reason { tg:transportRequirement tg:geographicNecessity }
            }
        }
    }
}""" .

:q-consignment-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "consignment-fail" ; rdfs:label "Transit dengan tindakan yang bertentangan dengan syarat"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:transportRecord ; tg:documentShipment ?shipment .
    ?shipment a tg:TransitRouteShipment ; tg:hasTransitStop ?stop .
    {
        ?stop tg:enteredTransitCommerce true .
    } UNION {
        ?stop tg:transitPreservationOnly false .
    } UNION {
        ?stop tg:transitJustification tg:otherTransitPurpose .
    }
}""" .

:q-atiga-document a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "atiga-document" ; rdfs:label "SKA atau DAB disampaikan untuk kiriman yang dinilai"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?exportingCountry .
    ?definition cat:evidenceType ?type .
    ?evidence tg:documentType ?type ; tg:documentShipment ?shipment ;
        tg:documentIssuingCountry ?exportingCountry ; tg:submittedForPreference true .
}""" .

:q-temporary-conditions-met a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "temporary-conditions-met" ; rdfs:label "Syarat barang dan bukti rencana ekspor kembali"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesProduct ?product ; tg:assessesRevision ?revision ;
        tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?revision tg:intendedUse tg:exhibitionUse .
    ?product tg:identifiableForReexport true ; tg:consumedInUse false ; tg:essentialChangeInUse false .
    ?evidence tg:documentType tg:reexportPlan ; tg:documentShipment ?shipment .
}""" .

:q-temporary-conditions-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "temporary-conditions-fail" ; rdfs:label "Barang tidak memenuhi syarat fisik impor sementara"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?product WHERE {
    ?context tg:assessesProduct ?product .
    { ?product tg:identifiableForReexport false . } UNION
    { ?product tg:consumedInUse true . } UNION
    { ?product tg:essentialChangeInUse true . }
}""" .

:q-temporary-no-general-controls a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "temporary-no-general-controls" ; rdfs:label "Pengecualian kendali impor umum Pasal 47 ayat 1"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?product WHERE {
    ?context tg:assessesProduct ?product .
    ?product tg:importCategory ?category .
    VALUES ?category { tg:unrestrictedImport tg:restrictedImport }
}""" .

:q-no-supported-outcome a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "no-supported-outcome" ; rdfs:label "Pemenuhan penilaian belum dimodelkan dalam cakupan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?context WHERE {
    FILTER (false)
}""" .

:q-change-use-not-applicable a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "change-use-not-applicable" ; rdfs:label "Tujuan tetap atau penyelesaian domestik"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?revision WHERE {
    ?context tg:assessesRevision ?revision .
    { ?revision tg:intendedUse ?sameUse ; tg:proposedUse ?sameUse . } UNION
    { ?revision tg:requestedSettlement tg:domesticSettlement . }
}""" .

:q-change-use-approved a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "change-use-approved" ; rdfs:label "Persetujuan untuk perubahan tujuan dalam kelompok yang sama"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?definition cat:responsibleRole ?role .
    ?context tg:assessesRevision ?revision .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole ?role ; tg:roleActor ?actor .
    ?definition cat:evidenceType ?type ; cat:shipmentBound ?shipmentBound .
    ?context cd:admittedDocument ?evidence .
    ?evidence tg:documentType ?type ; tg:documentHolder ?actor .
    FILTER (!?shipmentBound || EXISTS {
        ?context tg:assessmentShipment ?shipment .
        ?evidence tg:documentShipment ?shipment .
    })
    ?revision tg:intendedUse ?initial ; tg:proposedUse ?proposed .
    ?initial tg:customsReliefGroup ?group .
    ?proposed tg:customsReliefGroup ?group .
    ?context tg:transactionAt ?start ; tg:assessmentShipment/tg:temporaryUsePermitEnd ?end .
    ?evidence tg:documentProposedUse ?proposed ; tg:documentEventAt ?approved .
    FILTER (?initial != ?proposed && ?approved >= ?start && ?approved < ?end)
}""" .

:q-domestic-not-selected a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "domestic-not-selected" ; rdfs:label "Opsi ekspor kembali yang dipilih secara eksplisit"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?revision WHERE {
    ?context tg:assessesRevision ?revision .
    ?revision tg:requestedSettlement tg:reexportSettlement .
}""" .

:q-domestic-authorized a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "domestic-authorized" ; rdfs:label "Keputusan penyelesaian domestik untuk pertimbangan Pasal 47"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?definition cat:responsibleRole ?role .
    ?context tg:assessesRevision ?revision .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole ?role ; tg:roleActor ?actor .
    ?definition cat:evidenceType ?type ; cat:shipmentBound ?shipmentBound .
    ?context cd:admittedDocument ?evidence .
    ?evidence tg:documentType ?type ; tg:documentHolder ?actor .
    FILTER (!?shipmentBound || EXISTS {
        ?context tg:assessmentShipment ?shipment .
        ?evidence tg:documentShipment ?shipment .
    })
    ?revision tg:requestedSettlement tg:domesticSettlement ; tg:settlementGround ?ground .
    VALUES ?ground { tg:governmentProject tg:centralGovernmentDonation }
    ?evidence tg:documentSettlementGround ?ground .
}""" .

:q-domestic-ordinary-sale a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "domestic-ordinary-sale" ; rdfs:label "Penjualan komersial sebagai satu-satunya dasar yang dinyatakan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?revision WHERE {
    ?context tg:assessesRevision ?revision .
    ?revision tg:requestedSettlement tg:domesticSettlement ;
        tg:settlementGround tg:ordinaryCommercialTransfer ; tg:settlementGroundsClosed true .
    FILTER NOT EXISTS {
        ?revision tg:settlementGround ?other . FILTER (?other != tg:ordinaryCommercialTransfer)
    }
}""" .

:q-reexport-settlement-excepted a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "reexport-settlement-excepted" ; rdfs:label "Penyelesaian tanpa ekspor kembali yang telah disetujui"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesRevision ?revision ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?revision tg:requestedSettlement tg:domesticSettlement ; tg:settlementGround ?ground .
    VALUES ?ground { tg:governmentProject tg:centralGovernmentDonation }
    ?evidence tg:documentType tg:domesticSettlementDecision ; tg:documentShipment ?shipment ;
        tg:documentSettlementGround ?ground ; tg:documentHolder ?actor .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole tg:roleImporter ; tg:roleActor ?actor .
}""" .

:q-notice-timely a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "notice-timely" ; rdfs:label "Pemberitahuan sebelum izin berakhir"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?definition cat:responsibleRole ?role .
    ?context tg:assessesRevision ?revision .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole ?role ; tg:roleActor ?actor .
    ?definition cat:evidenceType ?type ; cat:shipmentBound ?shipmentBound .
    ?context cd:admittedDocument ?evidence .
    ?evidence tg:documentType ?type ; tg:documentHolder ?actor .
    FILTER (!?shipmentBound || EXISTS {
        ?context tg:assessmentShipment ?shipment .
        ?evidence tg:documentShipment ?shipment .
    })
    ?revision tg:requestedSettlement tg:reexportSettlement .
    ?context tg:assessmentShipment ?shipment .
    ?shipment tg:temporaryUsePermitEnd ?deadline .
    ?evidence tg:documentEventAt ?when .
    FILTER (?when < ?deadline)
}""" .

:q-notice-late a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "notice-late" ; rdfs:label "Pemberitahuan pada atau setelah izin berakhir"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?definition cat:responsibleRole ?role .
    ?context tg:assessesRevision ?revision .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole ?role ; tg:roleActor ?actor .
    ?definition cat:evidenceType ?type ; cat:shipmentBound ?shipmentBound .
    ?context cd:admittedDocument ?evidence .
    ?evidence tg:documentType ?type ; tg:documentHolder ?actor .
    FILTER (!?shipmentBound || EXISTS {
        ?context tg:assessmentShipment ?shipment .
        ?evidence tg:documentShipment ?shipment .
    })
    ?revision tg:requestedSettlement tg:reexportSettlement .
    ?context tg:assessmentShipment ?shipment .
    ?shipment tg:temporaryUsePermitEnd ?deadline .
    ?evidence tg:documentEventAt ?when .
    FILTER (?when >= ?deadline)
}""" .

:q-realization-timely a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "realization-timely" ; rdfs:label "Realisasi dalam batas waktu setelah izin"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?definition cat:responsibleRole ?role .
    ?context tg:assessesRevision ?revision .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole ?role ; tg:roleActor ?actor .
    ?definition cat:evidenceType ?type ; cat:shipmentBound ?shipmentBound .
    ?context cd:admittedDocument ?evidence .
    ?evidence tg:documentType ?type ; tg:documentHolder ?actor .
    FILTER (!?shipmentBound || EXISTS {
        ?context tg:assessmentShipment ?shipment .
        ?evidence tg:documentShipment ?shipment .
    })
    ?revision tg:requestedSettlement tg:reexportSettlement .
    ?context tg:assessmentShipment/tg:temporaryUsePermitEnd ?permitEnd .
    ?definition cat:maximumDelay ?delay .
    ?evidence tg:documentEventAt ?when .
    BIND (?permitEnd + STRDT(STR(?delay), xsd:dayTimeDuration) AS ?deadline)
    FILTER (?when <= ?deadline)
}""" .

:q-realization-late a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "realization-late" ; rdfs:label "Realisasi lewat batas setelah izin"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?definition cat:responsibleRole ?role .
    ?context tg:assessesRevision ?revision .
    ?revision tg:revisionRoleAssignment ?assignment .
    ?assignment tg:hasActorRole ?role ; tg:roleActor ?actor .
    ?definition cat:evidenceType ?type ; cat:shipmentBound ?shipmentBound .
    ?context cd:admittedDocument ?evidence .
    ?evidence tg:documentType ?type ; tg:documentHolder ?actor .
    FILTER (!?shipmentBound || EXISTS {
        ?context tg:assessmentShipment ?shipment .
        ?evidence tg:documentShipment ?shipment .
    })
    ?revision tg:requestedSettlement tg:reexportSettlement .
    ?context tg:assessmentShipment/tg:temporaryUsePermitEnd ?permitEnd .
    ?definition cat:maximumDelay ?delay .
    ?evidence tg:documentEventAt ?when .
    BIND (?permitEnd + STRDT(STR(?delay), xsd:dayTimeDuration) AS ?deadline)
    FILTER (?when > ?deadline)
}""" .

