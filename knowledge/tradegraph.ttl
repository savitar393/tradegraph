:productionInputUse a owl:NamedIndividual, :IntendedUse .

[] a owl:AllDifferent ; owl:distinctMembers ( :productionInputUse :commercialResaleUse ) .

:producerImporterId a owl:NamedIndividual, :DocumentType .

:deMinimisValueStatement a owl:NamedIndividual, :DocumentType .

:exhibitionStorageRecord a owl:NamedIndividual, :DocumentType .

:percentUnit a owl:NamedIndividual, :Unit .

:atiga-article-33 a owl:NamedIndividual, :SourceClause ;

    :clauseInDocument :source-atiga-text ; :clauseLocator "Article 33 (De Minimis)" .

:maximumDeMinimisPercent a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:decimal .

:pumpPsrThreshold :maximumDeMinimisPercent 10.00 .

:fobValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range xsd:decimal .

:nonOriginatingMaterialValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range xsd:decimal .

:failedCtcMaterialValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range xsd:decimal .

:valuationCurrency a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range :Currency .

:valuationScopeClosed a owl:DatatypeProperty ; rdfs:domain :Document ; rdfs:range xsd:boolean .

:temporaryUsePermitStart a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Shipment ; rdfs:range xsd:dateTime .

:permitExtended a owl:DatatypeProperty ; rdfs:domain :Shipment ; rdfs:range xsd:boolean .

:exhibitionCount a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Shipment ; rdfs:range xsd:integer .

:customsSupervisedStorage a owl:DatatypeProperty ; rdfs:domain :Document ; rdfs:range xsd:boolean .

catalog:requiredUse a owl:AnnotationProperty .

catalog:alternativeUse a owl:AnnotationProperty .



:policy-importer-api-u catalog:requiredUse :commercialResaleUse ; catalog:alternativeUse :productionInputUse ;
    catalog:exceptionQuery :q-alternative-import-use .

:policy-importer-api-p a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "importer-api-p" ; rdfs:label "Identitas API-P untuk penggunaan produksi sendiri"@id ;
    catalog:coverageScope :scope-pump-import ; catalog:policyKind "OBLIGATION" ; :hasSourceClause :permendag16-import ;
    catalog:responsibleRole :roleImporter ; catalog:evidenceType :producerImporterId ; catalog:shipmentBound false ;
    catalog:requiredUse :productionInputUse ; catalog:alternativeUse :commercialResaleUse ;
    catalog:satisfiedQuery :q-issued-document ; catalog:exceptionQuery :q-alternative-import-use .

:q-alternative-import-use a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "alternative-import-use" ; rdfs:label "Penggunaan tercatat untuk jalur API lainnya"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?revision WHERE {
    ?definition cat:alternativeUse ?other ; cat:requiredUse ?required .
    ?context tg:assessesRevision ?revision .
    ?revision tg:intendedUse ?other .
    FILTER NOT EXISTS { ?revision tg:intendedUse ?required . }
}""" .



:policy-atiga-de-minimis-value a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-de-minimis-value" ; rdfs:label "Batas nilai de minimis untuk input yang gagal CTC"@id ;
    catalog:coverageScope :scope-pump-import ; catalog:policyKind "CRITERION" ; :hasSourceClause :atiga-article-33 ;
    catalog:satisfiedQuery :q-de-minimis-met ; catalog:failedQuery :q-de-minimis-exceeded .

:q-de-minimis-met a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "de-minimis-met" ; rdfs:label "Nilai input gagal CTC dalam batas proporsi"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:deMinimisValueStatement ; tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:documentComponentList ?bom ; tg:valuationScopeClosed true ; tg:valuationCurrency ?currency ;
        tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedValue .
    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true .
    tg:pumpPsrThreshold tg:maximumDeMinimisPercent ?maximum .
    FILTER NOT EXISTS { ?evidence tg:valuationScopeClosed false . }
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    FILTER (isIRI(?currency) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedValue) = xsd:decimal
        && ?fob > 0 && ?failedValue >= 0 && ?failedValue <= ?fob)
    FILTER (?failedValue * 100 <= ?fob * ?maximum)
}""" .

:q-de-minimis-exceeded a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "de-minimis-exceeded" ; rdfs:label "Nilai input gagal CTC melebihi batas proporsi"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:deMinimisValueStatement ; tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:documentComponentList ?bom ; tg:valuationScopeClosed true ; tg:valuationCurrency ?currency ;
        tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedValue .
    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true .
    tg:pumpPsrThreshold tg:maximumDeMinimisPercent ?maximum .
    FILTER NOT EXISTS { ?evidence tg:valuationScopeClosed false . }
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    FILTER (isIRI(?currency) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedValue) = xsd:decimal
        && ?fob > 0 && ?failedValue >= 0 && ?failedValue <= ?fob)
    FILTER (?failedValue * 100 > ?fob * ?maximum)
}""" .



:policy-temporary-exhibition-term a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "temporary-exhibition-term" ; rdfs:label "Jangka waktu dan perpanjangan izin pameran pompa"@id ;
    catalog:coverageScope :scope-pump-exhibition ; catalog:policyKind "CRITERION" ; :hasSourceClause :pmk106-exhibition ;
    catalog:maximumDelay "P1Y" ;
    catalog:satisfiedQuery :q-exhibition-term-valid ; catalog:failedQuery :q-exhibition-term-invalid .

:q-exhibition-term-valid a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-term-valid" ; rdfs:label "Jangka izin tidak diperpanjang dan dalam batas"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:temporaryImportPermit ; tg:documentShipment ?shipment .
    ?shipment tg:temporaryUsePermitStart ?start ; tg:temporaryUsePermitEnd ?end ; tg:permitExtended ?extended .
    ?definition cat:maximumDelay ?maximum .
    BIND (?start + STRDT(STR(?maximum), xsd:yearMonthDuration) AS ?deadline)
    FILTER (BOUND(?deadline) && ?end > ?start && (?end <= ?deadline && ?extended = false))
}""" .

:q-exhibition-term-invalid a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-term-invalid" ; rdfs:label "Jangka izin melebihi batas atau ada perpanjangan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence ?deadline WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:temporaryImportPermit ; tg:documentShipment ?shipment .
    ?shipment tg:temporaryUsePermitStart ?start ; tg:temporaryUsePermitEnd ?end ; tg:permitExtended ?extended .
    ?definition cat:maximumDelay ?maximum .
    BIND (?start + STRDT(STR(?maximum), xsd:yearMonthDuration) AS ?deadline)
    FILTER (BOUND(?deadline) && ?end > ?start && (?end > ?deadline || ?extended = true))
}""" .



:policy-temporary-interval-storage a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "temporary-interval-storage" ; rdfs:label "Tempat khusus dan pengawasan antar pameran"@id ;
    catalog:coverageScope :scope-pump-exhibition ; catalog:policyKind "OBLIGATION" ; :hasSourceClause :pmk106-exhibition ;
    catalog:responsibleRole :roleImporter ;
    catalog:satisfiedQuery :q-exhibition-storage-met ; catalog:failedQuery :q-exhibition-storage-failed ;
    catalog:exceptionQuery :q-one-exhibition .

:q-exhibition-storage-met a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-storage-met" ; rdfs:label "Bukti penyimpanan khusus dengan pengawasan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:exhibitionCount ?count .
    ?evidence tg:documentType tg:exhibitionStorageRecord ; tg:documentShipment ?shipment ;
       tg:customsSupervisedStorage true .
    FILTER (?count > 1)
}""" .

:q-exhibition-storage-failed a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "exhibition-storage-failed" ; rdfs:label "Bukti penyimpanan yang tidak memenuhi kondisi"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:exhibitionCount ?count .
    ?evidence tg:documentType tg:exhibitionStorageRecord ; tg:documentShipment ?shipment ;
       tg:customsSupervisedStorage false .
    FILTER (?count > 1)
}""" .

:q-one-exhibition a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "one-exhibition" ; rdfs:label "Satu pameran tanpa jeda antar pameran"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cat: <urn:tradegraph:catalog#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?shipment WHERE {
    ?context tg:assessmentShipment ?shipment .
    ?shipment tg:exhibitionCount 1 .
}""" .



:calc-atiga-rvc-indirect a owl:NamedIndividual, catalog:CalculationDefinition ;
    catalog:id "atiga-rvc-indirect" ; rdfs:label "Kandungan nilai regional dengan metode tidak langsung"@id ;
    :hasSourceClause :atiga-article-29 ;
    catalog:typedParameters (
        [ catalog:name "worksheet" ; catalog:valueType catalog:IRI ]
        [ catalog:name "batch" ; catalog:valueType catalog:IRI ; catalog:fromContext "batch" ]
    ) ;
    catalog:scopeParameter "worksheet" ;
    catalog:closureSparql """PREFIX tg: <urn:tradegraph:kb#>
ASK {
    ?worksheet a tg:Document ; tg:documentBatch ?batch ; tg:valuationScopeClosed true .
    FILTER NOT EXISTS { ?worksheet tg:valuationScopeClosed false . }
    FILTER NOT EXISTS { ?worksheet tg:documentBatch ?other . FILTER (?other != ?batch) }
}""" ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (((?fob - ?vnm) * 100 / ?fob) AS ?value) (tg:percentUnit AS ?unit) WHERE {
    ?worksheet tg:fobValue ?fob ; tg:nonOriginatingMaterialValue ?vnm ; tg:valuationCurrency ?inputCurrency .
    FILTER (isIRI(?inputCurrency) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?vnm) = xsd:decimal
        && ?fob > 0 && ?vnm >= 0 && ?vnm <= ?fob)
}""" .

# Generalized 4-level HS hierarchy and declarative Product Specific Rule (PSR) vocabulary (0.6.0)

:HSChapter a owl:Class .
:HSHeading a owl:Class .
:ProductSpecificRule a owl:Class .
:OriginRuleAlternative a owl:Class .
:OriginCriterionKind a owl:Class .
:GenericPsrCoverageDeclaration a owl:Class ; rdfs:subClassOf :CoverageDeclaration .

:chapterCode a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :HSChapter ; rdfs:range xsd:string .
:headingCode a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :HSHeading ; rdfs:range xsd:string .
:subheadingHeading a owl:ObjectProperty ;
    rdfs:domain :HSSubheading ; rdfs:range :HSHeading .
:headingChapter a owl:ObjectProperty ;
    rdfs:domain :HSHeading ; rdfs:range :HSChapter .

:classifiedHeading a owl:ObjectProperty ;
    rdfs:domain :TradeGood ; rdfs:range :HSHeading ;
    owl:propertyChainAxiom ( :classifiedSubheading :subheadingHeading ) .
:classifiedChapter a owl:ObjectProperty ;
    rdfs:domain :TradeGood ; rdfs:range :HSChapter ;
    owl:propertyChainAxiom ( :classifiedHeading :headingChapter ) .

:psrAgreement a owl:ObjectProperty ;
    rdfs:domain :ProductSpecificRule ; rdfs:range :TradeAgreement .
:psrForSubheading a owl:ObjectProperty ;
    rdfs:domain :ProductSpecificRule ; rdfs:range :HSSubheading .
:hasPsrAlternative a owl:ObjectProperty ;
    rdfs:domain :ProductSpecificRule ; rdfs:range :OriginRuleAlternative .
:requiresCriterionKind a owl:ObjectProperty ;
    rdfs:domain :OriginRuleAlternative ; rdfs:range :OriginCriterionKind .
:alternativeRvcThreshold a owl:ObjectProperty ;
    rdfs:domain :OriginRuleAlternative ; rdfs:range :OriginThreshold .
:excludesChapter a owl:ObjectProperty ;
    rdfs:domain :OriginRuleAlternative ; rdfs:range :HSChapter .
:excludesHeading a owl:ObjectProperty ;
    rdfs:domain :OriginRuleAlternative ; rdfs:range :HSHeading .
:excludesSubheading a owl:ObjectProperty ;
    rdfs:domain :OriginRuleAlternative ; rdfs:range :HSSubheading .
:conciseRuleText a owl:DatatypeProperty ;
    rdfs:domain :ProductSpecificRule ; rdfs:range xsd:string .

:whollyObtainedStatement a owl:NamedIndividual, :DocumentType .
:processRuleStatement a owl:NamedIndividual, :DocumentType .
:whollyObtainedConfirmed a owl:DatatypeProperty ;
    rdfs:domain :Document ; rdfs:range xsd:boolean .
:processRuleSatisfied a owl:DatatypeProperty ;
    rdfs:domain :Document ; rdfs:range xsd:boolean .
:satisfiedProcessKind a owl:ObjectProperty ;
    rdfs:domain :Document ; rdfs:range :OriginCriterionKind .

:criterionWO a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Wholly Obtained (WO)" .
:criterionRVC a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Regional Value Content (RVC)" .
:criterionCC a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Change in Chapter (CC)" .
:criterionCTH a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Change in Tariff Heading (CTH)" .
:criterionCTSH a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Change in Tariff Subheading (CTSH)" .
:criterionTextileProcess a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Textile Process Rule" .
:criterionCutAndSewnAMS a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Cut and Sewn in any AMS" .
:criterionRefiningProcess a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Refining Process Rule" .
:criterionChemicalReaction a owl:NamedIndividual, :OriginCriterionKind ; rdfs:label "Chemical Reaction Rule" .
[] a owl:AllDifferent ;
    owl:distinctMembers (
        :criterionWO :criterionRVC :criterionCC :criterionCTH :criterionCTSH
        :criterionTextileProcess :criterionCutAndSewnAMS :criterionRefiningProcess
        :criterionChemicalReaction
    ) .

:hs2-84 a owl:NamedIndividual, :HSChapter ; :chapterCode "84" .
:hs2-09 a owl:NamedIndividual, :HSChapter ; :chapterCode "09" .
:hs4-8413 a owl:NamedIndividual, :HSHeading ; :headingCode "8413" ; :headingChapter :hs2-84 .
:hs4-0901 a owl:NamedIndividual, :HSHeading ; :headingCode "0901" ; :headingChapter :hs2-09 .
:hs6-841370 :subheadingHeading :hs4-8413 .
:hs6-841391 :subheadingHeading :hs4-8413 .
:hs6-090121 :subheadingHeading :hs4-0901 .

:atiga-article-26 a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-atiga-text ;
    :clauseLocator "Article 26–30 (Origin Criteria)" .
:atiga-psr-annex3 a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-atiga-psr22 ;
    :clauseLocator "Annex 3 HS 2022 (Product Specific Rules)" .

:scope-atiga-psr-generic a owl:NamedIndividual, :CoverageDeclaration, :GenericPsrCoverageDeclaration ;
    rdfs:label "Penilaian kriteria asal ATIGA berbasis tabel PSR untuk subpos HS yang dimodelkan"@id ;
    :hasCoverageStatus :coveragePartial ;
    :coverageJurisdiction :jurisdictionIndonesiaCustoms ;
    :coverageAgreement :atiga ;
    :coverageProcedure :importForUse ;
    :coverageDestinationCountry :indonesia ;
    :coverageWindow :review-atiga-psr-generic ;
    :hasSourceClause :atiga-article-26, :atiga-psr-annex3, :pmk131-article-5, :pmk35-submission .

:review-atiga-psr-generic a owl:NamedIndividual, :ReviewWindow ;
    :windowJurisdiction :jurisdictionIndonesiaCustoms ;
    :windowFrom "2023-04-01T00:00:00+07:00"^^xsd:dateTime ;
    :windowUntil "2027-01-01T00:00:00+07:00"^^xsd:dateTime .

# Generic ATIGA PSR policies driven purely by :ProductSpecificRule triples in the KB.

:policy-atiga-psr-wo a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-psr-wo" ; rdfs:label "Kriteria Wholly Obtained (WO) berdasarkan PSR subpos HS"@id ;
    catalog:coverageScope :scope-atiga-psr-generic ; catalog:policyKind "CRITERION" ;
    :hasSourceClause :atiga-article-26, :atiga-psr-annex3 ;
    catalog:satisfiedQuery :q-psr-wo-pass ; catalog:failedQuery :q-psr-wo-fail ;
    catalog:exceptionQuery :q-psr-no-wo .

:policy-atiga-psr-rvc a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-psr-rvc" ; rdfs:label "Kriteria Regional Value Content (RVC) berdasarkan PSR subpos HS"@id ;
    catalog:coverageScope :scope-atiga-psr-generic ; catalog:policyKind "CRITERION" ;
    :hasSourceClause :atiga-article-29, :atiga-psr-annex3 ;
    catalog:satisfiedQuery :q-psr-rvc-pass ; catalog:failedQuery :q-psr-rvc-fail ;
    catalog:exceptionQuery :q-psr-no-rvc .

:policy-atiga-psr-ctc a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-psr-ctc" ; rdfs:label "Kriteria Perubahan Klasifikasi Tarif (CC/CTH/CTSH & pengecualian) berdasarkan PSR"@id ;
    catalog:coverageScope :scope-atiga-psr-generic ; catalog:policyKind "CRITERION" ;
    :hasSourceClause :atiga-article-26, :atiga-psr-annex3 ;
    catalog:satisfiedQuery :q-psr-ctc-pass ; catalog:failedQuery :q-psr-ctc-fail ;
    catalog:exceptionQuery :q-psr-no-ctc .

:policy-atiga-psr-process a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-psr-process" ; rdfs:label "Kriteria Proses Spesifik (Tekstil / Reaksi Kimia) berdasarkan PSR subpos HS"@id ;
    catalog:coverageScope :scope-atiga-psr-generic ; catalog:policyKind "CRITERION" ;
    :hasSourceClause :atiga-article-26, :atiga-psr-annex3 ;
    catalog:satisfiedQuery :q-psr-process-pass ; catalog:failedQuery :q-psr-process-fail ;
    catalog:exceptionQuery :q-psr-no-process .

:policy-atiga-psr-overall a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-psr-overall" ; rdfs:label "Pemenuhan gabungan alternatif kriteria asal PSR ATIGA"@id ;
    catalog:coverageScope :scope-atiga-psr-generic ; catalog:policyKind "CRITERION" ;
    :hasSourceClause :atiga-article-26, :atiga-psr-annex3 ;
    catalog:satisfiedQuery :q-psr-overall-pass ; catalog:failedQuery :q-psr-overall-fail .

:policy-atiga-psr-consignment a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-psr-consignment" ; rdfs:label "Kriteria pengiriman langsung dan transit ATIGA"@id ;
    catalog:coverageScope :scope-atiga-psr-generic ; catalog:policyKind "CRITERION" ;
    :hasSourceClause :atiga-article-32, :pmk131-article-5 ;
    catalog:satisfiedQuery :q-fta-consignment-pass ; catalog:failedQuery :q-consignment-fail .

:policy-atiga-psr-origin-evidence a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "atiga-psr-origin-evidence" ; rdfs:label "Penyerahan SKA Form D, e-Form D, atau DAB ATIGA"@id ;
    catalog:coverageScope :scope-atiga-psr-generic ; catalog:policyKind "OBLIGATION" ;
    :hasSourceClause :pmk35-submission, :pmk81-origin-evidence ;
    catalog:responsibleRole :roleImporter ;
    catalog:evidenceType :atigaFormD, :atigaElectronicFormD, :atigaOriginDeclaration ;
    catalog:satisfiedQuery :q-fta-origin-evidence .

:q-fta-consignment-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "fta-consignment-pass" ; rdfs:label "Jalur langsung atau transit terverifikasi untuk perjanjian dagang"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:transportRecord ; tg:documentShipment ?shipment .
    ?shipment tg:shipmentRouteClosed true .
    FILTER NOT EXISTS { ?shipment tg:shipmentRouteClosed false . }
    {
        ?shipment a tg:DirectRouteShipment .
        FILTER NOT EXISTS { ?shipment tg:hasTransitStop ?unexpected . }
    } UNION {
        ?shipment a tg:TransitRouteShipment ; tg:hasTransitStop ?knownStop .
        FILTER NOT EXISTS {
            ?shipment tg:hasTransitStop ?stop .
            FILTER NOT EXISTS {
                ?stop tg:transitCountry ?tc ; tg:transitJustification ?reason ;
                    tg:enteredTransitCommerce false ; tg:transitPreservationOnly true .
                VALUES ?reason { tg:transportRequirement tg:geographicNecessity }
            }
        }
    }
}""" .

:q-fta-origin-evidence a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "fta-origin-evidence" ; rdfs:label "Bukti asal barang sesuai perjanjian dagang yang dipilih"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?exportingCountry .
    ?agreement tg:agreementOriginDocumentType ?type .
    ?evidence tg:documentType ?type ; tg:documentShipment ?shipment ;
        tg:documentIssuingCountry ?exportingCountry ; tg:submittedForPreference true .
}""" .

:q-psr-no-wo a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-no-wo" ; rdfs:label "PSR yang berlaku tidak mencantumkan alternatif WO"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?psr WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product .
    ?product tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    FILTER NOT EXISTS { ?psr tg:hasPsrAlternative/tg:requiresCriterionKind tg:criterionWO . }
}""" .

:q-psr-wo-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-wo-pass" ; rdfs:label "Pernyataan Wholly Obtained terverifikasi memenuhi PSR"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative/tg:requiresCriterionKind tg:criterionWO .
    ?evidence tg:documentType tg:whollyObtainedStatement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:whollyObtainedConfirmed true .
    FILTER NOT EXISTS { ?evidence tg:whollyObtainedConfirmed false . }
}""" .

:q-psr-wo-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-wo-fail" ; rdfs:label "Pernyataan Wholly Obtained tidak terpenuhi"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative/tg:requiresCriterionKind tg:criterionWO .
    ?evidence tg:documentType tg:whollyObtainedStatement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:whollyObtainedConfirmed false .
    FILTER NOT EXISTS { ?evidence tg:whollyObtainedConfirmed true . }
}""" .

:q-psr-no-rvc a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-no-rvc" ; rdfs:label "PSR yang berlaku tidak mencantumkan alternatif RVC"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?psr WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product .
    ?product tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    FILTER NOT EXISTS { ?psr tg:hasPsrAlternative/tg:requiresCriterionKind tg:criterionRVC . }
}""" .

:q-psr-rvc-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-rvc-pass" ; rdfs:label "Nilai RVC memenuhi ambang minimum PSR"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative ?alt .
    ?alt tg:requiresCriterionKind tg:criterionRVC ;
        tg:alternativeRvcThreshold/tg:minimumRvcPercent ?minimum .
    ?evidence tg:documentType tg:rvcWorksheet ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:recordedRvcPercent ?percent .
    FILTER (DATATYPE(?percent) = xsd:decimal && DATATYPE(?minimum) = xsd:decimal
        && ?percent >= ?minimum && ?percent <= 100)
}""" .

:q-psr-rvc-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-rvc-fail" ; rdfs:label "Nilai RVC di bawah ambang minimum PSR"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative ?alt .
    ?alt tg:requiresCriterionKind tg:criterionRVC ;
        tg:alternativeRvcThreshold/tg:minimumRvcPercent ?minimum .
    ?evidence tg:documentType tg:rvcWorksheet ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:recordedRvcPercent ?percent .
    FILTER (DATATYPE(?percent) = xsd:decimal && DATATYPE(?minimum) = xsd:decimal
        && ?percent >= 0 && ?percent < ?minimum)
    FILTER NOT EXISTS {
        ?psr tg:hasPsrAlternative ?otherAlt .
        ?otherAlt tg:requiresCriterionKind tg:criterionRVC ;
            tg:alternativeRvcThreshold/tg:minimumRvcPercent ?otherMin .
        FILTER (?percent >= ?otherMin)
    }
}""" .

:q-psr-no-ctc a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-no-ctc" ; rdfs:label "PSR yang berlaku tidak mencantumkan alternatif CC, CTH, atau CTSH"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?psr WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product .
    ?product tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    FILTER NOT EXISTS {
        ?psr tg:hasPsrAlternative/tg:requiresCriterionKind ?kind .
        VALUES ?kind { tg:criterionCC tg:criterionCTH tg:criterionCTSH }
    }
}""" .

:q-psr-ctc-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-ctc-pass" ; rdfs:label "Semua input non-originating efektif memenuhi CTC, kumulasi, atau de minimis tanpa proses minimal"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?targetChap tg:chapterCode ?targetChapCode .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    FILTER NOT EXISTS {
        ?context cd:admittedDocument ?procEv .
        ?procEv tg:documentType tg:productionProcessStatement ;
            tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
            tg:processScopeClosed true ; tg:performedOperation ?anyOp .
        FILTER NOT EXISTS { ?procEv tg:processScopeClosed false . }
        FILTER NOT EXISTS {
            ?procEv tg:performedOperation ?op .
            FILTER NOT EXISTS { ?agreement tg:disqualifyingOperation ?op . }
        }
    }
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative ?alt .
    ?alt tg:requiresCriterionKind ?ctcKind .
    VALUES ?ctcKind { tg:criterionCC tg:criterionCTH tg:criterionCTSH }
    ?evidence tg:documentType ?bomType ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:documentComponentList ?bom .
    FILTER (?bomType = tg:atigaBomStatement || ?bomType = tg:bomStatement)
    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true ; tg:componentEntry ?knownEntry .
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    FILTER (
        NOT EXISTS {
            ?bom tg:componentEntry ?entry .
            FILTER NOT EXISTS {
                ?entry tg:nonOriginatingInput ?originFlag .
                FILTER (DATATYPE(?originFlag) = xsd:boolean)
                FILTER NOT EXISTS { ?entry tg:nonOriginatingInput ?otherFlag . FILTER (?originFlag != ?otherFlag) }
                FILTER (
                    ?originFlag = false ||
                    EXISTS {
                        ?entry tg:materialOriginCountry ?origCountry ;
                            tg:materialOriginProofVerified true .
                        ?agreement tg:agreementParty ?origCountry .
                        FILTER NOT EXISTS { ?entry tg:materialOriginProofVerified false . }
                    } ||
                    (
                        (
                            (?ctcKind = tg:criterionCC && EXISTS {
                                ?entry tg:entryMaterial/tg:classifiedChapter ?mChap . FILTER (?mChap != ?targetChap)
                            }) ||
                            (?ctcKind = tg:criterionCTH && EXISTS {
                                ?entry tg:entryMaterial/tg:classifiedHeading ?mHead . FILTER (?mHead != ?targetHead)
                            }) ||
                            (?ctcKind = tg:criterionCTSH && EXISTS {
                                ?entry tg:entryMaterial/tg:classifiedSubheading ?mSub . FILTER (?mSub != ?targetSub)
                            })
                        )
                        && NOT EXISTS { ?alt tg:excludesChapter ?exC . ?entry tg:entryMaterial/tg:classifiedChapter ?exC . }
                        && NOT EXISTS { ?alt tg:excludesHeading ?exH . ?entry tg:entryMaterial/tg:classifiedHeading ?exH . }
                        && NOT EXISTS { ?alt tg:excludesSubheading ?exS . ?entry tg:entryMaterial/tg:classifiedSubheading ?exS . }
                    )
                )
            }
        } ||
        EXISTS {
            ?context cd:admittedDocument ?dmEv .
            ?dmEv tg:documentType tg:deMinimisValueStatement ;
                tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
                tg:documentComponentList ?bom .
            ?agreement tg:hasDeMinimisBand ?band .
            ?band tg:deMinimisBasis ?basis ; tg:deMinimisChapterMin ?cMin ;
                tg:deMinimisChapterMax ?cMax ; tg:deMinimisMaxPercent ?maxPct .
            FILTER (?targetChapCode >= ?cMin && ?targetChapCode <= ?cMax)
            FILTER (
                (?basis = tg:basisFobValue && EXISTS {
                    ?dmEv tg:valuationScopeClosed true ; tg:valuationCurrency ?curr ;
                        tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedVal .
                    FILTER NOT EXISTS { ?dmEv tg:valuationScopeClosed false . }
                    FILTER (isIRI(?curr) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedVal) = xsd:decimal
                        && ?fob > 0 && ?failedVal >= 0 && ?failedVal <= ?fob
                        && ?failedVal * 100 <= ?fob * ?maxPct)
                }) ||
                (?basis = tg:basisProductWeight && EXISTS {
                    ?dmEv tg:weightScopeClosed true ;
                        tg:totalProductWeight ?totalWt ; tg:failedCtcMaterialWeight ?failedWt .
                    FILTER NOT EXISTS { ?dmEv tg:weightScopeClosed false . }
                    FILTER (DATATYPE(?totalWt) = xsd:decimal && DATATYPE(?failedWt) = xsd:decimal
                        && ?totalWt > 0 && ?failedWt >= 0 && ?failedWt <= ?totalWt
                        && ?failedWt * 100 <= ?totalWt * ?maxPct)
                })
            )
        }
    )
}""" .

:q-psr-ctc-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-ctc-fail" ; rdfs:label "Input non-originating melanggar syarat CTC/pengecualian (tanpa penyelamatan kumulasi/de minimis) atau hanya proses minimal"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?targetChap tg:chapterCode ?targetChapCode .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative ?someAlt .
    ?someAlt tg:requiresCriterionKind ?someKind .
    VALUES ?someKind { tg:criterionCC tg:criterionCTH tg:criterionCTSH }
    ?evidence tg:documentBatch ?batch ; tg:documentShipment ?shipment .
    FILTER (
        (EXISTS {
            ?evidence tg:documentType tg:productionProcessStatement ;
                tg:processScopeClosed true ; tg:performedOperation ?anyOp .
            FILTER NOT EXISTS { ?evidence tg:processScopeClosed false . }
            FILTER NOT EXISTS {
                ?evidence tg:performedOperation ?op .
                FILTER NOT EXISTS { ?agreement tg:disqualifyingOperation ?op . }
            }
        }) ||
        (EXISTS {
            ?evidence tg:documentType ?bomType ; tg:documentComponentList ?bom .
            FILTER (?bomType = tg:atigaBomStatement || ?bomType = tg:bomStatement)
            ?bom tg:componentListForBatch ?batch .
            FILTER NOT EXISTS {
                ?psr tg:hasPsrAlternative ?alt .
                ?alt tg:requiresCriterionKind ?ctcKind .
                VALUES ?ctcKind { tg:criterionCC tg:criterionCTH tg:criterionCTSH }
                FILTER NOT EXISTS {
                    ?bom tg:componentEntry ?entry .
                    ?entry tg:nonOriginatingInput true ; tg:entryMaterial ?mat .
                    FILTER NOT EXISTS { ?entry tg:nonOriginatingInput false . }
                    FILTER NOT EXISTS {
                        ?entry tg:materialOriginCountry ?origCountry ;
                            tg:materialOriginProofVerified true .
                        ?agreement tg:agreementParty ?origCountry .
                        FILTER NOT EXISTS { ?entry tg:materialOriginProofVerified false . }
                    }
                    FILTER (
                        (?ctcKind = tg:criterionCC && EXISTS { ?mat tg:classifiedChapter ?targetChap . }) ||
                        (?ctcKind = tg:criterionCTH && EXISTS { ?mat tg:classifiedHeading ?targetHead . }) ||
                        (?ctcKind = tg:criterionCTSH && EXISTS { ?mat tg:classifiedSubheading ?targetSub . }) ||
                        EXISTS { ?alt tg:excludesChapter ?exC . ?mat tg:classifiedChapter ?exC . } ||
                        EXISTS { ?alt tg:excludesHeading ?exH . ?mat tg:classifiedHeading ?exH . } ||
                        EXISTS { ?alt tg:excludesSubheading ?exS . ?mat tg:classifiedSubheading ?exS . }
                    )
                }
            }
            FILTER NOT EXISTS {
                ?bom tg:componentListClosed true .
                FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
                ?context cd:admittedDocument ?dmEv .
                ?dmEv tg:documentType tg:deMinimisValueStatement ;
                    tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
                    tg:documentComponentList ?bom .
                ?agreement tg:hasDeMinimisBand ?band .
                ?band tg:deMinimisBasis ?basis ; tg:deMinimisChapterMin ?cMin ;
                    tg:deMinimisChapterMax ?cMax ; tg:deMinimisMaxPercent ?maxPct .
                FILTER (?targetChapCode >= ?cMin && ?targetChapCode <= ?cMax)
                FILTER (
                    (?basis = tg:basisFobValue && EXISTS {
                        ?dmEv tg:valuationScopeClosed true ; tg:valuationCurrency ?curr ;
                            tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedVal .
                        FILTER NOT EXISTS { ?dmEv tg:valuationScopeClosed false . }
                        FILTER (isIRI(?curr) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedVal) = xsd:decimal
                            && ?fob > 0 && ?failedVal >= 0 && ?failedVal <= ?fob
                            && ?failedVal * 100 <= ?fob * ?maxPct)
                    }) ||
                    (?basis = tg:basisProductWeight && EXISTS {
                        ?dmEv tg:weightScopeClosed true ;
                            tg:totalProductWeight ?totalWt ; tg:failedCtcMaterialWeight ?failedWt .
                        FILTER NOT EXISTS { ?dmEv tg:weightScopeClosed false . }
                        FILTER (DATATYPE(?totalWt) = xsd:decimal && DATATYPE(?failedWt) = xsd:decimal
                            && ?totalWt > 0 && ?failedWt >= 0 && ?failedWt <= ?totalWt
                            && ?failedWt * 100 <= ?totalWt * ?maxPct)
                    })
                )
            }
        })
    )
}""" .

:q-psr-no-process a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-no-process" ; rdfs:label "PSR yang berlaku tidak mencantumkan aturan proses spesifik"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?psr WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product .
    ?product tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    FILTER NOT EXISTS {
        ?psr tg:hasPsrAlternative/tg:requiresCriterionKind ?kind .
        VALUES ?kind { tg:criterionTextileProcess tg:criterionCutAndSewnAMS tg:criterionRefiningProcess tg:criterionChemicalReaction }
    }
}""" .

:q-psr-process-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-process-pass" ; rdfs:label "Bukti proses spesifik yang dipersyaratkan PSR terpenuhi"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    FILTER NOT EXISTS {
        ?context cd:admittedDocument ?procEv .
        ?procEv tg:documentType tg:productionProcessStatement ;
            tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
            tg:processScopeClosed true ; tg:performedOperation ?anyOp .
        FILTER NOT EXISTS { ?procEv tg:processScopeClosed false . }
        FILTER NOT EXISTS {
            ?procEv tg:performedOperation ?op .
            FILTER NOT EXISTS { ?agreement tg:disqualifyingOperation ?op . }
        }
    }
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative/tg:requiresCriterionKind ?kind .
    VALUES ?kind { tg:criterionTextileProcess tg:criterionCutAndSewnAMS tg:criterionRefiningProcess tg:criterionChemicalReaction }
    ?evidence tg:documentType tg:processRuleStatement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:satisfiedProcessKind ?kind ; tg:processRuleSatisfied true .
    FILTER NOT EXISTS { ?evidence tg:processRuleSatisfied false . }
}""" .

:q-psr-process-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-process-fail" ; rdfs:label "Bukti proses spesifik yang dipersyaratkan PSR tidak terpenuhi"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative/tg:requiresCriterionKind ?kind .
    VALUES ?kind { tg:criterionTextileProcess tg:criterionCutAndSewnAMS tg:criterionRefiningProcess tg:criterionChemicalReaction }
    ?evidence tg:documentType tg:processRuleStatement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:satisfiedProcessKind ?kind ; tg:processRuleSatisfied false .
    FILTER NOT EXISTS { ?evidence tg:processRuleSatisfied true . }
}""" .

:q-psr-overall-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-overall-pass" ; rdfs:label "Minimal satu alternatif lengkap pada PSR terpenuhi (termasuk kumulasi & de minimis, bebas proses minimal)"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?alt WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?targetChap tg:chapterCode ?targetChapCode .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    FILTER NOT EXISTS {
        ?context cd:admittedDocument ?procEv .
        ?procEv tg:documentType tg:productionProcessStatement ;
            tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
            tg:processScopeClosed true ; tg:performedOperation ?anyOp .
        FILTER NOT EXISTS { ?procEv tg:processScopeClosed false . }
        FILTER NOT EXISTS {
            ?procEv tg:performedOperation ?op .
            FILTER NOT EXISTS { ?agreement tg:disqualifyingOperation ?op . }
        }
    }
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative ?alt .
    ?alt tg:requiresCriterionKind ?anyKind .
    FILTER NOT EXISTS {
        ?alt tg:requiresCriterionKind ?reqKind .
        FILTER NOT EXISTS {
            ?context cd:admittedDocument ?ev .
            ?ev tg:documentBatch ?batch ; tg:documentShipment ?shipment .
            FILTER (
                (?reqKind = tg:criterionWO && EXISTS {
                    ?ev tg:documentType tg:whollyObtainedStatement ; tg:whollyObtainedConfirmed true .
                    FILTER NOT EXISTS { ?ev tg:whollyObtainedConfirmed false . }
                }) ||
                (?reqKind = tg:criterionRVC && EXISTS {
                    ?alt tg:alternativeRvcThreshold/tg:minimumRvcPercent ?min .
                    ?ev tg:documentType tg:rvcWorksheet ; tg:recordedRvcPercent ?pct .
                    FILTER (DATATYPE(?pct) = xsd:decimal && DATATYPE(?min) = xsd:decimal && ?pct >= ?min && ?pct <= 100)
                }) ||
                ((?reqKind = tg:criterionCC || ?reqKind = tg:criterionCTH || ?reqKind = tg:criterionCTSH) && EXISTS {
                    ?ev tg:documentType ?bomType ; tg:documentComponentList ?bom .
                    FILTER (?bomType = tg:atigaBomStatement || ?bomType = tg:bomStatement)
                    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true ; tg:componentEntry ?knownEntry .
                    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
                    FILTER (
                        NOT EXISTS {
                            ?bom tg:componentEntry ?entry .
                            FILTER NOT EXISTS {
                                ?entry tg:nonOriginatingInput ?flag .
                                FILTER (DATATYPE(?flag) = xsd:boolean)
                                FILTER NOT EXISTS { ?entry tg:nonOriginatingInput ?other . FILTER (?flag != ?other) }
                                FILTER (
                                    ?flag = false ||
                                    EXISTS {
                                        ?entry tg:materialOriginCountry ?origCountry ;
                                            tg:materialOriginProofVerified true .
                                        ?agreement tg:agreementParty ?origCountry .
                                        FILTER NOT EXISTS { ?entry tg:materialOriginProofVerified false . }
                                    } ||
                                    (
                                        (
                                            (?reqKind = tg:criterionCC && EXISTS { ?entry tg:entryMaterial/tg:classifiedChapter ?mc . FILTER (?mc != ?targetChap) }) ||
                                            (?reqKind = tg:criterionCTH && EXISTS { ?entry tg:entryMaterial/tg:classifiedHeading ?mh . FILTER (?mh != ?targetHead) }) ||
                                            (?reqKind = tg:criterionCTSH && EXISTS { ?entry tg:entryMaterial/tg:classifiedSubheading ?ms . FILTER (?ms != ?targetSub) })
                                        )
                                        && NOT EXISTS { ?alt tg:excludesChapter ?exc . ?entry tg:entryMaterial/tg:classifiedChapter ?exc . }
                                        && NOT EXISTS { ?alt tg:excludesHeading ?exh . ?entry tg:entryMaterial/tg:classifiedHeading ?exh . }
                                        && NOT EXISTS { ?alt tg:excludesSubheading ?exs . ?entry tg:entryMaterial/tg:classifiedSubheading ?exs . }
                                    )
                                )
                            }
                        } ||
                        EXISTS {
                            ?context cd:admittedDocument ?dmEv .
                            ?dmEv tg:documentType tg:deMinimisValueStatement ;
                                tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
                                tg:documentComponentList ?bom .
                            ?agreement tg:hasDeMinimisBand ?band .
                            ?band tg:deMinimisBasis ?basis ; tg:deMinimisChapterMin ?cMin ;
                                tg:deMinimisChapterMax ?cMax ; tg:deMinimisMaxPercent ?maxPct .
                            FILTER (?targetChapCode >= ?cMin && ?targetChapCode <= ?cMax)
                            FILTER (
                                (?basis = tg:basisFobValue && EXISTS {
                                    ?dmEv tg:valuationScopeClosed true ; tg:valuationCurrency ?curr ;
                                        tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedVal .
                                    FILTER NOT EXISTS { ?dmEv tg:valuationScopeClosed false . }
                                    FILTER (isIRI(?curr) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedVal) = xsd:decimal
                                        && ?fob > 0 && ?failedVal >= 0 && ?failedVal <= ?fob
                                        && ?failedVal * 100 <= ?fob * ?maxPct)
                                }) ||
                                (?basis = tg:basisProductWeight && EXISTS {
                                    ?dmEv tg:weightScopeClosed true ;
                                        tg:totalProductWeight ?totalWt ; tg:failedCtcMaterialWeight ?failedWt .
                                    FILTER NOT EXISTS { ?dmEv tg:weightScopeClosed false . }
                                    FILTER (DATATYPE(?totalWt) = xsd:decimal && DATATYPE(?failedWt) = xsd:decimal
                                        && ?totalWt > 0 && ?failedWt >= 0 && ?failedWt <= ?totalWt
                                        && ?failedWt * 100 <= ?totalWt * ?maxPct)
                                })
                            )
                        }
                    )
                }) ||
                ((?reqKind = tg:criterionTextileProcess || ?reqKind = tg:criterionCutAndSewnAMS || ?reqKind = tg:criterionRefiningProcess || ?reqKind = tg:criterionChemicalReaction) && EXISTS {
                    ?ev tg:documentType tg:processRuleStatement ; tg:satisfiedProcessKind ?reqKind ; tg:processRuleSatisfied true .
                    FILTER NOT EXISTS { ?ev tg:processRuleSatisfied false . }
                })
            )
        }
    }
}""" .

:q-psr-overall-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-overall-fail" ; rdfs:label "Seluruh alternatif pada PSR terbukti tidak terpenuhi atau tergugurkan oleh proses minimal"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?psr WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?targetChap tg:chapterCode ?targetChapCode .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative ?anyAlt .
    FILTER (
        EXISTS {
            ?context cd:admittedDocument ?procEv .
            ?procEv tg:documentType tg:productionProcessStatement ;
                tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
                tg:processScopeClosed true ; tg:performedOperation ?anyOp .
            FILTER NOT EXISTS { ?procEv tg:processScopeClosed false . }
            FILTER NOT EXISTS {
                ?procEv tg:performedOperation ?op .
                FILTER NOT EXISTS { ?agreement tg:disqualifyingOperation ?op . }
            }
        } ||
        NOT EXISTS {
            ?psr tg:hasPsrAlternative ?alt .
            FILTER NOT EXISTS {
                ?alt tg:requiresCriterionKind ?reqKind .
                ?context cd:admittedDocument ?ev .
                ?ev tg:documentBatch ?batch ; tg:documentShipment ?shipment .
                FILTER (
                    (?reqKind = tg:criterionWO && EXISTS {
                        ?ev tg:documentType tg:whollyObtainedStatement ; tg:whollyObtainedConfirmed false .
                        FILTER NOT EXISTS { ?ev tg:whollyObtainedConfirmed true . }
                    }) ||
                    (?reqKind = tg:criterionRVC && EXISTS {
                        ?alt tg:alternativeRvcThreshold/tg:minimumRvcPercent ?min .
                        ?ev tg:documentType tg:rvcWorksheet ; tg:recordedRvcPercent ?pct .
                        FILTER (DATATYPE(?pct) = xsd:decimal && DATATYPE(?min) = xsd:decimal && ?pct >= 0 && ?pct < ?min)
                    }) ||
                    ((?reqKind = tg:criterionCC || ?reqKind = tg:criterionCTH || ?reqKind = tg:criterionCTSH) && EXISTS {
                        ?ev tg:documentType ?bomType ; tg:documentComponentList ?bom .
                        FILTER (?bomType = tg:atigaBomStatement || ?bomType = tg:bomStatement)
                        ?bom tg:componentListForBatch ?batch ; tg:componentEntry ?entry .
                        ?entry tg:nonOriginatingInput true ; tg:entryMaterial ?mat .
                        FILTER NOT EXISTS { ?entry tg:nonOriginatingInput false . }
                        FILTER NOT EXISTS {
                            ?entry tg:materialOriginCountry ?origCountry ;
                                tg:materialOriginProofVerified true .
                            ?agreement tg:agreementParty ?origCountry .
                            FILTER NOT EXISTS { ?entry tg:materialOriginProofVerified false . }
                        }
                        FILTER (
                            (?reqKind = tg:criterionCC && EXISTS { ?mat tg:classifiedChapter ?targetChap . }) ||
                            (?reqKind = tg:criterionCTH && EXISTS { ?mat tg:classifiedHeading ?targetHead . }) ||
                            (?reqKind = tg:criterionCTSH && EXISTS { ?mat tg:classifiedSubheading ?targetSub . }) ||
                            EXISTS { ?alt tg:excludesChapter ?exc . ?mat tg:classifiedChapter ?exc . } ||
                            EXISTS { ?alt tg:excludesHeading ?exh . ?mat tg:classifiedHeading ?exh . } ||
                            EXISTS { ?alt tg:excludesSubheading ?exs . ?mat tg:classifiedSubheading ?exs . }
                        )
                        FILTER NOT EXISTS {
                            ?bom tg:componentListClosed true .
                            FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
                            ?context cd:admittedDocument ?dmEv .
                            ?dmEv tg:documentType tg:deMinimisValueStatement ;
                                tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
                                tg:documentComponentList ?bom .
                            ?agreement tg:hasDeMinimisBand ?band .
                            ?band tg:deMinimisBasis ?basis ; tg:deMinimisChapterMin ?cMin ;
                                tg:deMinimisChapterMax ?cMax ; tg:deMinimisMaxPercent ?maxPct .
                            FILTER (?targetChapCode >= ?cMin && ?targetChapCode <= ?cMax)
                            FILTER (
                                (?basis = tg:basisFobValue && EXISTS {
                                    ?dmEv tg:valuationScopeClosed true ; tg:valuationCurrency ?curr ;
                                        tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedVal .
                                    FILTER NOT EXISTS { ?dmEv tg:valuationScopeClosed false . }
                                    FILTER (isIRI(?curr) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedVal) = xsd:decimal
                                        && ?fob > 0 && ?failedVal >= 0 && ?failedVal <= ?fob
                                        && ?failedVal * 100 <= ?fob * ?maxPct)
                                }) ||
                                (?basis = tg:basisProductWeight && EXISTS {
                                    ?dmEv tg:weightScopeClosed true ;
                                        tg:totalProductWeight ?totalWt ; tg:failedCtcMaterialWeight ?failedWt .
                                    FILTER NOT EXISTS { ?dmEv tg:weightScopeClosed false . }
                                    FILTER (DATATYPE(?totalWt) = xsd:decimal && DATATYPE(?failedWt) = xsd:decimal
                                        && ?totalWt > 0 && ?failedWt >= 0 && ?failedWt <= ?totalWt
                                        && ?failedWt * 100 <= ?totalWt * ?maxPct)
                                })
                            )
                        }
                    }) ||
                    ((?reqKind = tg:criterionTextileProcess || ?reqKind = tg:criterionCutAndSewnAMS || ?reqKind = tg:criterionRefiningProcess || ?reqKind = tg:criterionChemicalReaction) && EXISTS {
                        ?ev tg:documentType tg:processRuleStatement ; tg:satisfiedProcessKind ?reqKind ; tg:processRuleSatisfied false .
                        FILTER NOT EXISTS { ?ev tg:processRuleSatisfied true . }
                    })
                )
            }
        }
    )
}""" .

# Temporal legal validity and regulation amendment/revocation graph (0.7.0)

:LegalRelationEvent a owl:Class .
:LegalRelationKind a owl:Class .

:relAmends a owl:NamedIndividual, :LegalRelationKind ; rdfs:label "MENGUBAH"@id .
:relRevokes a owl:NamedIndividual, :LegalRelationKind ; rdfs:label "MENCABUT"@id .
:relPartiallyRevokes a owl:NamedIndividual, :LegalRelationKind ; rdfs:label "MENCABUT SEBAGIAN"@id .
:relRelated a owl:NamedIndividual, :LegalRelationKind ; rdfs:label "TERKAIT"@id .
[] a owl:AllDifferent ;
    owl:distinctMembers ( :relAmends :relRevokes :relPartiallyRevokes :relRelated ) .

:regulationNumber a owl:DatatypeProperty ; rdfs:domain :SourceDocument ; rdfs:range xsd:string .
:regulationStatus a owl:DatatypeProperty ; rdfs:domain :SourceDocument ; rdfs:range xsd:string .
:enactedOn a owl:DatatypeProperty ; rdfs:domain :SourceDocument ; rdfs:range xsd:string .
:promulgatedOn a owl:DatatypeProperty ; rdfs:domain :SourceDocument ; rdfs:range xsd:string .
:effectiveFromDate a owl:DatatypeProperty ; rdfs:domain :SourceDocument ; rdfs:range xsd:string .

:modifiesDocument a owl:ObjectProperty ;
    rdfs:domain :SourceDocument ; rdfs:range :SourceDocument .
:amendsDocument a owl:ObjectProperty ;
    rdfs:subPropertyOf :modifiesDocument ;
    rdfs:domain :SourceDocument ; rdfs:range :SourceDocument .
:revokesDocument a owl:ObjectProperty ;
    rdfs:subPropertyOf :modifiesDocument ;
    rdfs:domain :SourceDocument ; rdfs:range :SourceDocument .
:partiallyRevokesDocument a owl:ObjectProperty ;
    rdfs:subPropertyOf :modifiesDocument ;
    rdfs:domain :SourceDocument ; rdfs:range :SourceDocument .

:relationActingDocument a owl:ObjectProperty ;
    rdfs:domain :LegalRelationEvent ; rdfs:range :SourceDocument .
:relationTargetDocument a owl:ObjectProperty ;
    rdfs:domain :LegalRelationEvent ; rdfs:range :SourceDocument .
:hasLegalRelationKind a owl:ObjectProperty ;
    rdfs:domain :LegalRelationEvent ; rdfs:range :LegalRelationKind .
:relationEffectiveDate a owl:DatatypeProperty ;
    rdfs:domain :LegalRelationEvent ; rdfs:range xsd:string .

# Effective dates and verified legal relations on curated baseline Indonesian regulations.

:source-id-tarif-atiga :regulationNumber "43/PMK.010/2022" ; :effectiveFromDate "2022-04-01" .
