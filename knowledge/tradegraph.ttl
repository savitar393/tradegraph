:documentProposedUse a owl:ObjectProperty ; rdfs:domain :Document ; rdfs:range :IntendedUse .
:proposedUse a owl:ObjectProperty ; rdfs:domain :TradeCaseRevision ; rdfs:range :IntendedUse .
