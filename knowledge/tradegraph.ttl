:coverageWindow a owl:ObjectProperty ; rdfs:domain :CoverageDeclaration ; rdfs:range :ReviewWindow .
:windowJurisdiction a owl:ObjectProperty ; rdfs:domain :ReviewWindow ; rdfs:range :Jurisdiction .

:windowFrom a owl:DatatypeProperty ; rdfs:domain :ReviewWindow ; rdfs:range xsd:dateTime .
:windowUntil a owl:DatatypeProperty ; rdfs:domain :ReviewWindow ; rdfs:range xsd:dateTime .
