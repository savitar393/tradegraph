# Verified ACFTA general rule (PMK 171/2020 Pasal 4(2)(a)) and CTH/RVC40 chapter rules (Lampiran A I.3.b)

:acfta-rvc-40-threshold a owl:NamedIndividual, :OriginThreshold ;
    rdfs:label "ACFTA RVC 40% threshold" ;
    :minimumRvcPercent "40.0"^^xsd:decimal ;
    :hasSourceClause :pmk171-pasal-4 .

:psr-acfta-general a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :acfta ;
    :conciseRuleText "RVC40 (General Rule PMK 171/2020 Pasal 4(2)(a))" ;
    :hasPsrAlternative :psr-acfta-general-alt-1 ;
    :hasSourceClause :pmk171-pasal-4 .
:psr-acfta-general-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionRVC ;
    :alternativeRvcThreshold :acfta-rvc-40-threshold .

:hs2-58 a owl:NamedIndividual, :HSChapter ; :chapterCode "58" .
:hs2-61 a owl:NamedIndividual, :HSChapter ; :chapterCode "61" .
:hs2-73 a owl:NamedIndividual, :HSChapter ; :chapterCode "73" .
:hs2-96 a owl:NamedIndividual, :HSChapter ; :chapterCode "96" .

:psr-acfta-c58 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :acfta ; :psrForChapter :hs2-58 ;
    :conciseRuleText "CTH or RVC40" ;
    :hasPsrAlternative :psr-acfta-c58-alt-1, :psr-acfta-c58-alt-2 ;
    :hasSourceClause :pmk171-lampiran-a .
:psr-acfta-c58-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ; :requiresCriterionKind :criterionCTH .
:psr-acfta-c58-alt-2 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionRVC ; :alternativeRvcThreshold :acfta-rvc-40-threshold .

:psr-acfta-c61 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :acfta ; :psrForChapter :hs2-61 ;
    :conciseRuleText "CTH or RVC40" ;
    :hasPsrAlternative :psr-acfta-c61-alt-1, :psr-acfta-c61-alt-2 ;
    :hasSourceClause :pmk171-lampiran-a .
:psr-acfta-c61-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ; :requiresCriterionKind :criterionCTH .
:psr-acfta-c61-alt-2 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionRVC ; :alternativeRvcThreshold :acfta-rvc-40-threshold .

:psr-acfta-c73 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :acfta ; :psrForChapter :hs2-73 ;
    :conciseRuleText "CTH or RVC40" ;
    :hasPsrAlternative :psr-acfta-c73-alt-1, :psr-acfta-c73-alt-2 ;
    :hasSourceClause :pmk171-lampiran-a .
:psr-acfta-c73-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ; :requiresCriterionKind :criterionCTH .
:psr-acfta-c73-alt-2 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionRVC ; :alternativeRvcThreshold :acfta-rvc-40-threshold .

:psr-acfta-c96 a owl:NamedIndividual, :ProductSpecificRule ;
    :psrAgreement :acfta ; :psrForChapter :hs2-96 ;
    :conciseRuleText "CTH or RVC40" ;
    :hasPsrAlternative :psr-acfta-c96-alt-1, :psr-acfta-c96-alt-2 ;
    :hasSourceClause :pmk171-lampiran-a .
:psr-acfta-c96-alt-1 a owl:NamedIndividual, :OriginRuleAlternative ; :requiresCriterionKind :criterionCTH .
:psr-acfta-c96-alt-2 a owl:NamedIndividual, :OriginRuleAlternative ;
    :requiresCriterionKind :criterionRVC ; :alternativeRvcThreshold :acfta-rvc-40-threshold .

# Verified IJEPA PSRs from archived PMK 73/PMK.04/2021 Lampiran Huruf A angka I.3 (p.37-38)

