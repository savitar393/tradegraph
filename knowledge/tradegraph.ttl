# RCEP Tariff Differentials (DV20 >= 20% FOB) DecisionQueries and Policy

:q-rcep-dv20-na a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "rcep-dv20-na" ;
    rdfs:label "Pos tarif tidak tercantum dalam Lampiran II (Appendix to Annex I) Tariff Differentials RCEP"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?code WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product .
    ?agreement tg:hasTariffDifferentialThreshold ?threshold .
    ?product tg:hasTariffClassification ?code .
    FILTER NOT EXISTS { ?code tg:subjectToRcepTariffDifferential true . }
}""" .

:q-rcep-dv20-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "rcep-dv20-pass" ;
    rdfs:label "Nilai Tambah Domestik (DV20) memenuhi ambang minimal 20% FOB sehingga Pihak pengekspor menjadi RCEP Country of Origin"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ;
        cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:hasTariffClassification ?code .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    ?code tg:subjectToRcepTariffDifferential true .
    ?agreement tg:hasTariffDifferentialThreshold ?threshold .
    ?threshold tg:minimumDvPercent ?minDv .
    ?evidence tg:documentType tg:dv20Statement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:recordedDomesticValueAdditionPercent ?dv .
    FILTER (DATATYPE(?dv) = xsd:decimal && ?dv >= 0 && ?dv <= 100 && ?dv >= ?minDv)
}""" .

:q-rcep-dv20-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "rcep-dv20-fail" ;
    rdfs:label "Nilai Tambah Domestik (DV20) di bawah 20% FOB; RCEP Country of Origin beralih ke Pihak kontributor bahan originating tertinggi (Pasal 14 ayat 5 huruf b)"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ;
        cd:admittedDocument ?evidence .
    ?shipment tg:shipmentDispatchCountry ?dispatch .
    ?product tg:hasBatch ?batch ; tg:hasTariffClassification ?code .
    ?batch tg:producedAt/tg:withinLocation ?dispatch .
    ?code tg:subjectToRcepTariffDifferential true .
    ?agreement tg:hasTariffDifferentialThreshold ?threshold .
    ?threshold tg:minimumDvPercent ?minDv .
    ?evidence tg:documentType tg:dv20Statement ; tg:documentBatch ?batch ;
        tg:documentShipment ?shipment ; tg:recordedDomesticValueAdditionPercent ?dv .
    FILTER (DATATYPE(?dv) = xsd:decimal && ?dv >= 0 && ?dv <= 100 && ?dv < ?minDv)
}""" .

:policy-rcep-tariff-differential-dv20 a owl:NamedIndividual, catalog:PolicyDefinition ;
    catalog:id "rcep-tariff-differential-dv20" ;
    rdfs:label "Ketentuan Tariff Differentials RCEP dan Nilai Tambah Domestik (DV20 >= 20% FOB)"@id ;
    catalog:coverageScope :scope-rcep-psr-generic ; catalog:policyKind "CRITERION" ;
    :hasSourceClause :pmk209-pasal-14 ;
    catalog:satisfiedQuery :q-rcep-dv20-pass ; catalog:failedQuery :q-rcep-dv20-fail ;
    catalog:exceptionQuery :q-rcep-dv20-na .

# Date- & Partner-Aware Multi-FTA Tariff Optimization Catalog Query

:query-optimize-fta-tariff a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "optimize-fta-tariff" ;
    rdfs:label "Optimasi dan pemeringkatan tarif preferensi Multi-FTA per tanggal, negara asal, MFN baseline, status pencabutan PMK, dan indikator RCEP DV20"@id ;
    catalog:parameters ( "code" "dispatch" "destination" "asOfDate" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?agreement ?agreementLabel ?facilityCode ?backToBackAllowed ?psr ?psrLevel ?conciseRule
    ?mfnDutyPercent ?effectiveDutyPercent ?dutySavingsPercent ?excludedToMfn ?requiresRcepDv20
    ?tariffEntry ?tariffEffectiveFrom ?tariffEffectiveUntil ?tariffSourceDoc ?tariffRevokedOn ?tariffSupersedingDoc
WHERE {
    ?agreement a tg:TradeAgreement ;
        tg:agreementParty ?dispatch ;
        tg:agreementParty ?destination .
    FILTER (?dispatch != ?destination)
    OPTIONAL { ?agreement rdfs:label ?agreementLabel . }
    OPTIONAL { ?agreement tg:pibFacilityCode ?facilityCode . }
    OPTIONAL { ?agreement tg:allowsBackToBackCoo ?backToBackAllowed . }
    ?code tg:tariffSubheading ?targetSub .
    ?targetSub tg:subheadingHeading ?targetHead .
    ?targetHead tg:headingChapter ?targetChap .
    OPTIONAL { ?code tg:mfnDutyPercent ?mfnDutyPercent . }
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . OPTIONAL { ?subPsr tg:conciseRuleText ?subRule . } }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . OPTIONAL { ?headPsr tg:conciseRuleText ?headRule . } }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . OPTIONAL { ?chapPsr tg:conciseRuleText ?chapRule . } }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . OPTIONAL { ?genPsr tg:conciseRuleText ?genRule . } }
    OPTIONAL {
        ?tariffEntry a tg:TariffRateEntry ; tg:tariffAgreement ?agreement ;
            tg:tariffTargetCode ?code .
        FILTER (!EXISTS { ?tariffEntry tg:tariffPartnerCountry ?anyPartner . }
            || EXISTS { ?tariffEntry tg:tariffPartnerCountry ?dispatch . })
        OPTIONAL { ?tariffEntry tg:tariffEffectiveFrom ?tariffEffectiveFrom . }
        OPTIONAL { ?tariffEntry tg:tariffEffectiveUntilExclusive ?tariffEffectiveUntil . }
        FILTER ((!BOUND(?tariffEffectiveFrom) || STR(?tariffEffectiveFrom) <= STR(?asOfDate))
            && (!BOUND(?tariffEffectiveUntil) || STR(?asOfDate) < STR(?tariffEffectiveUntil)))
        OPTIONAL { ?tariffEntry tg:preferentialDutyPercent ?prefDuty . }
        OPTIONAL { ?tariffEntry tg:tariffExcludedToMfn ?exclFlag . }
        OPTIONAL {
            ?tariffEntry tg:hasSourceClause/tg:clauseInDocument ?tariffSourceDoc .
            OPTIONAL {
                ?revEvent a tg:LegalRelationEvent ;
                    tg:relationTargetDocument ?tariffSourceDoc ;
                    tg:hasLegalRelationKind tg:relRevokes ;
                    tg:relationActingDocument ?tariffSupersedingDoc ;
                    tg:relationEffectiveDate ?tariffRevokedOn .
                FILTER (STR(?tariffRevokedOn) <= STR(?asOfDate))
            }
        }
    }
    FILTER (BOUND(?subPsr) || BOUND(?headPsr) || BOUND(?chapPsr) || BOUND(?genPsr) || BOUND(?tariffEntry))
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    BIND(COALESCE(?subRule, ?headRule, ?chapRule, ?genRule) AS ?conciseRule)
    BIND(IF(BOUND(?subPsr), "SUBHEADING", IF(BOUND(?headPsr), "HEADING", IF(BOUND(?chapPsr), "CHAPTER", IF(BOUND(?genPsr), "GENERAL", "NONE")))) AS ?psrLevel)
    BIND(COALESCE(?exclFlag, false) AS ?excludedToMfn)
    BIND(IF(?excludedToMfn, ?mfnDutyPercent, ?prefDuty) AS ?effectiveDutyPercent)
    BIND(?mfnDutyPercent - ?effectiveDutyPercent AS ?dutySavingsPercent)
    BIND((EXISTS { ?agreement tg:hasTariffDifferentialThreshold ?dvThresh . }
        && EXISTS { ?code tg:subjectToRcepTariffDifferential true . }) AS ?requiresRcepDv20)
}
ORDER BY ASC(IF(BOUND(?effectiveDutyPercent), 0, 1)) ASC(?effectiveDutyPercent) ASC(?agreement)""" .

# Indonesian Import Tax Profile (PPN & PPh Pasal 22 Impor) and Multi-FTA Compliance Planning Actions (0.11.0)

:ImportTaxProfile a owl:Class .
:hasImportTaxProfile a owl:ObjectProperty ;
    rdfs:domain :Jurisdiction ; rdfs:range :ImportTaxProfile .
:vatRatePercent a owl:DatatypeProperty ;
    rdfs:domain :ImportTaxProfile ; rdfs:range xsd:decimal .
:pph22WithApiPercent a owl:DatatypeProperty ;
    rdfs:domain :ImportTaxProfile ; rdfs:range xsd:decimal .
:pph22WithoutApiPercent a owl:DatatypeProperty ;
    rdfs:domain :ImportTaxProfile ; rdfs:range xsd:decimal .
:primaryOriginDocumentType a owl:ObjectProperty ;
    rdfs:domain :TradeAgreement ; rdfs:range :DocumentType .

:source-id-uu-hpp a owl:NamedIndividual, :SourceDocument ;
    rdfs:label "Undang-Undang Nomor 7 Tahun 2021 tentang Harmonisasi Peraturan Perpajakan (UU HPP)" ;
    :regulationNumber "UU 7 Tahun 2021" ;
    :effectiveFromDate "2022-04-01" .

:source-id-pph22-impor a owl:NamedIndividual, :SourceDocument ;
    rdfs:label "PMK 41/PMK.010/2022 tentang Pemungutan Pajak Penghasilan Pasal 22 atas Kegiatan di Bidang Impor" ;
    :regulationNumber "41/PMK.010/2022" ;
    :effectiveFromDate "2022-04-01" .

:uu-hpp-pasal-7 a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-uu-hpp ;
    :clauseLocator "Pasal 7 ayat (1) huruf a (Tarif PPN 11% atas Nilai Impor)" .

:pmk41-2022-pasal-2 a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-pph22-impor ;
    :clauseLocator "Pasal 2 ayat (1) huruf a (Tarif PPh Pasal 22 Impor: 2,5% dengan API, 7,5% tanpa API)" .

:idImportTaxProfile a owl:NamedIndividual, :ImportTaxProfile ;
    rdfs:label "Profil Pajak Dalam Rangka Impor Indonesia (PPN 11%, PPh 22 2,5% API / 7,5% Non-API)"@id ;
    :vatRatePercent "11.0"^^xsd:decimal ;
    :pph22WithApiPercent "2.5"^^xsd:decimal ;
    :pph22WithoutApiPercent "7.5"^^xsd:decimal ;
    :hasSourceClause :uu-hpp-pasal-7, :pmk41-2022-pasal-2 .

:jurisdictionIndonesiaCustoms :hasImportTaxProfile :idImportTaxProfile .

:atiga :primaryOriginDocumentType :atigaFormD .
:rcep :primaryOriginDocumentType :rcepFormRcep .
:acfta :primaryOriginDocumentType :acftaFormE .
:ijepa :primaryOriginDocumentType :ijepaFormJiepa .

:ftaPreferenceChecklist a owl:NamedIndividual, :PreparationArtifact ;
    rdfs:label "Daftar periksa pengisian kode fasilitas PIB dan penyerahan Bukti Asal Barang"@id ;
    :hasSourceClause :pmk35-submission .

:query-import-tax-profile a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "import-tax-profile" ;
    rdfs:label "Profil tarif pajak impor (PPN dan PPh Pasal 22) berdasarkan yurisdiksi kepabeanan"@id ;
    catalog:parameters ( "jurisdiction" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?profile ?profileLabel ?vatRatePercent ?pph22WithApiPercent ?pph22WithoutApiPercent WHERE {
    ?jurisdiction tg:hasImportTaxProfile ?profile .
    OPTIONAL { ?profile rdfs:label ?profileLabel . }
    ?profile tg:vatRatePercent ?vatRatePercent ;
        tg:pph22WithApiPercent ?pph22WithApiPercent ;
        tg:pph22WithoutApiPercent ?pph22WithoutApiPercent .
}""" .

:goal-fta-origin-proof-ready a owl:NamedIndividual, catalog:GoalDefinition ;
    catalog:id "fta-origin-proof-ready" ;
    rdfs:label "Bukti Asal Barang (SKA/DAB) untuk skema FTA terpilih siap diserahkan"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?agreement tg:agreementOriginDocumentType ?docType .
    FILTER (
        EXISTS { ?revision tg:hasDraftDocumentType ?docType . }
        || EXISTS {
            ?context cd:admittedDocument ?doc .
            ?doc tg:documentType ?docType ; tg:submittedForPreference true .
        }
    )
}""" .

:goal-fta-preference-package-ready a owl:NamedIndividual, catalog:GoalDefinition ;
    catalog:id "fta-preference-package-ready" ;
    rdfs:label "Paket kepatuhan klaim tarif preferensi FTA (SKA/DAB, DV20 bila wajib, dan daftar periksa PIB) siap"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?revision tg:hasPreparationArtifact tg:ftaPreferenceChecklist .
    FILTER (
        EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?revision tg:hasDraftDocumentType ?docType .
        } || EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?context cd:admittedDocument ?doc .
            ?doc tg:documentType ?docType ; tg:submittedForPreference true .
        }
    )
    FILTER (
        !EXISTS {
            ?agreement tg:hasTariffDifferentialThreshold ?t .
            ?product tg:hasTariffClassification/tg:subjectToRcepTariffDifferential true .
        } || EXISTS {
            ?revision tg:hasDraftDocumentType tg:dv20Statement .
        } || EXISTS {
            ?context cd:admittedDocument ?dvDoc .
            ?dvDoc tg:documentType tg:dv20Statement .
        }
    )
}""" .

:action-prepare-fta-origin-proof a owl:NamedIndividual, :ActionTemplate, catalog:ActionDefinition ;
    catalog:id "prepare-fta-origin-proof" ;
    rdfs:label "Terbitkan atau siapkan draf Bukti Asal Barang (SKA/DAB) sesuai skema FTA terpilih"@id ;
    :hasSourceClause :pmk35-submission ;
    catalog:goals ( :goal-fta-origin-proof-ready :goal-fta-preference-package-ready :goal-fta-full-clearance-ready ) ;
    catalog:typedParameters (
        [ catalog:name "revision" ; catalog:valueType catalog:IRI ; catalog:fromContext "revision" ]
        [ catalog:name "agreement" ; catalog:valueType catalog:IRI ; catalog:fromContext "agreement" ]
    ) ;
    catalog:applicabilitySparql """PREFIX tg: <urn:tradegraph:kb#>
ASK {
    ?agreement a tg:TradeAgreement ; tg:primaryOriginDocumentType ?docType .
}""" ;
    catalog:preconditions ( [
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?revision tg:revisionShipment ?shipment .
    ?shipment tg:shipmentDispatchCountry ?dispatch ; tg:shipmentDestinationCountry ?dest .
    ?agreement tg:agreementParty ?dispatch ; tg:agreementParty ?dest .
    FILTER (?dispatch != ?dest)
    FILTER NOT EXISTS {
        ?agreement tg:agreementOriginDocumentType ?docType .
        ?context cd:admittedDocument ?doc .
        ?doc tg:documentType ?docType ; tg:submittedForPreference true .
    }
}"""
    ] ) ;
    catalog:effects ( [
        catalog:operation "ADD" ;
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
CONSTRUCT { ?revision tg:hasDraftDocumentType ?docType . }
WHERE { ?agreement tg:primaryOriginDocumentType ?docType . }"""
    ] ) .

:action-prepare-rcep-dv20-statement a owl:NamedIndividual, :ActionTemplate, catalog:ActionDefinition ;
    catalog:id "prepare-rcep-dv20-statement" ;
    rdfs:label "Siapkan pernyataan Nilai Tambah Domestik RCEP (DV20 >= 20% FOB) untuk pos Lampiran II"@id ;
    :hasSourceClause :pmk209-pasal-14 ;
    catalog:goals ( :goal-fta-preference-package-ready :goal-fta-full-clearance-ready ) ;
    catalog:typedParameters (
        [ catalog:name "revision" ; catalog:valueType catalog:IRI ; catalog:fromContext "revision" ]
        [ catalog:name "agreement" ; catalog:valueType catalog:IRI ; catalog:fromContext "agreement" ]
        [ catalog:name "product" ; catalog:valueType catalog:IRI ; catalog:fromContext "product" ]
    ) ;
    catalog:applicabilitySparql """PREFIX tg: <urn:tradegraph:kb#>
ASK {
    ?agreement tg:hasTariffDifferentialThreshold ?t .
    ?product tg:hasTariffClassification/tg:subjectToRcepTariffDifferential true .
}""" ;
    catalog:preconditions ( [
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?revision tg:revisionShipment ?shipment .
    FILTER (
        EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?revision tg:hasDraftDocumentType ?docType .
        } || EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?context cd:admittedDocument ?doc .
            ?doc tg:documentType ?docType ; tg:submittedForPreference true .
        }
    )
    FILTER NOT EXISTS {
        ?context cd:admittedDocument ?dvDoc .
        ?dvDoc tg:documentType tg:dv20Statement .
    }
}"""
    ] ) ;
    catalog:effects ( [
        catalog:producesDraftOf :dv20Statement ; catalog:operation "ADD" ;
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
CONSTRUCT { ?revision tg:hasDraftDocumentType tg:dv20Statement . } WHERE {}"""
    ] ) .

:action-prepare-fta-pib-checklist a owl:NamedIndividual, :ActionTemplate, catalog:ActionDefinition ;
    catalog:id "prepare-fta-pib-checklist" ;
    rdfs:label "Siapkan daftar periksa pengisian kode fasilitas PIB dan berkas klaim preferensi FTA"@id ;
    :hasSourceClause :pmk35-submission ;
    catalog:goals ( :goal-fta-preference-package-ready :goal-fta-full-clearance-ready ) ;
    catalog:typedParameters (
        [ catalog:name "revision" ; catalog:valueType catalog:IRI ; catalog:fromContext "revision" ]
        [ catalog:name "agreement" ; catalog:valueType catalog:IRI ; catalog:fromContext "agreement" ]
        [ catalog:name "product" ; catalog:valueType catalog:IRI ; catalog:fromContext "product" ]
        [ catalog:name "jurisdiction" ; catalog:valueType catalog:IRI ; catalog:fromContext "jurisdiction" ]
        [ catalog:name "transactionAt" ; catalog:valueType xsd:dateTime ; catalog:fromContext "transactionAt" ]
    ) ;
    catalog:applicabilitySparql """PREFIX tg: <urn:tradegraph:kb#>
ASK {
    ?agreement a tg:TradeAgreement ; tg:pibFacilityCode ?code .
}""" ;
    catalog:preconditions ( [
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?revision tg:revisionShipment ?shipment .
    FILTER (
        EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?revision tg:hasDraftDocumentType ?docType .
        } || EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?context cd:admittedDocument ?doc .
            ?doc tg:documentType ?docType ; tg:submittedForPreference true .
        }
    )
    FILTER (
        !EXISTS {
            ?agreement tg:hasTariffDifferentialThreshold ?t .
            ?product tg:hasTariffClassification/tg:subjectToRcepTariffDifferential true .
        } || EXISTS {
            ?revision tg:hasDraftDocumentType tg:dv20Statement .
        } || EXISTS {
            ?context cd:admittedDocument ?dvDoc .
            ?dvDoc tg:documentType tg:dv20Statement .
        }
    )
    FILTER NOT EXISTS {
        ?product tg:hasTariffClassification ?hsCode .
        ?pRule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?hsCode ;
            tg:lartasJurisdiction ?jurisdiction ; tg:lartasProhibited true .
        OPTIONAL { ?pRule tg:lartasEffectiveFrom ?pEff . }
        FILTER (!BOUND(?pEff) || STR(?pEff) <= SUBSTR(STR(?transactionAt), 1, 10))
    }
    FILTER NOT EXISTS {
        ?product tg:hasTariffClassification ?hsCode .
        ?lRule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?hsCode ;
            tg:lartasJurisdiction ?jurisdiction ; tg:lartasRequiresDocumentType ?reqDoc .
        OPTIONAL { ?lRule tg:lartasEffectiveFrom ?lEff . }
        FILTER (!BOUND(?lEff) || STR(?lEff) <= SUBSTR(STR(?transactionAt), 1, 10))
        FILTER NOT EXISTS { ?revision tg:hasDraftDocumentType ?reqDoc . }
        FILTER NOT EXISTS {
            ?context cd:admittedDocument ?adDoc .
            ?adDoc tg:documentType ?reqDoc .
        }
    }
}"""
    ] ) ;
    catalog:effects ( [
        catalog:operation "ADD" ;
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
CONSTRUCT { ?revision tg:hasPreparationArtifact tg:ftaPreferenceChecklist . } WHERE {}"""
    ] ) .

# Indonesian Non-Tariff Measures / Lartas Layer (Permendag 17/18/21/22/47 Tahun 2025 & PerBPOM 28 Tahun 2023) (0.12.0)

:ImportRestrictionRule a owl:Class .
:LartasSupervisionMode a owl:Class .
:ApiCategory a owl:Class .

:supervisionBorder a owl:NamedIndividual, :LartasSupervisionMode ; rdfs:label "BORDER"@id .
:supervisionPostBorder a owl:NamedIndividual, :LartasSupervisionMode ; rdfs:label "POST_BORDER"@id .
:supervisionProhibited a owl:NamedIndividual, :LartasSupervisionMode ; rdfs:label "PROHIBITED"@id .
[] a owl:AllDifferent ; owl:distinctMembers ( :supervisionBorder :supervisionPostBorder :supervisionProhibited ) .

:apiP a owl:NamedIndividual, :ApiCategory ; rdfs:label "API-P"@id .
:apiU a owl:NamedIndividual, :ApiCategory ; rdfs:label "API-U"@id .
[] a owl:AllDifferent ; owl:distinctMembers ( :apiP :apiU ) .

:lartasTargetCode a owl:ObjectProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range :HSCode .
:lartasJurisdiction a owl:ObjectProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range :Jurisdiction .
:lartasSupervisionMode a owl:ObjectProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range :LartasSupervisionMode .
:lartasRequiresDocumentType a owl:ObjectProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range :DocumentType .
:lartasAllowedApi a owl:ObjectProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range :ApiCategory .
:lartasProhibited a owl:DatatypeProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range xsd:boolean .
:lartasEffectiveFrom a owl:DatatypeProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range xsd:string .
:lartasCommodityGroup a owl:DatatypeProperty ;
    rdfs:domain :ImportRestrictionRule ; rdfs:range xsd:string .

