    rdfs:label "ACFTA De Minimis 10% FOB (Bab 01-97)"@id ;
    :deMinimisBasis :basisFobValue ; :deMinimisChapterMin "01" ; :deMinimisChapterMax "97" ;
    :deMinimisMaxPercent "10.0"^^xsd:decimal ; :hasSourceClause :pmk171-lampiran-a-iii .

:dm-acfta-textile-weight a owl:NamedIndividual, :DeMinimisBand ;
    rdfs:label "ACFTA De Minimis 10% berat (Bab 50-63)"@id ;
    :deMinimisBasis :basisProductWeight ; :deMinimisChapterMin "50" ; :deMinimisChapterMax "63" ;
    :deMinimisMaxPercent "10.0"^^xsd:decimal ; :hasSourceClause :pmk171-lampiran-a-iii .

:dm-ijepa-ch28-49-value a owl:NamedIndividual, :DeMinimisBand ;
    rdfs:label "IJEPA De Minimis 10% FOB (Bab 28-49)"@id ;
    :deMinimisBasis :basisFobValue ; :deMinimisChapterMin "28" ; :deMinimisChapterMax "49" ;
    :deMinimisMaxPercent "10.0"^^xsd:decimal ; :hasSourceClause :pmk73-lampiran-a-iv .

:dm-ijepa-ch64-97-value a owl:NamedIndividual, :DeMinimisBand ;
    rdfs:label "IJEPA De Minimis 10% FOB (Bab 64-97)"@id ;
    :deMinimisBasis :basisFobValue ; :deMinimisChapterMin "64" ; :deMinimisChapterMax "97" ;
    :deMinimisMaxPercent "10.0"^^xsd:decimal ; :hasSourceClause :pmk73-lampiran-a-iv .

:dm-ijepa-textile-weight a owl:NamedIndividual, :DeMinimisBand ;
    rdfs:label "IJEPA De Minimis 7% berat (Bab 50-63)"@id ;
    :deMinimisBasis :basisProductWeight ; :deMinimisChapterMin "50" ; :deMinimisChapterMax "63" ;
    :deMinimisMaxPercent "7.0"^^xsd:decimal ; :hasSourceClause :pmk73-lampiran-a-iv .

:atiga
    :cumulationCode "ACL" ;
    :deMinimisCode "DMS" ;
    :hasDeMinimisBand :dm-atiga-all-value ;
    :disqualifyingOperation :minimalPreservation, :minimalPackaging, :minimalTransportFacilitation .

:rcep
    :cumulationCode "ACU" ;
    :deMinimisCode "DMI" ;
    :hasDeMinimisBand :dm-rcep-all-value, :dm-rcep-textile-weight ;
    :disqualifyingOperation :minimalPreservation, :minimalPackaging, :minimalSimpleSortingOrCutting,
        :minimalLabeling, :minimalSimpleDilution, :minimalDisassembly, :minimalSlaughter, :minimalSimpleMixing .

:acfta
    :hasDeMinimisBand :dm-acfta-all-value, :dm-acfta-textile-weight ;
    :disqualifyingOperation :minimalPreservation, :minimalPackaging, :minimalTransportFacilitation .

:ijepa
    :cumulationCode "ACU" ;
    :deMinimisCode "DMI" ;
    :hasDeMinimisBand :dm-ijepa-ch28-49-value, :dm-ijepa-ch64-97-value, :dm-ijepa-textile-weight ;
    :disqualifyingOperation :minimalPreservation, :minimalPackaging, :minimalDisassembly,
        :minimalGri2aAssembly, :minimalSimpleSetAssembly .

# Shared Declarative DecisionQueries for Multi-FTA De Minimis & Minimal Operations

:q-psr-de-minimis-na a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-de-minimis-na" ; rdfs:label "De Minimis tidak berlaku (PSR tanpa CTC atau bab tidak tercakup De Minimis perjanjian)"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?psr WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product .
    ?product tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?targetChap tg:chapterCode ?targetChapCode .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    FILTER (
        NOT EXISTS {
            ?psr tg:hasPsrAlternative/tg:requiresCriterionKind ?kind .
            VALUES ?kind { tg:criterionCC tg:criterionCTH tg:criterionCTSH }
        } ||
        NOT EXISTS {
            ?agreement tg:hasDeMinimisBand ?band .
            ?band tg:deMinimisChapterMin ?cMin ; tg:deMinimisChapterMax ?cMax .
            FILTER (?targetChapCode >= ?cMin && ?targetChapCode <= ?cMax)
        }
    )
}""" .

:q-psr-de-minimis-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-de-minimis-pass" ; rdfs:label "Bahan non-originating gagal CTC berada dalam batas De Minimis perjanjian"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?targetChap tg:chapterCode ?targetChapCode .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative/tg:requiresCriterionKind ?ctcKind .
    VALUES ?ctcKind { tg:criterionCC tg:criterionCTH tg:criterionCTSH }
    ?evidence tg:documentType tg:deMinimisValueStatement ;
        tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:documentComponentList ?bom .
    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true .
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    ?agreement tg:hasDeMinimisBand ?band .
    ?band tg:deMinimisBasis ?basis ; tg:deMinimisChapterMin ?cMin ;
        tg:deMinimisChapterMax ?cMax ; tg:deMinimisMaxPercent ?maxPct .
    FILTER (?targetChapCode >= ?cMin && ?targetChapCode <= ?cMax)
    FILTER (
        (?basis = tg:basisFobValue && EXISTS {
            ?evidence tg:valuationScopeClosed true ; tg:valuationCurrency ?curr ;
                tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedVal .
            FILTER NOT EXISTS { ?evidence tg:valuationScopeClosed false . }
            FILTER (isIRI(?curr) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedVal) = xsd:decimal
                && ?fob > 0 && ?failedVal >= 0 && ?failedVal <= ?fob
                && ?failedVal * 100 <= ?fob * ?maxPct)
        }) ||
        (?basis = tg:basisProductWeight && EXISTS {
            ?evidence tg:weightScopeClosed true ;
                tg:totalProductWeight ?totalWt ; tg:failedCtcMaterialWeight ?failedWt .
            FILTER NOT EXISTS { ?evidence tg:weightScopeClosed false . }
            FILTER (DATATYPE(?totalWt) = xsd:decimal && DATATYPE(?failedWt) = xsd:decimal
                && ?totalWt > 0 && ?failedWt >= 0 && ?failedWt <= ?totalWt
                && ?failedWt * 100 <= ?totalWt * ?maxPct)
        })
    )
}""" .

:q-psr-de-minimis-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-de-minimis-fail" ; rdfs:label "Bahan non-originating gagal CTC melebihi seluruh batas De Minimis perjanjian yang berlaku"@id ;
    catalog:exactDecimal true ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesProduct ?product ;
        tg:assessesBatch ?batch ; tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?product tg:hasBatch ?batch ; tg:classifiedSubheading ?targetSub ;
        tg:classifiedHeading ?targetHead ; tg:classifiedChapter ?targetChap .
    ?targetChap tg:chapterCode ?targetChapCode .
    OPTIONAL { ?subPsr tg:psrForSubheading ?targetSub ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?headPsr tg:psrForHeading ?targetHead ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?chapPsr tg:psrForChapter ?targetChap ; tg:psrAgreement ?agreement . }
    OPTIONAL { ?agreement tg:generalOriginRule ?genPsr . }
    BIND(COALESCE(?subPsr, ?headPsr, ?chapPsr, ?genPsr) AS ?psr)
    FILTER (BOUND(?psr))
    ?psr tg:hasPsrAlternative/tg:requiresCriterionKind ?ctcKind .
    VALUES ?ctcKind { tg:criterionCC tg:criterionCTH tg:criterionCTSH }
    ?evidence tg:documentType tg:deMinimisValueStatement ;
        tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:documentComponentList ?bom .
    ?bom tg:componentListForBatch ?batch ; tg:componentListClosed true .
    FILTER NOT EXISTS { ?bom tg:componentListClosed false . }
    ?agreement tg:hasDeMinimisBand ?anyBand .
    ?anyBand tg:deMinimisBasis ?anyBasis ; tg:deMinimisChapterMin ?aMin ;
        tg:deMinimisChapterMax ?aMax ; tg:deMinimisMaxPercent ?aMaxPct .
    FILTER (?targetChapCode >= ?aMin && ?targetChapCode <= ?aMax)
    FILTER (
        (?anyBasis = tg:basisFobValue && EXISTS {
            ?evidence tg:valuationScopeClosed true ; tg:valuationCurrency ?curr ;
                tg:fobValue ?fob ; tg:failedCtcMaterialValue ?failedVal .
            FILTER NOT EXISTS { ?evidence tg:valuationScopeClosed false . }
            FILTER (isIRI(?curr) && DATATYPE(?fob) = xsd:decimal && DATATYPE(?failedVal) = xsd:decimal
                && ?fob > 0 && ?failedVal >= 0 && ?failedVal <= ?fob
                && ?failedVal * 100 > ?fob * ?aMaxPct)
        }) ||
        (?anyBasis = tg:basisProductWeight && EXISTS {
            ?evidence tg:weightScopeClosed true ;
                tg:totalProductWeight ?totalWt ; tg:failedCtcMaterialWeight ?failedWt .
            FILTER NOT EXISTS { ?evidence tg:weightScopeClosed false . }
            FILTER (DATATYPE(?totalWt) = xsd:decimal && DATATYPE(?failedWt) = xsd:decimal
                && ?totalWt > 0 && ?failedWt >= 0 && ?failedWt <= ?totalWt
                && ?failedWt * 100 > ?totalWt * ?aMaxPct)
        })
    )
    FILTER NOT EXISTS {
        ?agreement tg:hasDeMinimisBand ?okBand .
        ?okBand tg:deMinimisBasis ?okBasis ; tg:deMinimisChapterMin ?oMin ;
            tg:deMinimisChapterMax ?oMax ; tg:deMinimisMaxPercent ?oMaxPct .
        FILTER (?targetChapCode >= ?oMin && ?targetChapCode <= ?oMax)
        FILTER (
            (?okBasis = tg:basisFobValue && EXISTS {
                ?evidence tg:valuationScopeClosed true ; tg:valuationCurrency ?c2 ;
                    tg:fobValue ?f2 ; tg:failedCtcMaterialValue ?fv2 .
                FILTER NOT EXISTS { ?evidence tg:valuationScopeClosed false . }
                FILTER (isIRI(?c2) && DATATYPE(?f2) = xsd:decimal && DATATYPE(?fv2) = xsd:decimal
                    && ?f2 > 0 && ?fv2 >= 0 && ?fv2 <= ?f2 && ?fv2 * 100 <= ?f2 * ?oMaxPct)
            }) ||
            (?okBasis = tg:basisProductWeight && EXISTS {
                ?evidence tg:weightScopeClosed true ;
                    tg:totalProductWeight ?tw2 ; tg:failedCtcMaterialWeight ?fw2 .
                FILTER NOT EXISTS { ?evidence tg:weightScopeClosed false . }
                FILTER (DATATYPE(?tw2) = xsd:decimal && DATATYPE(?fw2) = xsd:decimal
                    && ?tw2 > 0 && ?fw2 >= 0 && ?fw2 <= ?tw2 && ?fw2 * 100 <= ?tw2 * ?oMaxPct)
            })
        )
    }
}""" .

:q-psr-minimal-ops-pass a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-minimal-ops-pass" ; rdfs:label "Tahapan produksi melampaui proses minimal perjanjian"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesBatch ?batch ;
        tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:productionProcessStatement ;
        tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:processScopeClosed true ; tg:performedOperation ?op .
    FILTER NOT EXISTS { ?evidence tg:processScopeClosed false . }
    FILTER NOT EXISTS { ?agreement tg:disqualifyingOperation ?op . }
}""" .

:q-psr-minimal-ops-fail a owl:NamedIndividual, catalog:DecisionQuery ;
    catalog:id "psr-minimal-ops-fail" ; rdfs:label "Tahapan produksi hanya berupa proses minimal yang menggugurkan status originating"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
SELECT DISTINCT ?evidence WHERE {
    ?context tg:selectedAgreement ?agreement ; tg:assessesBatch ?batch ;
        tg:assessmentShipment ?shipment ; cd:admittedDocument ?evidence .
    ?evidence tg:documentType tg:productionProcessStatement ;
        tg:documentBatch ?batch ; tg:documentShipment ?shipment ;
        tg:processScopeClosed true ; tg:performedOperation ?anyOp .
    FILTER NOT EXISTS { ?evidence tg:processScopeClosed false . }
    FILTER NOT EXISTS {
        ?evidence tg:performedOperation ?op .
        FILTER NOT EXISTS { ?agreement tg:disqualifyingOperation ?op . }
    }
}""" .

