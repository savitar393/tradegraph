:enteredTransitCommerce a owl:DatatypeProperty ; rdfs:domain :TransitStop ; rdfs:range xsd:boolean .
:transitPreservationOnly a owl:DatatypeProperty ; rdfs:domain :TransitStop ; rdfs:range xsd:boolean .
:nonOriginatingInput a owl:DatatypeProperty ; rdfs:domain :ComponentEntry ; rdfs:range xsd:boolean .
:submittedForPreference a owl:DatatypeProperty ; rdfs:domain :Document ; rdfs:range xsd:boolean .
:recordedRvcPercent a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Document ; rdfs:range xsd:decimal .
:minimumRvcPercent a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OriginThreshold ; rdfs:range xsd:decimal .
:identifiableForReexport a owl:DatatypeProperty ; rdfs:domain :TradeGood ; rdfs:range xsd:boolean .
:consumedInUse a owl:DatatypeProperty ; rdfs:domain :TradeGood ; rdfs:range xsd:boolean .
:essentialChangeInUse a owl:DatatypeProperty ; rdfs:domain :TradeGood ; rdfs:range xsd:boolean .
:temporaryUsePermitEnd a owl:DatatypeProperty ; rdfs:domain :Shipment ; rdfs:range xsd:dateTime .
:documentEventAt a owl:DatatypeProperty ; rdfs:domain :Document ; rdfs:range xsd:dateTime .

:assessmentShipment a owl:ObjectProperty ;
    rdfs:domain :AssessmentContext ; rdfs:range :Shipment ;
    owl:propertyChainAxiom ( :assessesRevision :revisionShipment ) .
:classifiedSubheading a owl:ObjectProperty ;
    rdfs:domain :TradeGood ; rdfs:range :HSSubheading ;
    owl:propertyChainAxiom ( :hasTariffClassification :tariffSubheading ) .

:DirectRouteShipment a owl:Class ; owl:disjointWith :TransitRouteShipment ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :routeKind ; owl:hasValue :directRoute ] .
:TransitRouteShipment a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :routeKind ; owl:hasValue :transitRoute ] .
:PumpRvcThresholdMet a owl:Class ; owl:disjointWith :PumpRvcThresholdNotMet .
:PumpRvcThresholdNotMet a owl:Class .

:directRoute a owl:NamedIndividual, :RouteKind .
:transitRoute a owl:NamedIndividual, :RouteKind .
[] a owl:AllDifferent ; owl:distinctMembers ( :directRoute :transitRoute ) .
:transportRequirement a owl:NamedIndividual, :TransitJustification .
:geographicNecessity a owl:NamedIndividual, :TransitJustification .
:otherTransitPurpose a owl:NamedIndividual, :TransitJustification .
[] a owl:AllDifferent ; owl:distinctMembers ( :transportRequirement :geographicNecessity :otherTransitPurpose ) .
:regularCargo a owl:NamedIndividual, :CargoCategory .
:unrestrictedImport a owl:NamedIndividual, :ImportCategory .
:restrictedImport a owl:NamedIndividual, :ImportCategory .
[] a owl:AllDifferent ; owl:distinctMembers ( :unrestrictedImport :restrictedImport ) .
:exhibitionReliefGroup a owl:NamedIndividual, :CustomsReliefGroup .
:reexportSettlement a owl:NamedIndividual, :SettlementChoice .
:domesticSettlement a owl:NamedIndividual, :SettlementChoice .
[] a owl:AllDifferent ; owl:distinctMembers ( :reexportSettlement :domesticSettlement ) .
:governmentProject a owl:NamedIndividual, :SettlementGround .
:centralGovernmentDonation a owl:NamedIndividual, :SettlementGround .
:ordinaryCommercialTransfer a owl:NamedIndividual, :SettlementGround .
[] a owl:AllDifferent ; owl:distinctMembers ( :governmentProject :centralGovernmentDonation :ordinaryCommercialTransfer ) .
