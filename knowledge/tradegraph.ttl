:query-import-lartas a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "import-lartas" ;
    rdfs:label "Aturan Larangan dan Pembatasan (Lartas / NTM) aktif per kode HS, yurisdiksi, dan tanggal"@id ;
    catalog:parameters ( "code" "jurisdiction" "asOfDate" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?rule ?commodityGroup ?supervisionMode ?supervisionLabel ?prohibited
    ?requiredDocType ?requiredDocLabel ?allowedApi ?effectiveFrom
    ?sourceClause ?clauseLocator ?sourceDoc ?regNumber ?docLabel ?sourceUrl
WHERE {
    ?rule a tg:ImportRestrictionRule ;
        tg:lartasTargetCode ?code ;
        tg:lartasJurisdiction ?jurisdiction ;
        tg:lartasSupervisionMode ?supervisionMode .
    OPTIONAL { ?supervisionMode rdfs:label ?supervisionLabel . }
    OPTIONAL { ?rule tg:lartasCommodityGroup ?commodityGroup . }
    OPTIONAL { ?rule tg:lartasProhibited ?prohFlag . }
    BIND(COALESCE(?prohFlag, false) AS ?prohibited)
    OPTIONAL { ?rule tg:lartasEffectiveFrom ?effectiveFrom . }
    FILTER (!BOUND(?effectiveFrom) || STR(?effectiveFrom) <= STR(?asOfDate))
    OPTIONAL {
        ?rule tg:lartasRequiresDocumentType ?requiredDocType .
        OPTIONAL { ?requiredDocType rdfs:label ?requiredDocLabel . }
    }
    OPTIONAL { ?rule tg:lartasAllowedApi ?allowedApi . }
    OPTIONAL {
        ?rule tg:hasSourceClause ?sourceClause .
        OPTIONAL { ?sourceClause tg:clauseLocator ?clauseLocator . }
        OPTIONAL {
            ?sourceClause tg:clauseInDocument ?sourceDoc .
            OPTIONAL { ?sourceDoc tg:regulationNumber ?regNumber . }
            OPTIONAL { ?sourceDoc rdfs:label ?docLabel . }
            OPTIONAL { ?sourceDoc rdfs:seeAlso ?sourceUrl . }
            FILTER NOT EXISTS {
                ?rev a tg:LegalRelationEvent ;
                    tg:relationTargetDocument ?sourceDoc ;
                    tg:hasLegalRelationKind tg:relRevokes ;
                    tg:relationEffectiveDate ?revDate .
                FILTER (STR(?revDate) <= STR(?asOfDate))
            }
        }
    }
}""" .

# Lartas Compliance Planning Action and Combined FTA + Lartas Clearance Goal

:goal-fta-full-clearance-ready a owl:NamedIndividual, catalog:GoalDefinition ;
    catalog:id "fta-full-clearance-ready" ;
    rdfs:label "Paket kepatuhan lengkap (preferensi FTA + seluruh perizinan Lartas non-terlarang) siap"@id ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?revision tg:hasPreparationArtifact tg:ftaPreferenceChecklist .
    FILTER (
        EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?revision tg:hasDraftDocumentType ?docType .
        } || EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?context cd:admittedDocument ?doc .
            ?doc tg:documentType ?docType ; tg:submittedForPreference true .
        }
    )
    FILTER (
        !EXISTS {
            ?agreement tg:hasTariffDifferentialThreshold ?t .
            ?product tg:hasTariffClassification/tg:subjectToRcepTariffDifferential true .
        } || EXISTS {
            ?revision tg:hasDraftDocumentType tg:dv20Statement .
        } || EXISTS {
            ?context cd:admittedDocument ?dvDoc .
            ?dvDoc tg:documentType tg:dv20Statement .
        }
    )
    FILTER NOT EXISTS {
        ?product tg:hasTariffClassification ?code .
        ?pRule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?code ;
            tg:lartasJurisdiction ?jurisdiction ; tg:lartasProhibited true .
        OPTIONAL { ?pRule tg:lartasEffectiveFrom ?pEff . }
        FILTER (!BOUND(?pEff) || STR(?pEff) <= SUBSTR(STR(?transactionAt), 1, 10))
    }
    FILTER NOT EXISTS {
        ?product tg:hasTariffClassification ?code .
        ?lRule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?code ;
            tg:lartasJurisdiction ?jurisdiction ; tg:lartasRequiresDocumentType ?reqDoc .
        OPTIONAL { ?lRule tg:lartasEffectiveFrom ?lEff . }
        FILTER (!BOUND(?lEff) || STR(?lEff) <= SUBSTR(STR(?transactionAt), 1, 10))
        FILTER NOT EXISTS { ?revision tg:hasDraftDocumentType ?reqDoc . }
        FILTER NOT EXISTS {
            ?context cd:admittedDocument ?adDoc .
            ?adDoc tg:documentType ?reqDoc .
        }
    }
}""" .

:action-prepare-lartas-permits a owl:NamedIndividual, :ActionTemplate, catalog:ActionDefinition ;
    catalog:id "prepare-lartas-permits" ;
    rdfs:label "Urus dan siapkan seluruh dokumen perizinan Lartas / NTM yang wajib (PI, LS, SKI BPOM, Izin Edar)"@id ;
    :hasSourceClause :permendag16-import, :bpom28-pasal-3-obat, :bpom28-pasal-3-pangan ;
    catalog:goals ( :goal-fta-preference-package-ready :goal-fta-full-clearance-ready ) ;
    catalog:typedParameters (
        [ catalog:name "revision" ; catalog:valueType catalog:IRI ; catalog:fromContext "revision" ]
        [ catalog:name "agreement" ; catalog:valueType catalog:IRI ; catalog:fromContext "agreement" ]
        [ catalog:name "product" ; catalog:valueType catalog:IRI ; catalog:fromContext "product" ]
        [ catalog:name "jurisdiction" ; catalog:valueType catalog:IRI ; catalog:fromContext "jurisdiction" ]
        [ catalog:name "transactionAt" ; catalog:valueType xsd:dateTime ; catalog:fromContext "transactionAt" ]
    ) ;
    catalog:applicabilitySparql """PREFIX tg: <urn:tradegraph:kb#>
ASK {
    ?product tg:hasTariffClassification ?code .
    ?rule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?code ;
        tg:lartasJurisdiction ?jurisdiction ; tg:lartasRequiresDocumentType ?reqDoc .
    OPTIONAL { ?rule tg:lartasEffectiveFrom ?eff . }
    FILTER (!BOUND(?eff) || STR(?eff) <= SUBSTR(STR(?transactionAt), 1, 10))
    FILTER NOT EXISTS { ?rule tg:lartasProhibited true . }
}""" ;
    catalog:preconditions ( [
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
ASK {
    ?revision tg:revisionShipment ?shipment .
    ?product tg:hasTariffClassification ?code .
    FILTER (
        EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?revision tg:hasDraftDocumentType ?docType .
        } || EXISTS {
            ?agreement tg:agreementOriginDocumentType ?docType .
            ?context cd:admittedDocument ?doc .
            ?doc tg:documentType ?docType ; tg:submittedForPreference true .
        }
    )
    FILTER (
        !EXISTS {
            ?agreement tg:hasTariffDifferentialThreshold ?t .
            ?code tg:subjectToRcepTariffDifferential true .
        } || EXISTS {
            ?revision tg:hasDraftDocumentType tg:dv20Statement .
        } || EXISTS {
            ?context cd:admittedDocument ?dvDoc .
            ?dvDoc tg:documentType tg:dv20Statement .
        }
    )
    FILTER NOT EXISTS {
        ?pRule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?code ;
            tg:lartasJurisdiction ?jurisdiction ; tg:lartasProhibited true .
        OPTIONAL { ?pRule tg:lartasEffectiveFrom ?pEff . }
        FILTER (!BOUND(?pEff) || STR(?pEff) <= SUBSTR(STR(?transactionAt), 1, 10))
    }
    ?rule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?code ;
        tg:lartasJurisdiction ?jurisdiction ; tg:lartasRequiresDocumentType ?reqDoc .
    OPTIONAL { ?rule tg:lartasEffectiveFrom ?eff . }
    FILTER (!BOUND(?eff) || STR(?eff) <= SUBSTR(STR(?transactionAt), 1, 10))
    FILTER NOT EXISTS { ?revision tg:hasDraftDocumentType ?reqDoc . }
    FILTER NOT EXISTS {
        ?context cd:admittedDocument ?adDoc .
        ?adDoc tg:documentType ?reqDoc .
    }
}"""
    ] ) ;
    catalog:effects ( [
        catalog:operation "ADD" ;
        catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX cd: <urn:tradegraph:case-data#>
CONSTRUCT { ?revision tg:hasDraftDocumentType ?reqDoc . }
WHERE {
    ?product tg:hasTariffClassification ?code .
    ?rule a tg:ImportRestrictionRule ; tg:lartasTargetCode ?code ;
        tg:lartasJurisdiction ?jurisdiction ; tg:lartasRequiresDocumentType ?reqDoc .
    OPTIONAL { ?rule tg:lartasEffectiveFrom ?eff . }
    FILTER (!BOUND(?eff) || STR(?eff) <= SUBSTR(STR(?transactionAt), 1, 10))
    FILTER NOT EXISTS { ?rule tg:lartasProhibited true . }
    FILTER NOT EXISTS {
        ?context cd:admittedDocument ?adDoc .
        ?adDoc tg:documentType ?reqDoc .
    }
}"""
    ] ) .

