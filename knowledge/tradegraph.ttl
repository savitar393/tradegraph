:query-active-regulations a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "active-regulations" ;
    rdfs:label "Regulasi yang telah berlaku dan belum dicabut penuh pada tanggal acuan (CQ04)"@id ;
    catalog:parameters ( "asOfDate" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?document ?number ?effectiveFrom WHERE {
    ?document a tg:SourceDocument ; tg:effectiveFromDate ?effectiveFrom .
    OPTIONAL { ?document tg:regulationNumber ?number . }
    FILTER (?effectiveFrom <= ?asOfDate)
    FILTER NOT EXISTS {
        ?event a tg:LegalRelationEvent ; tg:relationTargetDocument ?document ;
            tg:hasLegalRelationKind tg:relRevokes ; tg:relationEffectiveDate ?revokedOn .
        FILTER (?revokedOn <= ?asOfDate)
    }
}""" .

:query-regulation-lineage a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "regulation-lineage" ;
    rdfs:label "Riwayat perubahan dan pencabutan atas suatu regulasi (CQ17)"@id ;
    catalog:parameters ( "document" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
SELECT DISTINCT ?acting ?kind ?effectiveDate WHERE {
    ?event a tg:LegalRelationEvent ; tg:relationTargetDocument ?document ;
        tg:relationActingDocument ?acting ; tg:hasLegalRelationKind ?kind .
    OPTIONAL { ?event tg:relationEffectiveDate ?effectiveDate . }
}""" .

