:query-export-duty a owl:NamedIndividual, catalog:QueryDefinition ;
    catalog:id "export-duty" ;
    rdfs:label "Aturan tarif Bea Keluar (Export Duty) Indonesia aktif per kode HS, yurisdiksi, dan tanggal"@id ;
    catalog:parameters ( "code" "jurisdiction" "asOfDate" ) ;
    catalog:sparql """PREFIX tg: <urn:tradegraph:kb#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?rule ?commodityGroup ?basis ?basisLabel ?ratePercent ?specificUsdPerMt
    ?refPriceMinExcl ?refPriceMaxIncl ?tierColumn ?effectiveFrom ?effectiveUntil ?sourceClause
WHERE {
    ?rule a tg:ExportDutyRule ;
        tg:exportDutyTargetCode ?code ;
        tg:exportDutyJurisdiction ?jurisdiction ;
        tg:exportDutyBasis ?basis .
    OPTIONAL { ?basis rdfs:label ?basisLabel . }
    OPTIONAL { ?rule tg:exportDutyCommodityGroup ?commodityGroup . }
    OPTIONAL { ?rule tg:exportDutyRatePercent ?ratePercent . }
    OPTIONAL { ?rule tg:exportDutySpecificUsdPerMt ?specificUsdPerMt . }
    OPTIONAL { ?rule tg:exportDutyRefPriceMinExclusive ?refPriceMinExcl . }
    OPTIONAL { ?rule tg:exportDutyRefPriceMaxInclusive ?refPriceMaxIncl . }
    OPTIONAL { ?rule tg:exportDutyTierColumn ?tierColumn . }
    OPTIONAL { ?rule tg:exportDutyEffectiveFrom ?effectiveFrom . }
    OPTIONAL { ?rule tg:exportDutyEffectiveUntilExclusive ?effectiveUntil . }
    FILTER (!BOUND(?effectiveFrom) || STR(?effectiveFrom) <= STR(?asOfDate))
    FILTER (!BOUND(?effectiveUntil) || STR(?asOfDate) < STR(?effectiveUntil))
    OPTIONAL { ?rule tg:hasSourceClause ?sourceClause . }
}""" .

