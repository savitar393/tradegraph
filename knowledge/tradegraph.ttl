# Partner- & Period-Aware Multi-FTA Tariff Schedules, RCEP Tariff Differentials (DV20), and Tariff Optimization (0.10.0)

:mfnDutyPercent a owl:DatatypeProperty ;
    rdfs:domain :HSCode ; rdfs:range xsd:decimal .
:tariffPartnerCountry a owl:ObjectProperty ;
    rdfs:domain :TariffRateEntry ; rdfs:range :Country .
:tariffEffectiveUntilExclusive a owl:DatatypeProperty ;
    rdfs:domain :TariffRateEntry ; rdfs:range xsd:string .
:tariffExcludedToMfn a owl:DatatypeProperty ;
    rdfs:domain :TariffRateEntry ; rdfs:range xsd:boolean .
:subjectToRcepTariffDifferential a owl:DatatypeProperty ;
    rdfs:domain :HSCode ; rdfs:range xsd:boolean .
:minimumDvPercent a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :OriginThreshold ; rdfs:range xsd:decimal .
:hasTariffDifferentialThreshold a owl:ObjectProperty ;
    rdfs:domain :TradeAgreement ; rdfs:range :OriginThreshold .
:recordedDomesticValueAdditionPercent a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Document ; rdfs:range xsd:decimal .
:highestOriginatingContributorCountry a owl:ObjectProperty ;
    rdfs:domain :Document ; rdfs:range :Country .

:pmk209-pasal-14 a owl:NamedIndividual, :SourceClause ;
    :clauseInDocument :source-id-asal-rcep ;
    :clauseLocator "Pasal 1 angka 26 & Pasal 14-15 (Tariff Differentials, RCEP Country of Origin, dan DV20 >= 20% FOB)" .

:dv20Statement a owl:NamedIndividual, :DocumentType ;
    rdfs:label "Pernyataan Nilai Tambah Domestik RCEP (DV20)"@id ;
    :hasSourceClause :pmk209-pasal-14 .

:rcep-dv20-threshold a owl:NamedIndividual, :OriginThreshold ;
    rdfs:label "RCEP Tariff Differential DV20 20% FOB threshold" ;
    :minimumDvPercent "20.0"^^xsd:decimal ;
    :hasSourceClause :pmk209-pasal-14 .

:rcep :hasTariffDifferentialThreshold :rcep-dv20-threshold .
:scope-rcep-psr-generic :hasSourceClause :pmk209-pasal-14 .

